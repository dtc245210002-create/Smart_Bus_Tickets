@model WebApplication1.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container py-4">
    <div class="sbg-auth-card" style="max-width: 540px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle mb-2" style="background-color: var(--sbg-primary-light);">
                <i class="bi bi-person-plus-fill text-success" style="font-size: 2.2rem;"></i>
            </div>
            <h2 class="sbg-auth-title mb-1">Đăng Ký Tài Khoản</h2>
            <p class="text-muted small">Tạo tài khoản để đặt vé, theo dõi chuyến và nhận nhiều ưu đãi</p>
        </div>

        <!-- Đăng ký nhanh với Google -->
        <a asp-controller="GoogleAuth" asp-action="Login" class="sbg-btn-google mb-3">
            <svg width="20" height="20" viewBox="0 0 48 48">
                <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
            </svg>
            <span>Đăng ký nhanh với Google</span>
        </a>

        <div class="position-relative text-center my-4">
            <hr class="text-muted opacity-25" />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">Hoặc điền thông tin</span>
        </div>

        <form asp-action="Register" method="post" id="registerForm" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 alert alert-danger p-2"></div>

            <!-- Họ và tên -->
            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                    <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="vd: Hầu Tuấn Đạt" autocomplete="name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Địa chỉ Email (full row tránh bị tràn/cắt chữ email) -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="vd: bavavan1968@gmail.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Số điện thoại -->
            <div class="mb-3">
                <label asp-for="Phone" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Phone" type="tel" class="form-control border-start-0 ps-0" placeholder="vd: 0372619580" autocomplete="tel" />
                </div>
                <span asp-validation-for="Phone" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Mật khẩu + Nút Hiện/Ẩn mật khẩu -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="Password" type="password" id="registerPassword" class="form-control border-start-0 border-end-0 ps-0" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                    <button class="btn btn-outline-light border border-start-0 text-muted sbg-toggle-pwd" type="button" onclick="togglePassword('registerPassword', this)" title="Hiển thị mật khẩu" aria-label="Hiển thị mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Xác nhận mật khẩu + Nút Hiện/Ẩn mật khẩu -->
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                    <input asp-for="ConfirmPassword" type="password" id="registerConfirmPassword" class="form-control border-start-0 border-end-0 ps-0" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                    <button class="btn btn-outline-light border border-start-0 text-muted sbg-toggle-pwd" type="button" onclick="togglePassword('registerConfirmPassword', this)" title="Hiển thị mật khẩu" aria-label="Hiển thị mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- Điều khoản dịch vụ -->
            <div class="mb-4">
                <div class="form-check d-flex align-items-start gap-2">
                    <input asp-for="AcceptTerms" class="form-check-input mt-1 flex-shrink-0" id="acceptTermsCheck" />
                    <label class="form-check-label text-muted small user-select-none" for="acceptTermsCheck">
                        Tôi đồng ý với <a href="#" class="text-success text-decoration-none fw-semibold">Điều khoản dịch vụ</a> và <a href="#" class="text-success text-decoration-none fw-semibold">Chính sách bảo mật</a> của SmartBus Go.
                    </label>
                </div>
                <span asp-validation-for="AcceptTerms" class="text-danger small d-block mt-1"></span>
            </div>

            <button type="submit" class="btn sbg-btn-primary w-100 py-2 mb-3 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-arrow-right-circle"></i>
                <span>Tiếp tục xác thực Email</span>
            </button>
        </form>

        <div class="text-center text-muted small">
            Đã có tài khoản? 
            <a asp-action="Login" class="text-decoration-none fw-bold text-success">Đăng nhập</a>
        </div>
    </div>
</div>

<style>
    /* Hiệu ứng focus và hover cho các ô nhập và nút xem mật khẩu */
    .input-group:focus-within {
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
        border-radius: 0.375rem;
    }
    .input-group:focus-within .input-group-text,
    .input-group:focus-within .form-control,
    .input-group:focus-within .sbg-toggle-pwd {
        border-color: var(--sbg-accent) !important;
    }
    .sbg-toggle-pwd {
        background-color: #ffffff;
        cursor: pointer;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        transition: color 0.15s ease, background-color 0.15s ease;
    }
    .sbg-toggle-pwd:hover {
        background-color: #f8fafc !important;
        color: var(--sbg-primary) !important;
    }
    .form-check-input:checked {
        background-color: var(--sbg-accent);
        border-color: var(--sbg-accent);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xử lý sự kiện bật/tắt hiển thị mật khẩu
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                }
                btn.setAttribute('title', 'Ẩn mật khẩu');
                btn.setAttribute('aria-label', 'Ẩn mật khẩu');
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
                btn.setAttribute('title', 'Hiển thị mật khẩu');
                btn.setAttribute('aria-label', 'Hiển thị mật khẩu');
            }
        }

        // Tích hợp Unobtrusive Validation cho MustBeTrue validator (checkbox điều khoản)
        $(document).ready(function () {
            if ($.validator && $.validator.unobtrusive) {
                $.validator.addMethod("mustbetrue", function (value, element) {
                    return element.checked;
                });
                $.validator.unobtrusive.adapters.addBool("mustbetrue");
            }

            // Tự động xóa thông báo lỗi khi người dùng tick vào ô Điều khoản
            $('#acceptTermsCheck').on('change', function () {
                if ($(this).valid) {
                    $(this).valid();
                }
            });
        });
    </script>
}
