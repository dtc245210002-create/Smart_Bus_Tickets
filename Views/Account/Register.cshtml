@model WebApplication1.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container">
    <div class="sbg-auth-card" style="max-width: 520px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle mb-2" style="background-color: var(--sbg-primary-light);">
                <i class="bi bi-person-plus-fill text-success" style="font-size: 2rem;"></i>
            </div>
            <h2 class="sbg-auth-title">Đăng Ký Tài Khoản</h2>
            <p class="text-muted small">Tạo tài khoản để đặt vé, theo dõi chuyến và nhận nhiều ưu đãi</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Nguyễn Văn An" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-dark small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="an@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold text-dark small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                        <input asp-for="Phone" class="form-control border-start-0 ps-0" placeholder="0912345678" />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="Tối thiểu 6 ký tự" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="AcceptTerms" class="form-check-input" />
                <label asp-for="AcceptTerms" class="form-check-label text-muted small">
                    Tôi đồng ý với <a href="#" class="text-success text-decoration-none">Điều khoản dịch vụ</a> và <a href="#" class="text-success text-decoration-none">Chính sách bảo mật</a> của SmartBus Go.
                </label>
                <div><span asp-validation-for="AcceptTerms" class="text-danger small"></span></div>
            </div>

            <button type="submit" class="btn sbg-btn-primary w-100 py-2 mb-3">
                <i class="bi bi-arrow-right-circle me-1"></i> Tiếp tục xác thực Email
            </button>
        </form>

        <div class="text-center text-muted small">
            Đã có tài khoản? 
            <a asp-action="Login" class="text-decoration-none fw-bold text-success">Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
