@model WebApplication1.Models.ViewModels.VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác thực mã OTP";
    var isEmailSent = Model.IsEmailSent || (ViewBag.IsEmailSent == true);
    var fallbackOtp = Model.FallbackOtp ?? ViewBag.FallbackOtp as string ?? "123456";
}

<div class="container py-4">
    <div class="sbg-auth-card text-center mx-auto" style="max-width: 500px;">
        <div class="d-inline-flex p-3 rounded-circle mb-3" style="background-color: #ecfdf5;">
            <i class="bi bi-envelope-check-fill text-success" style="font-size: 2.2rem;"></i>
        </div>

        <h2 class="sbg-auth-title mb-2">Xác Thực Tài Khoản</h2>
        <p class="text-muted small mb-3">
            Hệ thống gửi mã xác thực 6 chữ số đến địa chỉ email:<br />
            <strong class="text-dark fs-6" id="targetEmail">@Model.Email</strong>
        </p>

        <!-- THÔNG BÁO TRẠNG THÁI GỬI EMAIL -->
        <div id="emailSentAlert" class="alert alert-success d-flex align-items-center text-start py-2 px-3 mb-3 small @(isEmailSent ? "" : "d-none")" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 text-success flex-shrink-0"></i>
            <div>
                Mã xác thực OTP đã được gửi đến hộp thư của bạn. Vui lòng kiểm tra hộp thư đến (Inbox) hoặc thư mục Spam/Rác!
            </div>
        </div>

        <!-- THÔNG BÁO CHẾ ĐỘ THỬ NGHIỆM LOCAL / CHƯA CẤU HÌNH SMTP -->
        <div id="demoOtpCard" class="card border-0 mb-3 text-start shadow-sm @(isEmailSent ? "d-none" : "")" style="background-color: #f0fdf4; border-left: 4px solid #10b981 !important; border-radius: 10px;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-2 py-1 small fw-semibold">
                        <i class="bi bi-info-circle me-1"></i> Chế độ Thử nghiệm (Local)
                    </span>
                    <button type="button" class="btn btn-sm btn-success py-1 px-2 fw-medium shadow-sm" id="btnAutoFillOtp" title="Bấm để tự động điền mã xác thực vào 6 ô">
                        <i class="bi bi-magic me-1"></i> Tự động điền mã
                    </button>
                </div>
                <div class="small text-muted">
                    Hệ thống chưa kết nối SMTP gửi thư thật ra ngoài. Mã OTP thử nghiệm của bạn là:
                    <div class="d-flex align-items-center mt-1">
                        <span class="fs-4 fw-bold font-monospace text-success me-2" id="displayFallbackOtp" style="letter-spacing: 4px;">@fallbackOtp</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="btnCopyOtp" title="Sao chép">
                            <i class="bi bi-clipboard"></i> Sao chép
                        </button>
                    </div>
                </div>
                <div class="small text-muted mt-2 pt-2 border-top border-success-subtle">
                    <a class="text-decoration-none text-muted small d-inline-flex align-items-center" data-bs-toggle="collapse" href="#smtpGuideCollapse" role="button" aria-expanded="false">
                        <i class="bi bi-gear-fill me-1 text-secondary"></i> Cách gửi mã thật về hòm thư Gmail của bạn...
                    </a>
                    <div class="collapse mt-2 text-dark small p-2 bg-white rounded border" id="smtpGuideCollapse">
                        Để hệ thống gửi email thật đến địa chỉ <strong>@Model.Email</strong>, bạn chỉ cần mở file <code>appsettings.json</code> và điền tài khoản Gmail &amp; Mật khẩu ứng dụng (App Password 16 chữ số):
                        <pre class="bg-light p-2 rounded mt-2 mb-1 font-monospace text-dark" style="font-size: 11px; white-space: pre-wrap;">"SmtpSettings": {
  "Username": "your-email@gmail.com",
  "Password": "xxxx xxxx xxxx xxxx" // Mật khẩu ứng dụng 16 ký tự của Google
}</pre>
                        <span class="text-muted" style="font-size: 11px;">(Nếu không cấu hình, bạn vẫn có thể dùng mã hiển thị trên màn hình hoặc mã <code>123456</code> để kích hoạt bình thường).</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="resendAlert" class="alert alert-info py-2 px-3 mb-3 small text-start d-none" role="alert">
            <span id="resendAlertText"></span>
        </div>

        <form asp-action="VerifyOtp" method="post" id="otpForm">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="OtpCode" id="hiddenOtpInput" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="sbg-otp-container mb-3">
                <input type="text" maxlength="1" class="sbg-otp-digit" autofocus data-index="0" inputmode="numeric" />
                <input type="text" maxlength="1" class="sbg-otp-digit" data-index="1" inputmode="numeric" />
                <input type="text" maxlength="1" class="sbg-otp-digit" data-index="2" inputmode="numeric" />
                <input type="text" maxlength="1" class="sbg-otp-digit" data-index="3" inputmode="numeric" />
                <input type="text" maxlength="1" class="sbg-otp-digit" data-index="4" inputmode="numeric" />
                <input type="text" maxlength="1" class="sbg-otp-digit" data-index="5" inputmode="numeric" />
            </div>

            <span asp-validation-for="OtpCode" class="text-danger small d-block mb-3"></span>

            <button type="submit" class="btn sbg-btn-primary w-100 py-2 mb-3" id="btnSubmitOtp">
                <i class="bi bi-check-lg me-1"></i> Xác nhận &amp; Kích hoạt tài khoản
            </button>
        </form>

        <div class="mt-2 text-muted small">
            <span>Không nhận được mã? </span>
            <button id="btnResendOtp" type="button" class="btn btn-link text-success p-0 fw-semibold text-decoration-none small" disabled>
                Gửi lại mã (<span id="otpTimer">60</span>s)
            </button>
        </div>

        <div class="mt-4 pt-3 border-top">
            <a asp-action="Register" class="text-muted text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Đổi địa chỉ email khác
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const digits = document.querySelectorAll(".sbg-otp-digit");
            const hiddenInput = document.getElementById("hiddenOtpInput");
            const btnAutoFill = document.getElementById("btnAutoFillOtp");
            const btnCopy = document.getElementById("btnCopyOtp");
            const displayFallbackOtp = document.getElementById("displayFallbackOtp");
            const resendBtn = document.getElementById("btnResendOtp");
            const timerEl = document.getElementById("otpTimer");
            const resendAlert = document.getElementById("resendAlert");
            const resendAlertText = document.getElementById("resendAlertText");
            const emailSentAlert = document.getElementById("emailSentAlert");
            const demoOtpCard = document.getElementById("demoOtpCard");
            const email = "@Model.Email";

            let currentOtp = "@fallbackOtp";

            function syncOtp() {
                let code = "";
                digits.forEach(d => code += d.value);
                hiddenInput.value = code;
            }

            function fillCode(code) {
                if (!code) return;
                const cleanCode = code.toString().trim();
                cleanCode.split('').forEach((char, i) => {
                    if (digits[i]) digits[i].value = char;
                });
                syncOtp();
                if (digits[5]) digits[5].focus();
            }

            // Xử lý nhập mã OTP từng ô
            digits.forEach((digit, index) => {
                digit.addEventListener("input", (e) => {
                    const val = e.target.value;
                    if (val.length === 1 && index < digits.length - 1) {
                        digits[index + 1].focus();
                    }
                    syncOtp();
                });

                digit.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !digit.value && index > 0) {
                        digits[index - 1].focus();
                    }
                });

                digit.addEventListener("paste", (e) => {
                    e.preventDefault();
                    const pastedData = (e.clipboardData || window.clipboardData).getData('text').trim();
                    if (/^\d{6}$/.test(pastedData)) {
                        fillCode(pastedData);
                    }
                });
            });

            // Nút Tự động điền mã
            if (btnAutoFill) {
                btnAutoFill.addEventListener("click", function () {
                    fillCode(currentOtp);
                });
            }

            // Nút sao chép mã
            if (btnCopy) {
                btnCopy.addEventListener("click", function () {
                    navigator.clipboard.writeText(currentOtp).then(() => {
                        const originalHtml = btnCopy.innerHTML;
                        btnCopy.innerHTML = '<i class="bi bi-check2"></i> Đã chép!';
                        setTimeout(() => {
                            btnCopy.innerHTML = originalHtml;
                        }, 2000);
                    });
                });
            }

            // Đếm ngược gửi lại mã
            let timeLeft = 60;
            let timerInterval = null;

            function startTimer() {
                timeLeft = 60;
                if (resendBtn) {
                    resendBtn.disabled = true;
                    resendBtn.innerHTML = `Gửi lại mã (<span id="otpTimer">${timeLeft}</span>s)`;
                }

                if (timerInterval) clearInterval(timerInterval);

                timerInterval = setInterval(() => {
                    timeLeft--;
                    const spanTimer = document.getElementById("otpTimer");
                    if (spanTimer) spanTimer.innerText = timeLeft;

                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        if (resendBtn) {
                            resendBtn.disabled = false;
                            resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Gửi lại mã ngay';
                        }
                    }
                }, 1000);
            }

            startTimer();

            // Xử lý gửi lại mã OTP qua AJAX
            if (resendBtn) {
                resendBtn.addEventListener("click", async function () {
                    if (resendBtn.disabled) return;

                    resendBtn.disabled = true;
                    resendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang gửi...';

                    try {
                        const response = await fetch('/Account/ResendOtp', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ email: email })
                        });

                        const data = await response.json();

                        if (data && data.success) {
                            currentOtp = data.otp || currentOtp;

                            if (data.isEmailSent) {
                                if (emailSentAlert) emailSentAlert.classList.remove("d-none");
                                if (demoOtpCard) demoOtpCard.classList.add("d-none");
                                showNotice("success", `<i class="bi bi-check-circle-fill me-1"></i> ${data.message}`);
                            } else {
                                if (displayFallbackOtp) displayFallbackOtp.innerText = data.otp;
                                if (demoOtpCard) demoOtpCard.classList.remove("d-none");
                                showNotice("warning", `<i class="bi bi-info-circle-fill me-1"></i> ${data.message}`);
                            }

                            // Xóa các ô nhập để người dùng nhập mã mới
                            digits.forEach(d => d.value = "");
                            hiddenInput.value = "";
                            digits[0].focus();

                            startTimer();
                        } else {
                            showNotice("danger", data?.message || "Không thể gửi lại mã xác thực. Vui lòng thử lại sau.");
                            resendBtn.disabled = false;
                            resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Gửi lại mã ngay';
                        }
                    } catch (err) {
                        console.error(err);
                        showNotice("danger", "Có lỗi kết nối máy chủ khi gửi lại mã OTP.");
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Gửi lại mã ngay';
                    }
                });
            }

            function showNotice(type, html) {
                if (!resendAlert || !resendAlertText) return;
                resendAlert.className = `alert alert-${type} py-2 px-3 mb-3 small text-start`;
                resendAlertText.innerHTML = html;
                resendAlert.classList.remove("d-none");
            }
        });
    </script>
}
