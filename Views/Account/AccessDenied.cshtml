@{
    ViewData["Title"] = "Từ chối truy cập (403)";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center p-4 p-md-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 90px; height: 90px;">
                        <i class="bi bi-shield-lock-fill" style="font-size: 3rem;"></i>
                    </div>
                </div>

                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold mb-3 align-self-center">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Lỗi 403 · Không đủ quyền hạn
                </span>

                <h2 class="fw-bold text-dark mb-3">Khu vực hạn chế truy cập</h2>
                <p class="text-secondary mb-4 fs-6">
                    Tài khoản của bạn 
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <strong class="text-dark">(@User.Identity.Name)</strong>
                    }
                    không có quyền truy cập vào chức năng này. Vui lòng đăng nhập với tài khoản có quyền hạn phù hợp (Quản trị viên hoặc Tài xế) hoặc quay về trang chủ.
                </p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-house-door-fill me-1"></i> Về Trang chủ
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold w-100">
                                <i class="bi bi-box-arrow-right me-1"></i> Đổi tài khoản khác
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success px-4 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-person-fill me-1"></i> Đăng nhập
                        </a>
                    }
                </div>

                <div class="mt-4 pt-3 border-top text-muted small">
                    Cần hỗ trợ phân quyền? Liên hệ hotline kỹ thuật: <a href="tel:19006868" class="text-decoration-none fw-bold text-success">1900 6868</a>
                </div>
            </div>
        </div>
    </div>
</div>
