@model WebApplication1.Models.ViewModels.TripSearchViewModel
@{
    ViewData["Title"] = $"Vé xe từ {Model.From} đi {Model.To}";
}

<div class="container py-4">
    <!-- 1. THANH TÌM KIẾM NHANH TRÊN CÙNG -->
    <div class="sbg-search-header-bar mb-4">
        <form method="get" asp-action="Search" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold mb-1">NƠI XUẤT PHÁT</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-success"><i class="bi bi-geo-alt-fill"></i></span>
                    <input type="text" name="from" value="@Model.From" class="form-control border-start-0 fw-bold text-capitalize" style="text-transform: capitalize;" placeholder="vd: Hà Nội..." required />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold mb-1">NƠI ĐẾN</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-danger"><i class="bi bi-geo-fill"></i></span>
                    <input type="text" name="to" value="@Model.To" class="form-control border-start-0 fw-bold text-capitalize" style="text-transform: capitalize;" placeholder="vd: Thái Nguyên..." required />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold mb-1">NGÀY ĐI</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted sbg-calendar-trigger" title="Mở lịch chọn ngày"><i class="bi bi-calendar-event text-success"></i></span>
                    <input type="text" name="date" value="@Model.DepartureDate.ToString("yyyy-MM-dd")" class="form-control border-start-0 border-end-0 fw-bold sbg-datepicker" placeholder="dd/mm/yyyy" required />
                    <span class="input-group-text bg-white border-start-0 text-muted sbg-calendar-trigger" title="Mở lịch chọn ngày"><i class="bi bi-calendar3"></i></span>
                </div>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn sbg-btn-primary w-100 py-2 fw-bold shadow-sm" style="margin-top: 24px;">
                    <i class="bi bi-search me-1"></i> Tìm lại chuyến
                </button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm rounded-3 border-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <strong class="d-block">Dữ liệu tìm kiếm không hợp lệ:</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    }

    <div class="row">
        <!-- 2. BỘ LỌC VÀ SẮP XẾP BÊN TRÁI -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="sbg-filter-card">
                <div class="sbg-filter-title">
                    <span><i class="bi bi-arrow-down-up me-1 text-success"></i> Sắp xếp</span>
                </div>
                <form id="sortFilterForm" method="get" asp-action="Search">
                    <input type="hidden" name="from" value="@Model.From" />
                    <input type="hidden" name="to" value="@Model.To" />
                    <input type="hidden" name="date" value="@Model.DepartureDate.ToString("yyyy-MM-dd")" />

                    <label class="sbg-radio-option">
                        <input type="radio" name="sort" value="default" @(Model.SortBy == "default" ? "checked" : "") onchange="this.form.submit()" />
                        <span>Mặc định</span>
                    </label>
                    <label class="sbg-radio-option">
                        <input type="radio" name="sort" value="time_earliest" @(Model.SortBy == "time_earliest" ? "checked" : "") onchange="this.form.submit()" />
                        <span>Giờ đi sớm nhất</span>
                    </label>
                    <label class="sbg-radio-option">
                        <input type="radio" name="sort" value="time_latest" @(Model.SortBy == "time_latest" ? "checked" : "") onchange="this.form.submit()" />
                        <span>Giờ đi muộn nhất</span>
                    </label>
                    <label class="sbg-radio-option">
                        <input type="radio" name="sort" value="price_asc" @(Model.SortBy == "price_asc" ? "checked" : "") onchange="this.form.submit()" />
                        <span>Giá tăng dần</span>
                    </label>
                    <label class="sbg-radio-option">
                        <input type="radio" name="sort" value="price_desc" @(Model.SortBy == "price_desc" ? "checked" : "") onchange="this.form.submit()" />
                        <span>Giá giảm dần</span>
                    </label>
                </form>
            </div>

            <div class="sbg-filter-card">
                <div class="sbg-filter-title">
                    <span><i class="bi bi-funnel me-1 text-success"></i> Lọc nâng cao</span>
                    <a asp-action="Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-date="@Model.DepartureDate.ToString("yyyy-MM-dd")" class="text-success text-decoration-none small">Xóa lọc</a>
                </div>

                <h6 class="fw-bold small text-muted text-uppercase mb-2">Khung giờ khởi hành</h6>
                <div class="d-flex flex-column gap-2 mb-3">
                    <a asp-action="Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-date="@Model.DepartureDate.ToString("yyyy-MM-dd")" asp-route-timeOfDay="morning" class="btn btn-outline-secondary btn-sm text-start rounded-3 @(Model.TimeOfDayFilter == "morning" ? "active text-white bg-success" : "")">
                        🌅 Buổi sáng (06:00 - 12:00)
                    </a>
                    <a asp-action="Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-date="@Model.DepartureDate.ToString("yyyy-MM-dd")" asp-route-timeOfDay="afternoon" class="btn btn-outline-secondary btn-sm text-start rounded-3 @(Model.TimeOfDayFilter == "afternoon" ? "active text-white bg-success" : "")">
                        ☀️ Buổi chiều (12:00 - 18:00)
                    </a>
                    <a asp-action="Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-date="@Model.DepartureDate.ToString("yyyy-MM-dd")" asp-route-timeOfDay="evening" class="btn btn-outline-secondary btn-sm text-start rounded-3 @(Model.TimeOfDayFilter == "evening" ? "active text-white bg-success" : "")">
                        🌙 Buổi tối (18:00 - 24:00)
                    </a>
                </div>

                <h6 class="fw-bold small text-muted text-uppercase mb-2">Loại xe</h6>
                <div class="d-flex flex-column gap-2">
                    <a asp-action="Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-date="@Model.DepartureDate.ToString("yyyy-MM-dd")" asp-route-busType="Limousine" class="btn btn-outline-secondary btn-sm text-start rounded-3 @(Model.BusTypeFilter == "Limousine" ? "active text-white bg-success" : "")">
                        🚌 Limousine VIP
                    </a>
                    <a asp-action="Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-date="@Model.DepartureDate.ToString("yyyy-MM-dd")" asp-route-busType="Giường Nằm" class="btn btn-outline-secondary btn-sm text-start rounded-3 @(Model.BusTypeFilter == "Giường Nằm" ? "active text-white bg-success" : "")">
                        🛏️ Xe Giường Nằm
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. DANH SÁCH THẺ CHUYẾN XE BÊN PHẢI -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0 text-dark">
                    Kết quả chiều đi: <span class="text-success">@Model.TotalTrips chuyến xe</span>
                </h4>
                <span class="text-muted small">Tuyến: <strong>@Model.From &rarr; @Model.To</strong></span>
            </div>

            <!-- Quick Filter Badges -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs"><i class="bi bi-lightning-charge-fill text-warning"></i> Flash Sale 50%</span>
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs"><i class="bi bi-geo-alt-fill text-danger"></i> Đưa đón tận nơi</span>
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs"><i class="bi bi-broadcast text-success"></i> Có định vị GPS xe</span>
            </div>

            @foreach (var trip in Model.Trips)
            {
                <div class="sbg-trip-card" id="tripCard-@trip.TripId">
                    @if (trip.IsFlashSale)
                    {
                        <div class="sbg-trip-banner-flash">
                            <span><i class="bi bi-lightning-charge-fill text-warning"></i> @trip.FlashSaleText</span>
                            <span class="small opacity-75">Ưu đãi độc quyền SmartBus Go</span>
                        </div>
                    }

                    <div class="sbg-trip-main-info">
                        <div class="row g-3">
                            <div class="col-md-3 col-sm-4 text-center text-sm-start">
                                <img src="@trip.BusImage" alt="@trip.OperatorName" class="sbg-trip-operator-img w-100 mb-2 shadow-xs" />
                                <div class="small text-muted"><i class="bi bi-shield-check text-success"></i> Cam kết 100% giữ chỗ</div>
                            </div>

                            <div class="col-md-5 col-sm-8">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h5 class="fw-bold text-dark mb-0">@trip.OperatorName</h5>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> @trip.Rating (@trip.ReviewCount)</span>
                                </div>
                                <div class="text-muted small mb-3 d-flex align-items-center flex-wrap gap-1">
                                    <span>@trip.BusTypeName • Biển số: <strong class="text-dark">@trip.LicensePlate</strong></span>
                                    @if (trip.IsMatchingDeparture)
                                    {
                                        <span class="badge bg-success text-white" title="Xe biển số tỉnh xuất phát (@trip.ProvinceName)">
                                            <i class="bi bi-geo-alt-fill"></i> Xe @trip.ProvinceName
                                        </span>
                                    }
                                    else if (trip.IsMatchingDestination)
                                    {
                                        <span class="badge bg-info text-dark" title="Xe biển số tỉnh điểm đến (@trip.ProvinceName)">
                                            <i class="bi bi-geo-fill"></i> Xe @trip.ProvinceName
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(trip.ProvinceName) && trip.ProvinceName != "Toàn quốc")
                                    {
                                        <span class="badge bg-light text-secondary border" title="Tỉnh đăng ký biển xe">
                                            <i class="bi bi-geo-alt"></i> @trip.ProvinceName
                                        </span>
                                    }
                                </div>

                                <div class="position-relative ps-4">
                                    <div class="mb-3">
                                        <span class="sbg-timeline-dot bg-success position-absolute start-0 top-0 mt-1"></span>
                                        <span class="fs-5 fw-bold text-dark">@trip.DepartureTime.ToString(@"hh\:mm")</span>
                                        <span class="text-muted small ms-1">• @trip.DeparturePoint</span>
                                    </div>
                                    <div class="sbg-timeline-line position-absolute start-0" style="top: 14px; left: 5px;"></div>
                                    <div>
                                        <span class="sbg-timeline-dot bg-danger position-absolute start-0" style="top: 48px;"></span>
                                        <span class="fs-5 fw-bold text-dark">@trip.ArrivalTime.ToString(@"hh\:mm")</span>
                                        <span class="text-muted small ms-1">• @trip.ArrivalPoint</span>
                                    </div>
                                </div>
                                <div class="mt-2 text-muted small"><i class="bi bi-clock"></i> Thời gian di chuyển dự kiến: <strong>@trip.DurationText</strong></div>
                            </div>

                            <div class="col-md-4 text-md-end text-start d-flex flex-column justify-content-between">
                                <div>
                                    <div class="text-danger fw-bolder fs-4 mb-0">@trip.Price.ToString("N0") VNĐ</div>
                                    @if (trip.OriginalPrice.HasValue)
                                    {
                                        <div class="text-muted text-decoration-line-through small">@trip.OriginalPrice.Value.ToString("N0") VNĐ</div>
                                    }
                                    <div class="text-success fw-semibold small mt-1">
                                        <i class="bi bi-check-circle-fill"></i> Còn @trip.AvailableSeats chỗ trống
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <button class="sbg-btn-select-seat btn-toggle-seat-map w-100" data-trip-id="@trip.TripId">
                                        <i class="bi bi-chevron-down me-1"></i> Chọn chỗ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. KHỐI ACCORDION SƠ ĐỒ GHẾ XỔ XUỐNG NGAY TẠI CHỖ -->
                    <div class="sbg-seat-accordion" id="seatAccordion-@trip.TripId">
                        <div class="row">
                            <div class="col-md-6 border-end text-center">
                                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                                    <h6 class="fw-bold text-dark mb-0">Sơ đồ xe (@trip.BusTypeName)</h6>
                                    <span class="badge bg-secondary-subtle text-secondary small">@trip.TotalCapacity chỗ</span>
                                </div>
                                
                                <div class="sbg-seat-legend">
                                    <span><span class="badge bg-white border text-dark me-1">⬜</span> Trống</span>
                                    <span><span class="badge bg-success me-1">🟩</span> Đang chọn</span>
                                    <span><span class="badge bg-secondary me-1">⬛</span> Đã bán</span>
                                </div>

                                @if (trip.TotalFloors > 1)
                                {
                                    <!-- Tab chuyển đổi giữa Tầng 1 và Tầng 2 (Dành cho xe giường nằm 2 tầng) -->
                                    <ul class="nav nav-pills sbg-floor-pills justify-content-center mb-2 gap-2" id="floorPills-@trip.TripId" role="tablist">
                                        @for (int f = 0; f < trip.FloorLayouts.Count; f++)
                                        {
                                            var floor = trip.FloorLayouts[f];
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link @(f == 0 ? "active" : "")" 
                                                        id="pill-@trip.TripId-@floor.FloorNumber-tab" 
                                                        data-bs-toggle="pill" 
                                                        data-bs-target="#pill-@trip.TripId-@floor.FloorNumber" 
                                                        type="button" role="tab">
                                                    <i class="bi @(floor.FloorNumber == 1 ? "bi-layers-half" : "bi-layers-fill") me-1"></i>
                                                    @floor.FloorName
                                                </button>
                                            </li>
                                        }
                                    </ul>

                                    <div class="tab-content" id="floorTabContent-@trip.TripId">
                                        @for (int f = 0; f < trip.FloorLayouts.Count; f++)
                                        {
                                            var floor = trip.FloorLayouts[f];
                                            <div class="tab-pane fade @(f == 0 ? "show active" : "")" 
                                                 id="pill-@trip.TripId-@floor.FloorNumber" 
                                                 role="tabpanel">
                                                
                                                <div class="sbg-seat-grid-container shadow-xs" 
                                                     style="grid-template-columns: repeat(@floor.TotalCols, 1fr); max-width: @(floor.TotalCols * 60 + 20)px;">
                                                    
                                                    @foreach (var pos in floor.Seats)
                                                    {
                                                        @if (pos.Type == WebApplication1.Models.BusLayout.SeatType.Driver)
                                                        {
                                                            <div class="sbg-driver-position" title="Vị trí Bác tài">
                                                                <i class="bi bi-person-wheel fs-6 text-primary"></i>
                                                                <span>Tài xế</span>
                                                            </div>
                                                        }
                                                        else if (pos.Type == WebApplication1.Models.BusLayout.SeatType.Door)
                                                        {
                                                            <div class="sbg-door-position" title="Cửa lên xuống xe">
                                                                <i class="bi bi-door-open fs-6 text-success"></i>
                                                                <span>Cửa lên</span>
                                                            </div>
                                                        }
                                                        else if (pos.Type == WebApplication1.Models.BusLayout.SeatType.Aisle)
                                                        {
                                                            <div class="sbg-aisle-space"></div>
                                                        }
                                                        else
                                                        {
                                                            var isSleeper = pos.Type == WebApplication1.Models.BusLayout.SeatType.SleeperLower || pos.Type == WebApplication1.Models.BusLayout.SeatType.SleeperUpper;
                                                            var isVip = pos.Type == WebApplication1.Models.BusLayout.SeatType.VipCabin;

                                                            <div class="sbg-seat-box @(isSleeper ? "sleeper" : "") @(isVip ? "vip-cabin" : "") @(pos.Status == "BOOKED" ? "booked" : "")" 
                                                                 data-code="@pos.SeatCode" 
                                                                 data-price="@pos.Price" 
                                                                 data-trip-id="@trip.TripId"
                                                                 data-floor="@pos.Floor"
                                                                 title="@pos.DisplayName - @pos.Description (@pos.Price.ToString("N0")đ)">
                                                                @if (isSleeper)
                                                                {
                                                                    <i class="bi bi-moon-stars" style="font-size: 0.65rem;"></i>
                                                                }
                                                                else if (isVip)
                                                                {
                                                                    <i class="bi bi-gem text-warning" style="font-size: 0.65rem;"></i>
                                                                }
                                                                <span>@pos.SeatCode</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <!-- Xe 1 tầng (Xe 29 chỗ hoặc Xe 45 chỗ) -->
                                    var singleFloor = trip.FloorLayouts.FirstOrDefault() ?? new WebApplication1.Models.BusLayout.BusFloorLayout { TotalCols = 4 };
                                    
                                    <div class="sbg-seat-grid-container shadow-xs" 
                                         style="grid-template-columns: repeat(@singleFloor.TotalCols, 1fr); max-width: @(singleFloor.TotalCols * 60 + 20)px;">
                                        
                                        @if (singleFloor.Seats.Any())
                                        {
                                            @foreach (var pos in singleFloor.Seats)
                                            {
                                                @if (pos.Type == WebApplication1.Models.BusLayout.SeatType.Driver)
                                                {
                                                    <div class="sbg-driver-position" title="Vị trí Bác tài">
                                                        <i class="bi bi-person-wheel fs-6 text-primary"></i>
                                                        <span>Tài xế</span>
                                                    </div>
                                                }
                                                else if (pos.Type == WebApplication1.Models.BusLayout.SeatType.Door)
                                                {
                                                    <div class="sbg-door-position" title="Cửa lên xuống xe">
                                                        <i class="bi bi-door-open fs-6 text-success"></i>
                                                        <span>Cửa lên</span>
                                                    </div>
                                                }
                                                else if (pos.Type == WebApplication1.Models.BusLayout.SeatType.Aisle)
                                                {
                                                    <div class="sbg-aisle-space"></div>
                                                }
                                                else
                                                {
                                                    <div class="sbg-seat-box @(pos.Status == "BOOKED" ? "booked" : "")" 
                                                         data-code="@pos.SeatCode" 
                                                         data-price="@pos.Price" 
                                                         data-trip-id="@trip.TripId"
                                                         data-floor="@pos.Floor"
                                                         title="Ghế @pos.SeatCode - @pos.Description (@pos.Price.ToString("N0")đ)">
                                                        <span>@pos.SeatCode</span>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var seat in trip.Seats)
                                            {
                                                <div class="sbg-seat-box @(seat.Status == "BOOKED" ? "booked" : "")" 
                                                     data-code="@seat.SeatCode" 
                                                     data-price="@seat.Price" 
                                                     data-trip-id="@trip.TripId"
                                                     title="Ghế @seat.SeatCode - Giá @seat.Price.ToString("N0")đ">
                                                    <span>@seat.SeatCode</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-md-6 ps-md-4 mt-3 mt-md-0 d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="fw-bold text-dark mb-2">Chọn trạm đón và trả</h6>
                                    
                                    <div class="mb-2">
                                        <label class="form-label small text-muted fw-bold mb-1">Điểm đón:</label>
                                        <select class="form-select form-select-sm select-boarding-point" data-trip-id="@trip.TripId">
                                            @foreach (var bp in trip.BoardingPoints)
                                            {
                                                <option value="@bp">@bp</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small text-muted fw-bold mb-1">Điểm trả:</label>
                                        <select class="form-select form-select-sm select-dropoff-point" data-trip-id="@trip.TripId">
                                            @foreach (var dp in trip.DropOffPoints)
                                            {
                                                <option value="@dp">@dp</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="p-3 bg-white rounded-3 border">
                                        <div class="d-flex justify-content-between small text-muted mb-1">
                                            <span>Ghế bạn chọn:</span>
                                            <strong class="text-dark selected-seats-list">Chưa chọn ghế nào</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold">Tổng thanh toán:</span>
                                            <span class="fs-5 fw-bold text-danger selected-total-price">0 VNĐ</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <a asp-controller="Ticket" asp-action="Detail" 
                                       class="btn sbg-btn-primary w-100 py-2 fw-bold btn-continue-booking disabled"
                                       data-trip-id="@trip.TripId"
                                       data-from="@Model.From"
                                       data-to="@Model.To"
                                       data-date="@Model.DepartureDate.ToString("yyyy-MM-dd")"
                                       data-deptime="@trip.DepartureTime.ToString(@"hh\:mm")"
                                       data-arrtime="@trip.ArrivalTime.ToString(@"hh\:mm")"
                                       data-duration="@trip.DurationText"
                                       data-estminutes="@trip.EstimatedDuration"
                                       data-distance="@trip.Distance"
                                       data-bustype="@trip.BusTypeName"
                                       data-licenseplate="@trip.LicensePlate"
                                       data-routecode="@trip.RouteCode"
                                       data-routename="@(string.IsNullOrEmpty(trip.RouteName) ? $"{Model.From} - {Model.To}" : trip.RouteName)"
                                       data-drivername="@trip.DriverName"
                                       data-driverphone="@trip.DriverPhone">
                                        Tiếp tục đặt vé với các ghế đã chọn &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.sbgCurrentUserId = @(User.Identity?.IsAuthenticated == true && int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : "null");
    </script>
    <script src="~/js/seat-selection.js" asp-append-version="true"></script>
}
