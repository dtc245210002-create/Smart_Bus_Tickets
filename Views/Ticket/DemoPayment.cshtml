@model WebApplication1.Models.ViewModels.DemoPaymentViewModel
@{ViewData["Title"]="Thanh toán vé";bool holding=Model.Status=="HOLD";}
<div class="container py-4">
    <div class="sbg-checkout-steps mb-4"><div><span class="text-success"><i class="bi bi-check-circle-fill"></i> Chọn tuyến & ghế</span><span class="mx-3 text-muted">—</span><strong>Thông tin & thanh toán</strong><span class="mx-3 text-muted">—</span><span class="text-muted">Nhận vé QR</span></div><div class="sbg-countdown">Thời gian giữ vé: <strong id="holdCountdown" data-expires="@Model.ExpiresAt.ToString("O")">--:--</strong></div></div>
    <div id="paymentExpired" class="alert alert-warning @(holding?"d-none":"")" role="alert">@(Model.Status=="PAID"?"Đơn đã thanh toán. Xem vé trong mục Vé của tôi.":"Phiên giữ ghế đã hết hạn. Vui lòng quay lại tìm chuyến và chọn ghế.") <a asp-action="MyTickets" class="alert-link">Vé của tôi</a></div>
    <div class="row g-4"><div class="col-lg-8"><div class="card sbg-booking-card"><h4 class="fw-bold text-primary-teal"><i class="bi bi-credit-card me-2"></i>Thanh toán & xuất vé</h4><p class="text-muted">@Model.BookingCode • Thanh toán mô phỏng, không chuyển tiền thật.</p>
        <div class="bg-light rounded-3 p-3 mb-4"><h6 class="fw-bold">Thông tin liên hệ</h6><p class="mb-0">@Model.PassengerName • @Model.Phone<br/><span class="text-muted">@Model.Email</span> <a asp-controller="Customer" asp-action="Profile" class="small text-success ms-2">Chỉnh sửa hồ sơ</a></p></div>
        <form asp-action="ConfirmPayment" method="post" id="demoPaymentForm"><input type="hidden" name="code" value="@Model.BookingCode"/><fieldset disabled="@(!holding)"><h6 class="fw-bold mb-3">Chọn phương thức thanh toán</h6><div class="sbg-payment-methods mb-4">
        @foreach(var method in new[]{"VietQR","VNPay","MoMo","ZaloPay"}){<label class="sbg-method"><input type="radio" name="method" value="@method" checked="@(method=="VietQR")" required/><span><i class="bi @(method=="VietQR"?"bi-qr-code":"bi-wallet2") fs-4"></i><strong>@(method=="VietQR"?"VietQR / Ngân hàng":method)</strong></span></label>}
        </div><div class="sbg-demo-hint mb-4"><i class="bi bi-info-circle me-1"></i> Chọn một phương thức và bấm nút bên dưới để mô phỏng xác nhận thanh toán.</div><div class="row g-3 align-items-start"><div class="col-md-5"><div class="border rounded-4 p-3 text-center"><span class="badge text-bg-light border mb-3">QR ĐƠN DEMO</span><div class="sbg-demo-qr" id="ticketQrCanvas"></div><input type="hidden" id="qrPayloadData" value="SMARTBUS-DEMO-NOT-A-PAYMENT:@Model.BookingCode"/><p class="text-muted small mt-3 mb-0">QR nhận diện đơn mẫu<br/>Không dùng để chuyển tiền</p></div></div><div class="col-md-7"><div class="sbg-bank-info"><span class="text-muted small">Mã đơn hàng</span><strong>@Model.BookingCode</strong><button type="button" class="btn btn-sm btn-outline-success" data-copy="@Model.BookingCode">Sao chép mã</button></div><div class="sbg-bank-info"><span class="text-muted small">Số tiền tạm tính</span><strong class="text-primary-teal fs-4">@Model.Subtotal.ToString("N0") đ</strong></div><label for="voucher" class="form-label small fw-bold mt-3">Mã giảm giá</label><div class="input-group"><input class="form-control" id="voucher" name="voucher" placeholder="Thử SMARTBUSNEW" maxlength="30"/><button class="btn btn-outline-success" type="button" id="applyVoucher">Áp dụng</button></div><div class="small mt-2" id="voucherMessage" aria-live="polite"></div></div></div>
        <button type="submit" class="btn sbg-btn-primary w-100 py-3 fw-bold mt-4"><i class="bi bi-check-circle me-2"></i>THANH TOÁN DEMO • <span class="payment-total">@Model.Total.ToString("N0") đ</span></button>
        <button type="submit" formaction="/Ticket/SimulateFailure" class="btn btn-outline-secondary w-100 mt-2">Thử tình huống thanh toán thất bại</button></fieldset></form>
        <div id="copyMessage" class="small text-success mt-2" aria-live="polite"></div>
    </div></div><div class="col-lg-4"><div class="card sbg-booking-card sbg-order-summary"><div class="sbg-summary-heading"><i class="bi bi-ticket-perforated me-2"></i>THÔNG TIN CHUYẾN ĐI</div><h5 class="fw-bold mt-4">@Model.Trip.DeparturePoint.Split(" (")[0] → @Model.Trip.ArrivalPoint.Split(" (")[0]</h5><p class="text-muted small">@Model.TravelDate.ToString("dd/MM/yyyy") • @Model.Trip.DepartureTime.ToString(@"hh\:mm")<br/>@Model.Trip.BusTypeName • @Model.Trip.LicensePlate</p><hr/><p><i class="bi bi-geo-alt text-success me-2"></i>@Model.BoardingPoint</p><p><i class="bi bi-geo-alt-fill text-danger me-2"></i>@Model.DropOffPoint</p><div class="sbg-demo-hint">Vị trí ghế (@Model.Seats.Count vé):<br/><strong>@string.Join(" & ",Model.Seats)</strong></div><hr/><div class="d-flex justify-content-between"><span>Giá vé (@Model.Seats.Count vé)</span><strong>@Model.Subtotal.ToString("N0") đ</strong></div><div class="d-flex justify-content-between text-success mt-2"><span>Giảm giá</span><span id="discountAmount">0 đ</span></div><hr/><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><strong>TỔNG THANH TOÁN</strong><strong class="text-primary-teal fs-4 payment-total">@Model.Total.ToString("N0") đ</strong></div></div><div class="card sbg-booking-card mt-3"><h6 class="fw-bold">Cam kết từ SmartBus Go</h6><p class="small text-muted mb-0">Giữ đúng ghế đã chọn trong phiên đặt vé.<br/>Vé được cấp sau khi máy chủ xác nhận giao dịch demo.</p></div></div></div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="~/js/ticket-qr.js" asp-append-version="true"></script>
    <script src="~/js/demo-payment.js" asp-append-version="true"></script>
}
