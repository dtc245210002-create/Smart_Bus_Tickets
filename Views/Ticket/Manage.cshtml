@model WebApplication1.Models.ViewModels.TicketChangeViewModel
@{ bool cancel=ViewBag.ManageMode=="cancel"; ViewData["Title"]=cancel?"Hủy vé":"Đổi vé"; }
<div class="container py-4"><a asp-action="MyTickets" class="text-success text-decoration-none"><i class="bi bi-arrow-left"></i> Vé của tôi</a><h2 class="fw-bold text-primary-teal mt-3 mb-4">@(cancel?"Hủy vé & hoàn tiền":"Đổi chuyến xe")</h2><div class="row g-4"><div class="col-lg-8"><div class="card sbg-booking-card">
    @if(cancel)
    {
        <h5 class="fw-bold">Xác nhận hủy @Model.Booking.BookingCode</h5><p class="text-muted">Hủy toàn bộ @Model.Booking.Seats.Count vé trong đơn này và trả ghế về hệ thống.</p><div class="alert alert-warning">Chính sách demo: vé chưa check-in được hủy trước giờ chạy; mô phỏng hoàn lại 100%. Không xử lý tiền thật.</div><p>Số tiền hoàn mô phỏng: <strong class="text-success fs-4">@Model.Booking.Total.ToString("N0") đ</strong></p><form asp-action="Cancel" method="post"><input type="hidden" name="code" value="@Model.Booking.BookingCode"/><button class="btn btn-danger">Xác nhận hủy toàn bộ vé</button> <a asp-action="MyTickets" class="btn btn-outline-secondary">Giữ lại vé</a></form>
    }
    else
    {
        <h5 class="fw-bold">Chọn chuyến mới</h5><p class="text-muted">Demo đổi chuyến cùng tuyến, cùng giá và giữ nguyên số ghế. Vé đã check-in không thể đổi.</p><form method="get" asp-action="Manage" class="d-flex gap-2 mb-4"><input type="hidden" name="code" value="@Model.Booking.BookingCode"/><input type="date" name="date" value="@Model.NewDate.ToString("yyyy-MM-dd")" min="@WebApplication1.Services.DemoStore.Today.ToString("yyyy-MM-dd")" class="form-control" required/><button class="btn sbg-btn-primary text-nowrap">Tìm chuyến</button></form>
        @if(Model.Alternatives.Count==0){<p class="alert alert-info">Chưa có chuyến cùng giá vào ngày này. Thử chọn ngày khác.</p>}
        @foreach(var trip in Model.Alternatives){<form asp-action="Change" method="post" class="border rounded-3 p-3 mb-3 d-flex justify-content-between align-items-center gap-3"><input type="hidden" name="code" value="@Model.Booking.BookingCode"/><input type="hidden" name="tripId" value="@trip.TripId"/><input type="hidden" name="date" value="@Model.NewDate.ToString("yyyy-MM-dd")"/><div><strong>@trip.DepartureTime.ToString(@"hh\:mm") • @trip.BusTypeName</strong><div class="text-muted small">@trip.Price.ToString("N0") đ/ghế • Còn @trip.AvailableSeats chỗ</div></div><button class="btn sbg-btn-primary btn-sm">Đổi sang chuyến này</button></form>}
    }
</div></div><div class="col-lg-4"><div class="card sbg-booking-card"><span class="text-muted small">VÉ HIỆN TẠI</span><h5 class="fw-bold mt-2">@Model.Booking.Trip.DeparturePoint.Split(" (")[0] → @Model.Booking.Trip.ArrivalPoint.Split(" (")[0]</h5><p>@Model.Booking.TravelDate.ToString("dd/MM/yyyy") • @Model.Booking.Trip.DepartureTime.ToString(@"hh\:mm")</p><p>Ghế: <strong>@string.Join(", ",Model.Booking.Seats)</strong></p><strong class="text-success">@Model.Booking.Total.ToString("N0") đ</strong></div></div></div></div>
