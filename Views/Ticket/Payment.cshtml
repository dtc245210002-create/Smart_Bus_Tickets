@{
    Layout = null;
    var rawTicketCode = ViewBag.TicketCode != null ? ((string)ViewBag.TicketCode).Replace("-", "") : "SBG84920";
    var cleanTicketCode = ViewBag.TicketCode ?? "SBG-TN-CB-001";
    var cleanBookingCode = ViewBag.BookingCode ?? "BK-TNCB-001";
    var totalAmountNum = (decimal)(ViewBag.TotalAmount ?? 180000m);
    var amountFormatted = totalAmountNum.ToString("F0");
    
    // Link VietQR API chuẩn NAPAS247 tự động điền STK, Số tiền, và Nội dung chuyển khoản mã vé
    var vietQrBank = "vietcombank";
    var vietQrAccount = "1029384756";
    var vietQrAccountName = Uri.EscapeDataString("CONG TY CO PHAN SMARTBUS GO VIET NAM");
    var vietQrUrl = $"https://img.vietqr.io/image/{vietQrBank}-{vietQrAccount}-compact2.png?amount={amountFormatted}&addInfo={rawTicketCode}&accountName={vietQrAccountName}";

    // Phân quyền người dùng & Tên tài khoản hiện tại
    var isUserAuth = User.Identity?.IsAuthenticated == true;
    var currentUserName = isUserAuth ? (User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "Tài khoản") : "";
    var currentUserEmail = isUserAuth ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "") : "";
    var isUserAdmin = isUserAuth && (User.IsInRole("Quản trị viên") || User.IsInRole("Admin") || currentUserEmail.Contains("admin", StringComparison.OrdinalIgnoreCase));
    var isUserDriver = isUserAuth && ((User.IsInRole("Tài xế") || currentUserEmail.Contains("driver", StringComparison.OrdinalIgnoreCase)) && !isUserAdmin);

    // Tự động nhận diện IP mạng LAN của máy tính hoặc Host hiện tại để điện thoại quét mã QR vào được ngay
    string lanIp = Context.Request.Host.Host;
    var currentHost = Context.Request.Host.Host;
    var isLocalhost = string.Equals(currentHost, "localhost", StringComparison.OrdinalIgnoreCase) || currentHost == "127.0.0.1";

    if (isLocalhost)
    {
        lanIp = System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces()
            .Where(n => n.OperationalStatus == System.Net.NetworkInformation.OperationalStatus.Up && 
                        n.NetworkInterfaceType != System.Net.NetworkInformation.NetworkInterfaceType.Loopback)
            .SelectMany(n => n.GetIPProperties().UnicastAddresses)
            .Where(a => a.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork && 
                        !System.Net.IPAddress.IsLoopback(a.Address) &&
                        !a.Address.ToString().StartsWith("169.254"))
            .Select(a => a.Address.ToString())
            .FirstOrDefault() ?? "192.168.0.109";
    }

    // Khi điện thoại quét mạng nội bộ, luôn dùng HTTP cổng 5122 (tránh lỗi chứng chỉ SSL localhost)
    var mobileScheme = isLocalhost ? "http" : Context.Request.Scheme;
    var mobilePort = isLocalhost ? 5122 : (Context.Request.Host.Port ?? (mobileScheme == "https" ? 443 : 80));
    var payOsMobileUrl = $"{mobileScheme}://{lanIp}:{mobilePort}/payos/mobile-pay?ticketCode={Uri.EscapeDataString(cleanTicketCode)}&bookingCode={Uri.EscapeDataString(cleanBookingCode)}&amount={amountFormatted}&from={Uri.EscapeDataString((string)(ViewBag.StartPoint ?? "Thái Nguyên"))}&to={Uri.EscapeDataString((string)(ViewBag.EndPoint ?? "Cao Bằng"))}&seats={Uri.EscapeDataString((string)(ViewBag.SeatNumber ?? "A01"))}&depTime={Uri.EscapeDataString((string)(ViewBag.DepartureTime ?? "08:00"))}&passenger={Uri.EscapeDataString((string)(ViewBag.PassengerName ?? currentUserName))}";
    var payOsQrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=260x260&data={Uri.EscapeDataString(payOsMobileUrl)}";
}
