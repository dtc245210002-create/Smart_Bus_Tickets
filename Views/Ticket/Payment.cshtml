<!-- Modal Cài đặt Tài khoản Ngân hàng Nhận tiền thật (VietQR Napas247) -->
<div id="bankSettingsModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100">
