      </div>
      <button type="button" onclick="closeBankSettingsModal()" class="text-gray-400 hover:text-gray-600 rounded-lg p-1">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    
    <p class="text-xs text-gray-500 mb-4">
      Nhập số tài khoản ngân hàng của bạn. Khi người mua quét mã VietQR, tiền sẽ chuyển <strong>thẳng vào tài khoản thật</strong> của bạn qua Napas247!
    </p>

    <div class="space-y-3.5">
      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1">Ngân hàng thụ hưởng</label>
        <select id="modalBankId" class="w-full text-xs font-semibold border border-gray-300 rounded-xl p-2.5 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/40">
          <option value="MB" selected>MB Bank (Ngân hàng Quân Đội)</option>
          <option value="VCB">Vietcombank (VCB)</option>
          <option value="TCB">Techcombank (TCB)</option>
          <option value="BIDV">BIDV</option>
          <option value="ICB">VietinBank</option>
          <option value="VPB">VPBank</option>
          <option value="ACB">ACB</option>
          <option value="TPB">TPBank</option>
          <option value="STB">Sacombank</option>
          <option value="VIB">VIB</option>
          <option value="HDB">HDBank</option>
          <option value="SHB">SHB</option>
          <option value="MSB">MSB</option>
          <option value="OCB">OCB</option>
          <option value="LPB">LPBank</option>
          <option value="CAKE">Cake by VPBank</option>
          <option value="TIMO">Timo by BVBank</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1">Số tài khoản thụ hưởng</label>
        <input type="text" id="modalAccountNo" value="@(ViewBag.AccountNo ?? "0978008922")" placeholder="Nhập số tài khoản ngân hàng của bạn" class="w-full text-sm font-bold border border-gray-300 rounded-xl p-2.5 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1">Tên chủ tài khoản (Viết hoa không dấu)</label>
        <input type="text" id="modalAccountName" value="@(ViewBag.AccountName ?? "AU NGUYEN QUANG TUNG")" placeholder="ví dụ: AU NGUYEN QUANG TUNG" class="w-full text-sm font-bold uppercase border border-gray-300 rounded-xl p-2.5 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
      <button type="button" onclick="closeBankSettingsModal()" class="px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition-colors">Đóng</button>
      <button type="button" onclick="saveBankSettings()" id="btnSaveBankSettings" class="px-5 py-2 text-xs font-bold text-white bg-[#008378] hover:bg-[#00685f] rounded-xl shadow-sm transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">save</span>
        <span>Lưu & Tạo lại mã QR ngay</span>
      </button>
    </div>
  </div>
</div>

