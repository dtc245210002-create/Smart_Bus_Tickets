<script>
        document.addEventListener("DOMContentLoaded", function () {
            // ==========================================
            // 1. QUẢN LÝ ĐẾM NGƯỢC THỜI GIAN GIỮ VÉ (10 PHÚT)
            // ==========================================
            let totalSeconds = 10 * 60; 
            const minutesEl = document.getElementById("countdown-minutes");
            const secondsEl = document.getElementById("countdown-seconds");

            let timerInterval = null;
            let checkPaymentInterval = null;

            if (minutesEl && secondsEl) {
                timerInterval = setInterval(function () {
                    if (totalSeconds <= 0) {
                        clearInterval(timerInterval);
                        if (checkPaymentInterval) clearInterval(checkPaymentInterval);
                        
                        alert("Thời gian tạm giữ ghế đã hết! Hệ thống sẽ chuyển về trang tìm chuyến.");
                        window.location.href = "/Home/Index";
                        return;
                    }
                    totalSeconds--;
                    const minutes = Math.floor(totalSeconds / 60);
                    const seconds = totalSeconds % 60;

                    minutesEl.textContent = minutes < 10 ? "0" + minutes : minutes;
                    secondsEl.textContent = seconds < 10 ? "0" + seconds : seconds;
                }, 1000);
            }

            // ==========================================
            // 2. TỰ ĐỘNG CHECK TRẠNG THÁI THANH TOÁN (POLLING)
            // ==========================================
            const orderCode = "SBG84920"; // Mã đơn hàng / Nội dung chuyển khoản
            const checkIntervalMs = 3000;  // Kiểm tra mỗi 3 giây
            
            checkPaymentInterval = setInterval(async function () {
                try {
                    // Gọi API kiểm tra trạng thái thanh toán từ backend
                    const response = await fetch(`/api/payment/check-status?orderCode=${orderCode}`, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        
                        // data.isPaid == true nghĩa là Ngân hàng/Webhook đã xác nhận tiền về
                        if (data.isPaid) {
                            clearInterval(checkPaymentInterval);
                            if (timerInterval) clearInterval(timerInterval);

                            // Hiển thị thông báo hoặc chuyển trang ngay lập tức
                            window.location.href = `/Ticket/Detail`;
                        }
                    }
                } catch (error) {
                    console.error("Lỗi khi kiểm tra trạng thái thanh toán:", error);
                }
            }, checkIntervalMs);
        });
    </script>
