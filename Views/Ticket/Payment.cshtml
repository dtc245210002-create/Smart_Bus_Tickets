<script>
        // Hàm sao chép thông tin
        function copyToClipboard(text, label) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(`Đã sao chép ${label}: ${text}`);
            }).catch(() => {
                const ta = document.createElement("textarea");
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand("copy");
                document.body.removeChild(ta);
                showToast(`Đã sao chép ${label}: ${text}`);
            });
        }

        function showToast(message) {
            const toast = document.getElementById("paymentToast");
            const msg = document.getElementById("paymentToastMsg");
            if (toast && msg) {
                msg.textContent = message;
                toast.classList.remove("translate-y-16", "opacity-0", "pointer-events-none");
                clearTimeout(window.toastTimer);
                window.toastTimer = setTimeout(() => {
                    toast.classList.add("translate-y-16", "opacity-0", "pointer-events-none");
                }, 3000);
            }
        }

        // Quản lý Modal Cài đặt STK nhận tiền
        function openBankSettingsModal() {
            document.getElementById("bankSettingsModal").classList.remove("hidden");
        }

        function closeBankSettingsModal() {
            document.getElementById("bankSettingsModal").classList.add("hidden");
        }

        async function saveBankSettings() {
            const bankId = document.getElementById("modalBankId").value;
            const accountNo = document.getElementById("modalAccountNo").value.trim();
            const accountName = document.getElementById("modalAccountName").value.trim().toUpperCase();

            if (!accountNo || !accountName) {
                alert("Vui lòng điền đầy đủ Số tài khoản và Tên chủ tài khoản!");
                return;
            }

            const btn = document.getElementById("btnSaveBankSettings");
            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span> Đang lưu...`;

            try {
                const res = await fetch("/api/payment/bank-settings", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ bankId, accountNo, accountName })
                });

                const data = await res.json();
                if (data.success) {
                    showToast("Đã cập nhật STK thành công! Đang làm mới mã VietQR...");
                    closeBankSettingsModal();
                    // Tự động tải lại trang để render đúng mã VietQR mới
                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    alert(data.message || "Lỗi cập nhật cấu hình ngân hàng");
                }
            } catch (err) {
                console.error("Lỗi:", err);
                alert("Không thể kết nối đến API cập nhật tài khoản ngân hàng.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-[16px]">save</span> Lưu & Tạo lại mã QR ngay`;
            }
        }

        // Xử lý áp dụng mã Voucher giảm giá (User Story 18)
        let currentTotal = @(((decimal)(ViewBag.TotalAmount ?? 180000m)).ToString("F0"));
        function applyVoucherCode() {
            const code = (document.getElementById("voucherCodeInput").value || "").trim().toUpperCase();
            const msgEl = document.getElementById("voucherAlertMsg");
            msgEl.classList.remove("hidden", "text-red-600", "text-emerald-700");

            if (!code) {
                msgEl.textContent = "Vui lòng nhập mã giảm giá!";
                msgEl.classList.add("text-red-600");
                return;
            }

            let discount = 0;
            if (code === "SMARTBUS20K" || code === "SMARTBUSNEW") {
                discount = 20000;
            } else if (code === "SINHVIEN" || code === "HSSV") {
                discount = Math.round(currentTotal * 0.15); // Giảm 15%
            } else if (code === "VIP50K") {
                discount = 50000;
            } else {
                msgEl.textContent = `Mã '${code}' không hợp lệ hoặc đã hết hạn sử dụng.`;
                msgEl.classList.add("text-red-600");
                return;
            }

            const newTotal = Math.max(10000, currentTotal - discount);
            msgEl.textContent = `Áp dụng thành công! Đã giảm -${new Intl.NumberFormat('vi-VN').format(discount)} đ vào đơn hàng.`;
            msgEl.classList.add("text-emerald-700");

            document.getElementById("displayGrandTotal").textContent = new Intl.NumberFormat('vi-VN').format(newTotal) + " đ";
            
            // Cập nhật lại ảnh VietQR với số tiền mới đã giảm
            const qrImg = document.getElementById("vietQrImg");
            if (qrImg && qrImg.src) {
                try {
                    const u = new URL(qrImg.src);
                    u.searchParams.set("amount", newTotal);
                    qrImg.src = u.toString();
                } catch(e) {}
            }
            showToast(`Đã áp dụng mã giảm giá! Tổng mới: ${new Intl.NumberFormat('vi-VN').format(newTotal)} đ`);
        }

        document.addEventListener("DOMContentLoaded", function () {
            let checkPaymentInterval = null;

            // ==========================================
            // 2. TỰ ĐỘNG CHECK TRẠNG THÁI THANH TOÁN (POLLING)
            // ==========================================
            const orderCode = "@(ViewBag.TicketCode != null ? ((string)ViewBag.TicketCode).Replace("-", "") : "SBG84920")";
            const currentTicketCode = "@(ViewBag.TicketCode ?? "SBG-TN-CB-001")";
            const currentBookingCode = "@(ViewBag.BookingCode ?? "BK-TNCB-001")";
            const checkIntervalMs = 3000;  // Kiểm tra mỗi 3 giây
            
            checkPaymentInterval = setInterval(async function () {
                try {
                    // Gọi API kiểm tra trạng thái thanh toán từ backend
                    const response = await fetch(`/api/payment/check-status?orderCode=${encodeURIComponent(orderCode)}&ticketCode=${encodeURIComponent(currentTicketCode)}`, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        
                        // data.isPaid == true nghĩa là Ngân hàng/Webhook đã xác nhận tiền về
                        if (data.isPaid) {
                            clearInterval(checkPaymentInterval);
                            showToast("Ngân hàng đã nhận tiền thành công! Đang xuất vé điện tử...");

                            // Chuyển hướng sang trang chi tiết vé điện tử
                            setTimeout(() => {
                                window.location.href = `/payment-result?ticketCode=${encodeURIComponent(currentTicketCode)}&bookingCode=${encodeURIComponent(currentBookingCode)}&status=success`;
                            }, 500);
                        }
                    }
                } catch (error) {
                    console.error("Lỗi khi kiểm tra trạng thái thanh toán:", error);
                }
            }, checkIntervalMs);
        });
    </script>
</body>
</html>
