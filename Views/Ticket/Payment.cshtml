ntFamily":{"numeric-data":["Inter"],"headline-md":["Plus Jakarta Sans"],"body-lg":["Inter"],"display-lg":["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"headline-sm":["Plus Jakarta Sans"],"body-md":["Inter"],"headline-lg-mobile":["Plus Jakarta Sans"],"label-md":["Inter"],"title-md":["Inter"],"body-sm":["Inter"],"label-lg":["Inter"]},"fontSize":{"numeric-data":["18px",{"lineHeight":"24px","letterSpacing":"-0.01em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"600"}],"body-lg":["16px",{"lineHeight":"24px","fontWeight":"400"}],"display-lg":["48px",{"lineHeight":"56px","letterSpacing":"-0.02em","fontWeight":"700"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.015em","fontWeight":"700"}],"headline-sm":["20px",{"lineHeight":"28px","fontWeight":"600"}],"body-md":["14px",{"lineHeight":"20px","fontWeight":"400"}],"headline-lg-mobile":["26px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"700"}],"label-md":["12px",{"lineHeight":"16px","letterSpacing":"0.02em","fontWeight":"500"}],"title-md":["16px",{"lineHeight":"24px","fontWeight":"600"}],"body-sm":["12px",{"lineHeight":"16px","fontWeight":"400"}],"label-lg":["14px",{"lineHeight":"20px","letterSpacing":"0.01em","fontWeight":"600"}]}}}}</script></head><body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary selection:text-on-primary"><header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
<!-- Top auxiliary announcement bar -->
<div class="border-b border-gray-100 text-[13px] text-gray-600 bg-white">
<div class="max-w-7xl mx-auto px-4 lg:px-8 py-1.5 flex items-center justify-between">
<div class="flex items-center gap-2 text-gray-600">
<span class="material-symbols-outlined text-primary text-[17px]">verified_user</span>
<span class="">Đặt vé thông minh 4.0</span>
<span class="text-gray-400 mx-1">•</span>
<span class="material-symbols-outlined text-gray-500 text-[17px]">directions_bus</span>
<span class="">Hơn 3,000+ chuyến xe toàn quốc</span>
</div>
<div class="flex items-center gap-6 text-gray-700">
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-primary text-[17px]">call</span>
<span class="">Hotline: <strong class="text-gray-900 font-bold">1900 6868</strong></span>
</div>
<div class="flex items-center gap-1 cursor-pointer hover:text-primary transition-colors">
<span class="material-symbols-outlined text-[17px] text-gray-500">language</span>
<span class="">VND | VI</span>
</div>
</div>
</div>
</div>
<!-- Main navbar row -->
<div class="max-w-7xl mx-auto px-4 lg:px-8 py-3 flex items-center justify-between">
<div class="flex items-center gap-8">
<!-- Brand Logo -->
<a class="flex items-center gap-3" href="/Home/Index">
<div class="text-[#008378] flex items-center justify-center">
<span class="material-symbols-outlined text-[38px] text-[#008378]">directions_bus</span>
</div>
<div class="flex flex-col">
<span class="text-[24px] font-bold text-[#0d3b2e] tracking-tight leading-none font-headline-sm">SmartBus<span class="text-[#008378]">Go</span></span>
<span class="mt-1 bg-emerald-50 text-[#008378] text-[10px] font-semibold px-2 py-0.5 rounded leading-tight w-fit">Vé xe buýt thông minh</span>
</div>
</a>
<!-- Nav links -->
<nav class="flex items-center gap-6 ml-4">
<a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Home/Index">Trang chủ</a>
<a class="font-medium text-[15px] text-primary font-bold hover:text-primary transition-colors" href="/Ticket/Payment">Thanh toán vé</a>
<a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Detail">Vé điện tử</a>
<a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Reschedule">Đổi chuyến</a>
<a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Cancel">Hủy vé</a>
</nav>
</div>
<!-- Right actions -->
<div class="flex items-center gap-3">
<button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#094c3b] hover:bg-[#073c2e] text-white font-semibold text-[14px] shadow-sm transition-all" type="button">
<span class="material-symbols-outlined text-[19px]">login</span>
<span class="">Đăng nhập / Đăng ký</span>
</button>
<button class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold text-[14px] transition-colors" type="button">
<span class="material-symbols-outlined text-[19px] text-gray-600">badge</span>
<span class="">Bác tài</span>
</button>
</div>
</div>
</header><main class="w-full pt-[104px] bg-[#f4f7f6] min-h-screen pb-16">
<!-- Top Progress Stepper & Countdown Bar Section -->
<section class="bg-white border-b border-gray-200 shadow-sm sticky top-[104px] z-40">
<div class="max-w-7xl mx-auto px-4 lg:px-8 py-3.5">
<!-- Steps & Timer Flex Container -->
<div class="flex flex-col lg:flex-row items-center justify-between gap-4">
<!-- Stepper -->
<div class="flex items-center gap-2 sm:gap-4 w-full lg:w-auto overflow-x-auto pb-1 lg:pb-0 text-sm">
<!-- Step 1 -->
<div class="flex items-center gap-2 text-primary font-medium whitespace-nowrap">
<span class="w-6 h-6 rounded-full bg-emerald-100 text-primary flex items-center justify-center font-bold text-xs">
<span class="material-symbols-outlined text-[16px]">check</span>
</span>
<span>Bước 1: Chọn tuyến &amp; ghế</span>
</div>
<span class="w-6 h-px bg-gray-300 hidden sm:inline-block"></span>
<!-- Step 2 -->
<div class="flex items-center gap-2 text-primary font-medium whitespace-nowrap">
<span class="w-6 h-6 rounded-full bg-emerald-100 text-primary flex items-center justify-center font-bold text-xs">
<span class="material-symbols-outlined text-[16px]">check</span>
</span>
<span>Bước 2: Thông tin hành khách</span>
</div>
<span class="w-6 h-px bg-gray-300 hidden sm:inline-block"></span>
<!-- Step 3 (Active) -->
<div class="flex items-center gap-2 text-gray-900 font-bold whitespace-nowrap">
<span class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs shadow-sm">3</span>
<span class="text-primary font-semibold">Bước 3: Thanh toán &amp; Xuất vé</span>
</div>
</div>
<!-- Sticky Payment Status Badge -->
<div class="flex items-center gap-2 bg-emerald-50 border border-emerald-200/80 rounded-xl px-4 py-2 w-full lg:w-auto justify-between lg:justify-end shadow-sm">
  <span class="material-symbols-outlined text-emerald-600 text-[20px]">verified_user</span>
  <span class="text-xs sm:text-sm font-semibold text-emerald-900">Cổng thanh toán an toàn SmartBus Go</span>
</div>
</div>
</div>
</section>
<!-- Alert Booking Success Ribbon -->
<div class="max-w-7xl mx-auto px-4 lg:px-8 mt-5">
<div class="bg-gradient-to-r from-emerald-500/10 via-teal-500/5 to-transparent border-l-4 border-emerald-600 p-3.5 rounded-r-xl flex items-center justify-between gap-3 text-emerald-950 text-sm">
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-emerald-700 text-[22px]">check_circle</span>
<span class="font-medium">Chỗ ngồi của bạn đã được ghi nhận thành công trong hệ thống. Vui lòng hoàn tất thanh toán để nhận ngay Vé điện tử &amp; Mã QR lên xe!</span>
</div>
<span class="hidden md:inline-flex text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 uppercase tracking-wide">Đặt chỗ thành công</span>
</div>
</div>
<!-- Main Grid Layout -->
<div class="max-w-7xl mx-auto px-4 lg:px-8 mt-6">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- LEFT COLUMN: Payment Methods & QR Checkout (65% -> 8 cols) -->
<div class="lg:col-span-8 flex flex-col gap-6">
<!-- Payment Methods Card -->
<div class="bg-white rounded-2xl border border-gray-200/90 shadow-sm p-5 sm:p-7">
<div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-5">
<h2 class="text-lg sm:text-xl font-bold text-gray-900 flex items-center gap-2.5 font-headline-sm">
<span class="material-symbols-outlined text-primary text-[24px]">payments</span>
              Phương thức thanh toán
            </h2>
<span class="text-xs text-gray-500 flex items-center gap-1 font-medium">
<span class="material-symbols-outlined text-[16px] text-emerald-600">lock</span> Bảo mật chuẩn PCI-DSS
            </span>
</div>
<!-- Method Tabs / Selector -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
<!-- VietQR (Active) -->
<button class="relative flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-primary bg-primary/5 text-primary text-center transition-all shadow-sm" type="button">
<div class="absolute -top-2.5 bg-gradient-to-r from-emerald-600 to-teal-700 text-white text-[9px] font-bold px-2 py-0.5 rounded-full shadow-sm">
                Ưu tiên 3s
              </div>
<span class="material-symbols-outlined text-[28px] mb-1 text-primary">qr_code_scanner</span>
<span class="text-xs font-bold leading-tight">VietQR / Ngân hàng</span>
<span class="text-[10px] text-emerald-700 font-semibold mt-0.5">Tự động duyệt 3s</span>
</button>
<!-- Card -->
<button class="flex flex-col items-center justify-center p-3.5 rounded-xl border border-gray-200 hover:border-gray-300 bg-white text-gray-700 text-center transition-colors" type="button">
<span class="material-symbols-outlined text-[28px] mb-1 text-gray-500">credit_card</span>
<span class="text-xs font-semibold leading-tight">Thẻ Quốc Tế</span>
<span class="text-[10px] text-gray-400 mt-0.5">Visa, Master, JCB</span>
</button>
<!-- E-wallet -->
<button class="flex flex-col items-center justify-center p-3.5 rounded-xl border border-gray-200 hover:border-gray-300 bg-white text-gray-700 text-center transition-colors" type="button">
<span class="material-symbols-outlined text-[28px] mb-1 text-gray-500">account_balance_wallet</span>
<span class="text-xs font-semibold leading-tight">Ví MoMo / ZaloPay</span>
<span class="text-[10px] text-gray-400 mt-0.5">Ví điện tử</span>
</button>
<!-- ATM Domestic -->
<button class="flex flex-col items-center justify-center p-3.5 rounded-xl border border-gray-200 hover:border-gray-300 bg-white text-gray-700 text-center transition-colors" type="button">
<span class="material-symbols-outlined text-[28px] mb-1 text-gray-500">account_balance</span>
<span class="text-xs font-semibold leading-tight">Thẻ ATM Napas</span>
<span class="text-[10px] text-gray-400 mt-0.5">Internet Banking</span>
</button>
</div>
<!-- Active Method Detailed Body: VietQR -->
<div class="rounded-2xl bg-[#f8fafc] border border-slate-200/90 p-5 sm:p-7">
<div class="text-center max-w-lg mx-auto mb-6">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-2">
<span class="material-symbols-outlined text-[15px]">flash_on</span>
                Giao dịch xử lý tự động 24/7
              </span>
<h3 class="text-xl font-bold text-gray-900">Quét mã VietQR để thanh toán nhanh</h3>
<p class="text-xs sm:text-sm text-gray-600 mt-1">
                Mở ứng dụng ngân hàng bất kỳ (VCB, BIDV, Techcombank, MB, VPBank...) hoặc ví điện tử để quét mã thanh toán không cần nhập tay.
              </p>
</div>
<!-- Content Area: QR and Bank Details -->
<div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
<!-- QR Code Card -->
<div class="md:col-span-5 flex flex-col items-center justify-center bg-white p-4 rounded-2xl border border-slate-200 shadow-sm text-center">
<!-- Badges above QR -->
<div class="flex items-center justify-between mb-2 w-full">
<div class="flex items-center gap-1.5">
  <span class="font-extrabold text-[13px] tracking-tight text-blue-900 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">VietQR</span>
  <span class="font-bold text-[11px] text-gray-700 bg-gray-100 px-2 py-0.5 rounded">Napas247</span>
</div>
<button type="button" onclick="openBankSettingsModal()" class="text-[11px] text-primary hover:text-emerald-700 font-semibold flex items-center gap-1 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200 hover:bg-emerald-100 transition-colors" title="Thiết lập tài khoản ngân hàng nhận tiền">
  <span class="material-symbols-outlined text-[14px]">tune</span>
  <span>Cài STK của bạn</span>
</button>
</div>
<!-- QR Image from VietQR Napas 247 Dynamic API -->
<div class="relative group p-1 bg-white rounded-xl">
<img id="vietQrImg" alt="Mã VietQR thanh toán Napas 247" class="w-56 h-56 sm:w-64 sm:h-64 mx-auto rounded-xl border border-slate-200 shadow-sm object-contain" src="@(ViewBag.VietQrUrl ?? $"https://img.vietqr.io/image/MB-0978008922-compact2.png?amount={ViewBag.TotalAmount ?? 180000}&addInfo={ViewBag.TransferMemo ?? "SBG 84920"}&accountName=AU%20NGUYEN%20QUANG%20TUNG")" />
</div>
<div class="mt-3 flex items-center justify-center gap-1.5 text-xs text-emerald-800 font-medium">
<span class="material-symbols-outlined text-[16px] text-emerald-600">verified</span>
<span>Mã QR chuẩn quốc gia Napas 24/7 (Quét chuyển tiền thật)</span>
</div>
<div class="mt-1 text-[11px] text-gray-400">
Hỗ trợ 100% app Ngân hàng & MoMo, ZaloPay, Viettel Money
</div>
</div>
<!-- Bank Transfer Detailed Breakdown with Copy Actions -->
<div class="md:col-span-7 flex flex-col gap-3">
<div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-0.5 flex justify-between items-center">
  <span>Thông tin tài khoản nhận tiền:</span>
  <span class="text-emerald-600 font-bold flex items-center gap-1 text-[11px]"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Nhận tiền trực tiếp</span>
</div>
<!-- Info Row 1: Bank -->
<div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs">
<div>
<span class="text-[11px] text-gray-500 block">Ngân hàng thụ hưởng</span>
<span class="font-bold text-gray-800 text-sm sm:text-base flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
  <span id="displayBankName">@(ViewBag.BankName ?? "MB Bank (Ngân hàng Quân Đội)")</span>
</span>
</div>
<span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-md">Miễn phí CK</span>
</div>
<!-- Info Row 2: Account Name -->
<div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs">
<div class="pr-2">
<span class="text-[11px] text-gray-500 block">Tên chủ tài khoản</span>
<span class="font-bold text-gray-800 text-xs sm:text-sm uppercase tracking-wide" id="displayAccountName">
  @(ViewBag.AccountName ?? "AU NGUYEN QUANG TUNG")
</span>
</div>
<span class="material-symbols-outlined text-emerald-600 text-[18px]">verified</span>
</div>
<!-- Info Row 3: Account Number (Copy) -->
<div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs hover:border-primary/40 transition-colors">
<div>
<span class="text-[11px] text-gray-500 block">Số tài khoản thụ hưởng</span>
<span class="font-mono font-bold text-base sm:text-lg text-gray-900 tracking-wider" id="displayAccountNo">@(ViewBag.AccountNo ?? "0978008922")</span>
</div>
<button onclick="copyToClipboard('@(ViewBag.AccountNo ?? "0978008922")', 'Số tài khoản');" class="inline-flex items-center gap-1 text-xs font-semibold text-primary bg-primary/10 hover:bg-primary/20 px-3 py-1.5 rounded-lg transition-colors" type="button">
<span class="material-symbols-outlined text-[15px]">content_copy</span>
<span>Sao chép</span>
</button>
</div>
<!-- Info Row 4: Amount (Copy) -->
<div class="p-3 bg-white rounded-xl border border-slate-200 flex items-center justify-between shadow-xs hover:border-primary/40 transition-colors">
<div>
<span class="text-[11px] text-gray-500 block">Số tiền chính xác</span>
<span class="font-mono font-bold text-lg text-primary">@(((decimal)(ViewBag.TotalAmount ?? 180000m)).ToString("N0")) đ</span>
</div>
<button onclick="copyToClipboard('@(((decimal)(ViewBag.TotalAmount ?? 180000m)).ToString("F0"))', 'Số tiền');" class="inline-flex items-center gap-1 text-xs font-semibold text-primary bg-primary/10 hover:bg-primary/20 px-3 py-1.5 rounded-lg transition-colors" type="button">
<span class="material-symbols-outlined text-[15px]">content_copy</span>
<span>Sao chép</span>
</button>
</div>
<!-- Info Row 5: Transfer memo / code (CRITICAL) -->
<div class="p-3 bg-amber-50/70 rounded-xl border-2 border-dashed border-amber-300 flex items-center justify-between">
<div>
<span class="text-[11px] font-bold text-amber-900 flex items-center gap-1">
  Nội dung chuyển khoản (Bắt buộc giữ nguyên)
  <span class="material-symbols-outlined text-[13px] text-amber-700">info</span>
</span>
<span class="font-mono font-black text-lg text-red-600 tracking-wider" id="displayTransferMemo">@(ViewBag.TransferMemo ?? ((string)(ViewBag.TicketCode ?? "SBG84920")).Replace("-", ""))</span>
</div>
<button onclick="copyToClipboard('@(ViewBag.TransferMemo ?? ((string)(ViewBag.TicketCode ?? "SBG84920")).Replace("-", ""))', 'Nội dung chuyển khoản');" class="inline-flex items-center gap-1 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 px-3.5 py-1.5 rounded-lg shadow-sm transition-colors" type="button">
<span class="material-symbols-outlined text-[15px]">content_copy</span>
<span>Sao chép</span>
</button>
</div>
<div class="text-[11px] text-amber-800 leading-tight">
  * Vui lòng giữ nguyên nội dung <strong>@(ViewBag.TransferMemo ?? ((string)(ViewBag.TicketCode ?? "SBG84920")).Replace("-", ""))</strong> khi quét mã để hệ thống tự động gạch nợ và gửi mã vé điện tử SMS/Email trong 3 giây.
</div>
</div>
</div>
<!-- Real-time Status Indicator -->
<div class="mt-6 pt-5 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-slate-200/80">
<div class="flex items-center gap-3">
<div class="relative flex items-center justify-center">
<div class="w-5 h-5 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
</div>
<div class="text-xs text-gray-700">
<span class="font-semibold text-gray-900">Đang lắng nghe giao dịch chuyển khoản từ Ngân hàng...</span>
<span class="block text-gray-500 text-[11px]">Hệ thống kiểm tra mỗi 3 giây và tự động mở vé khi tiền về tài khoản.</span>
</div>
</div>
<span class="text-[11px] font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 whitespace-nowrap">
  ● Cổng VietQR Napas247 Active
</span>
</div>
<!-- Big CTA Confirmation Button -->
<div class="mt-5">
<form asp-controller="Ticket" asp-action="ConfirmPayment" method="post" class="w-full">
