      @if (ViewBag.AvailableVouchers != null)
      {
        foreach (var v in (IEnumerable<WebApplication1.Models.DTOs.VoucherDto>)ViewBag.AvailableVouchers)
        {
          var discountDesc = v.Type == "percent" ? $"{v.Value}%" : $"{v.Value:N0} đ";
          <button type="button" onclick="selectVoucherChip('@v.Id')" class="voucher-chip inline-flex items-center gap-1 px-2 py-1 rounded-md text-[11px] font-semibold bg-white border border-emerald-200 hover:border-primary hover:bg-emerald-50 text-emerald-900 transition-all shadow-2xs">
