<script>
        function switchQrMode(mode) {
            const tabPayOS = document.getElementById("tabPayOS");
            const tabVietQR = document.getElementById("tabVietQR");
            const mainQr = document.getElementById("mainQrImage");
            const qrTitle = document.getElementById("qrTitle");
            const qrDesc = document.getElementById("qrDesc");
            const qrBadges = document.getElementById("qrBadges");

            if (mode === 'vietqr') {
                tabVietQR.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-[#008378] text-white shadow-sm flex items-center gap-1.5 cursor-pointer";
                tabPayOS.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5 cursor-pointer";
                mainQr.src = "@vietQrUrl";
                qrTitle.textContent = "Quét mã VietQR chuyển khoản ngân hàng";
                qrDesc.innerHTML = "Mở ứng dụng ngân hàng bất kỳ (VCB, MB, Techcombank, VPBank...) để quét mã chuyển tiền thật vào tài khoản nhà xe.";
                qrBadges.innerHTML = '<span class="font-extrabold text-[13px] tracking-tight text-blue-900 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">VietQR</span><span class="font-bold text-[11px] text-gray-700 bg-gray-100 px-2 py-0.5 rounded">Napas247</span>';
            } else {
                tabPayOS.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-[#0052cc] text-white shadow-sm flex items-center gap-1.5 cursor-pointer";
                tabVietQR.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold text-gray-700 hover:text-gray-900 transition-all flex items-center gap-1.5 cursor-pointer";
                mainQr.src = "@payOsQrUrl";
                qrTitle.textContent = "Quét mã payOS Sandbox bằng điện thoại";
                qrDesc.innerHTML = "Bật <strong>Camera</strong> (iPhone/Android) hoặc <strong>Zalo</strong> trên điện thoại để quét mã QR và xác nhận thanh toán như bình thường mà <strong>hoàn toàn không bị trừ tiền thật</strong>.";
                qrBadges.innerHTML = '<span class="font-extrabold text-[13px] tracking-tight text-white bg-[#0052cc] px-2 py-0.5 rounded border border-blue-600">payOS Sandbox</span><span class="font-bold text-[11px] text-amber-800 bg-amber-100 px-2 py-0.5 rounded border border-amber-300">Không trừ tiền thật</span>';
            }
        }

        async function quickSimulatePayment() {
            const btn = document.getElementById("btnQuickPay");
            const btnText = document.getElementById("btnQuickPayText");
            if (btn) btn.disabled = true;
            if (btnText) btnText.innerHTML = '<span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span> Đang xử lý...</span>';

            const currentTicketCode = "@Html.Raw(cleanTicketCode)";
            const currentBookingCode = "@Html.Raw(cleanBookingCode)";
            const amount = Number("@amountFormatted");

            try {
                const res = await fetch('/api/payos/simulate-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ticketCode: currentTicketCode,
                        bookingCode: currentBookingCode,
                        amount: amount
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = `/payment-result?ticketCode=${encodeURIComponent(currentTicketCode)}&bookingCode=${encodeURIComponent(currentBookingCode)}&amount=${amount}&status=success`;
                } else {
                    alert(data.message || "Có lỗi xảy ra khi xác nhận thanh toán.");
                    if (btn) btn.disabled = false;
                    if (btnText) btnText.textContent = "⚡ Xác nhận thanh toán ngay (Test trực tiếp)";
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi khi kết nối API.");
                if (btn) btn.disabled = false;
                if (btnText) btnText.textContent = "⚡ Xác nhận thanh toán ngay (Test trực tiếp)";
            }
        }

        function handleConfirmPayment() {
            const currentTicketCode = "@(ViewBag.TicketCode ?? "SBG-TN-CB-001")";
            const currentBookingCode = "@(ViewBag.BookingCode ?? "BK-TNCB-001")";
            const amount = "@(((decimal)(ViewBag.TotalAmount ?? 180000m)).ToString("F0"))";
            window.location.href = `/payment-result?ticketCode=${encodeURIComponent(currentTicketCode)}&bookingCode=${encodeURIComponent(currentBookingCode)}&amount=${amount}&status=success`;
        }

        document.addEventListener("DOMContentLoaded", function () {
            let checkPaymentInterval = null;

            // ==========================================
            // 2. TỰ ĐỘNG CHECK TRẠNG THÁI THANH TOÁN (POLLING)
            // ==========================================
            const orderCode = "@(ViewBag.TicketCode != null ? ((string)ViewBag.TicketCode).Replace("-", "") : "SBG84920")"; // Mã đơn hàng / Nội dung chuyển khoản
            const currentTicketCode = "@(ViewBag.TicketCode ?? "SBG-TN-CB-001")";
            const currentBookingCode = "@(ViewBag.BookingCode ?? "BK-TNCB-001")";
            const checkIntervalMs = 1500;  // Kiểm tra mỗi 1.5 giây để chuyển trang tức thì
            
            checkPaymentInterval = setInterval(async function () {
                try {
                    // Gọi API kiểm tra trạng thái thanh toán từ backend
                    const response = await fetch(`/api/payment/check-status?orderCode=${encodeURIComponent(orderCode)}&ticketCode=${encodeURIComponent(currentTicketCode)}&bookingCode=${encodeURIComponent(currentBookingCode)}`, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        
                        // data.isPaid == true nghĩa là Ngân hàng / payOS Sandbox đã xác nhận thanh toán
                        if (data.isPaid) {
                            clearInterval(checkPaymentInterval);

                            // Chuyển hướng sang trang kết quả thanh toán Callback (/payment-result)
                            window.location.href = `/payment-result?ticketCode=${encodeURIComponent(currentTicketCode)}&bookingCode=${encodeURIComponent(currentBookingCode)}&status=success`;
                        }
                    }
                } catch (error) {
                    console.error("Lỗi khi kiểm tra trạng thái thanh toán:", error);
                }
            }, checkIntervalMs);
        });
    </script>
</body>
</html>
