@model WebApplication1.Models.ViewModels.RescheduleViewModel
@{
    Layout = null;
    var old = Model?.OldTicket;
    var startCity = old?.StartPoint ?? "Hà Nội";
    var endCity = old?.EndPoint ?? "Đà Nẵng";
    var currentTicketCode = old?.TicketCode ?? "SBG-84920";
    var oldTicketPrice = (int)(old?.TotalAmount ?? old?.Price ?? 530000m);
    var oldSeatsText = old?.SeatNumber ?? "VIP 05";
    var oldSeatsList = (old?.SeatNumber ?? "").Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries).ToList();
    var requiredSeatCount = oldSeatsList.Count > 0 ? oldSeatsList.Count : 1;
    var trips = Model?.AvailableTrips ?? new List<WebApplication1.Models.ViewModels.TripItemViewModel>();
    var selectedTrip = Model?.SelectedTrip ?? trips.FirstOrDefault();
    var firstTrip = selectedTrip ?? trips.FirstOrDefault();
    var defaultTripPrice = (int)(firstTrip?.Price ?? 290000m);
    var defaultTripId = firstTrip?.TripId ?? 202;
    var defaultSeatsPool = new[] { "VIP 08", "VIP 09", "VIP 11", "VIP 12", "VIP 18", "VIP 19" };
    var initialSeatsList = defaultSeatsPool.Take(requiredSeatCount).ToList();
    var initialSeatsStr = string.Join(", ", initialSeatsList);
    var initialNewPrice = defaultTripPrice * requiredSeatCount;
    var targetDateStr = Model?.NewDepartureDate.ToString("dd/MM/yyyy") ?? "25/10/2026";
    var newDateIso = Model?.NewDepartureDate.ToString("yyyy-MM-dd") ?? "2026-10-25";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đổi Chuyến Xe - SmartBus Go #@currentTicketCode</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
        }
        .seat-btn { transition: all 0.2s ease; }
        .seat-btn:hover:not(.booked):not(.selected) { transform: translateY(-2px); }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#00685f",
                        "primary-hover": "#00524b",
                        "primary-light": "#e6f4f2",
                        surface: "#f8fafc"
                    },
                    fontFamily: {
                        sans: ["Inter", "sans-serif"],
                        heading: ["Plus Jakarta Sans", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-surface font-sans text-gray-800 antialiased min-h-screen flex flex-col justify-between">

    <!-- HEADER ĐIỀU HƯỚNG CHUNG -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
        <div class="border-b border-gray-100 text-[13px] text-gray-600 bg-white hidden sm:block">
            <div class="max-w-6xl mx-auto px-4 py-1.5 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[17px]">verified_user</span>
                    <span>Đặt vé thông minh 4.0</span>
                    <span class="text-gray-300 mx-1">•</span>
                    <span class="material-symbols-outlined text-gray-500 text-[17px]">directions_bus</span>
                    <span>Hơn 3,000+ chuyến xe toàn quốc</span>
                </div>
                <div class="flex items-center gap-4 text-gray-700">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-primary text-[17px]">call</span>
                        <span>Hotline: <strong class="text-gray-900 font-bold">1900 6868</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-6">
                <a class="flex items-center gap-2" href="/Home/Index">
                    <span class="material-symbols-outlined text-[32px] text-primary">directions_bus</span>
                    <span class="text-[22px] font-bold text-gray-900 font-heading tracking-tight">SmartBus<span class="text-primary">Go</span></span>
                </a>

                <nav class="hidden md:flex items-center gap-5 ml-2">
                    <a class="font-medium text-[14px] text-gray-700 hover:text-primary transition-colors" href="/Home/Index">Trang chủ</a>
                    <a class="font-medium text-[14px] text-gray-700 hover:text-primary transition-colors" href="/Ticket/Payment">Thanh toán vé</a>
                    <a class="font-medium text-[14px] text-gray-700 hover:text-primary transition-colors" href="/Ticket/Detail">Vé điện tử</a>
                    <a class="font-medium text-[14px] text-primary font-bold hover:text-primary transition-colors" href="/Ticket/Reschedule">Đổi chuyến</a>
                    <a class="font-medium text-[14px] text-gray-700 hover:text-primary transition-colors" href="/Ticket/Cancel">Hủy vé</a>
                </nav>
            </div>

            <div class="flex items-center gap-2">
                <a href="/Ticket/Detail" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-gray-700 font-semibold text-[13px] transition-colors">
                    <span class="material-symbols-outlined text-[17px]">arrow_back</span>
                    <span>Quay lại vé</span>
                </a>
            </div>
        </div>
    </header>

    <!-- TOAST THÔNG BÁO NỔI (ĐẢM BẢO KHÔNG BỊ TRÀN) -->
    <div id="toastNotification" class="fixed top-20 right-4 sm:right-6 max-w-sm w-[calc(100vw-2rem)] z-50 bg-white border border-gray-200 shadow-xl rounded-xl p-3.5 transform transition-all duration-300 translate-y-[-20px] opacity-0 pointer-events-none overflow-hidden break-words flex items-start gap-2.5">
        <span id="toastIcon" class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5">info</span>
        <div class="flex-1 min-w-0">
            <p id="toastMessage" class="text-sm font-medium text-gray-900 break-words leading-snug"></p>
        </div>
    </div>

    <!-- MAIN BODY -->
    <main class="w-full pt-[90px] sm:pt-[100px] pb-12 flex-1">
        <div class="max-w-6xl mx-auto px-4">

            <!-- TIÊU ĐỀ & MÃ VÉ -->
            <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-gray-200/80 pb-3">
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold font-heading text-gray-900">Đổi Chuyến Xe</h1>
                    <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                        Mã vé: <span class="font-mono font-bold text-gray-800">#@currentTicketCode</span> • Tuyến: <strong class="text-gray-800">@startCity → @endCity</strong>
                    </p>
                </div>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold w-fit">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">verified</span>
                    <span>Đổi chuyến miễn phí trước 24h</span>
                </div>
            </div>

            <!-- THÔNG BÁO HƯỚNG DẪN GỌN GÀNG (KHÔNG TRÀN LỀ) -->
            <div class="w-full max-w-full overflow-hidden break-words p-3 rounded-xl bg-teal-50/70 border border-teal-200/70 text-teal-900 text-xs sm:text-sm mb-5 flex items-start gap-2.5">
                <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">info</span>
                <span class="break-words min-w-0">
                    Vui lòng chọn ngày, chuyến xe và vị trí ghế mới. Toàn bộ số tiền đã trả cho vé cũ (<strong class="text-primary font-bold">@oldTicketPrice.ToString("N0") đ</strong>) sẽ được tự động khấu trừ vào chuyến mới.
                </span>
            </div>

            <!-- LAYOUT 2 CỘT GỌN GÀNG -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

                <!-- CỘT TRÁI (7/12): THÔNG TIN VÉ CŨ & SƠ ĐỒ CHỌN GHẾ MỚI -->
                <div class="lg:col-span-7 flex flex-col gap-4">

                    <!-- KHỐI 1: TÓM TẮT VÉ HIỆN TẠI & THÔNG TIN CHUYẾN MỚI -->
                    <div class="bg-white rounded-xl border border-gray-200 shadow-xs p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                            <!-- Vé cũ -->
                            <div class="p-3 rounded-lg bg-gray-50 border border-gray-100 flex flex-col gap-1.5 overflow-hidden">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-bold uppercase text-gray-500">Vé hiện tại</span>
                                    <span class="text-[11px] font-mono text-gray-600">#@currentTicketCode</span>
                                </div>
                                <div class="text-sm font-bold text-gray-900 truncate">@startCity → @endCity</div>
                                <div class="text-xs text-gray-600">
                                    <span>Khởi hành: </span>
                                    <strong>@(old?.DepartureTime.ToString(@"hh\:mm") ?? "20:30")</strong> ngày <strong>@(old != null ? old.TripDate.ToString("dd/MM/yyyy") : "24/10/2026")</strong>
                                </div>
                                <div class="text-xs text-gray-600">
                                    <span>Vị trí ghế: </span><strong class="text-gray-800">@oldSeatsText</strong>
                                </div>
                                <div class="text-xs text-gray-600 pt-1 border-t border-gray-200">
                                    <span>Đã thanh toán: </span><strong class="text-primary">@oldTicketPrice.ToString("N0") đ</strong>
                                </div>
                            </div>

                            <!-- Chuyến mới muốn đổi -->
                            <div class="p-3 rounded-lg bg-emerald-50/50 border border-emerald-100 flex flex-col gap-1.5 overflow-hidden">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-bold uppercase text-primary">Chuyến mới</span>
                                    <span class="text-[11px] font-semibold text-emerald-700" id="badgeTripStatus">Đã chọn</span>
                                </div>
                                <div>
                                    <label class="text-[11px] text-gray-600 block mb-0.5">Ngày khởi hành mới:</label>
                                    <input type="date" id="inputNewDate" value="@newDateIso" class="w-full text-xs font-semibold px-2 py-1.5 bg-white border border-gray-300 rounded-md focus:ring-1 focus:ring-primary focus:outline-none" onchange="onDateChanged(this.value)" />
                                </div>
                                <div>
                                    <label class="text-[11px] text-gray-600 block mb-0.5">Giờ khởi hành mới:</label>
                                    <select id="selectTripTime" class="w-full text-xs font-semibold px-2 py-1.5 bg-white border border-gray-300 rounded-md focus:ring-1 focus:ring-primary focus:outline-none" onchange="onTripTimeChanged(this)">
@if (trips.Any())
{
    foreach (var t in trips)
    {
        var isSel = (selectedTrip != null && selectedTrip.TripId == t.TripId) || (selectedTrip == null && t == trips.First());
        <option value="@t.DepartureTime.ToString(@"hh\:mm")" data-price="@((int)t.Price)" data-tripid="@t.TripId" selected="@(isSel ? "selected" : null)">@t.DepartureTime.ToString(@"hh\:mm") • @t.BusTypeName (@t.Price.ToString("N0") đ/vé)</option>
    }
}
else
{
    <option value="21:00" data-price="290000" data-tripid="202" selected>21:00 • Limousine VIP (290.000 đ/vé)</option>
    <option value="08:30" data-price="270000" data-tripid="203">08:30 • Xe Giường Nằm (270.000 đ/vé)</option>
    <option value="14:00" data-price="280000" data-tripid="204">14:00 • Limousine VIP (280.000 đ/vé)</option>
}


                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KHỐI 2: SƠ ĐỒ CHỌN GHẾ MỚI TINH GỌN -->
                    <div class="bg-white rounded-xl border border-gray-200 shadow-xs p-4 flex flex-col gap-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 pb-2">
                            <div>
                                <h2 class="text-sm sm:text-base font-bold text-gray-900 font-heading">Chọn Ghế Ngồi Mới</h2>
                                <p class="text-xs text-gray-500">Vui lòng chọn @requiredSeatCount ghế tương ứng với số vé của bạn</p>
                            </div>

                            <!-- Nút chọn Tầng 1 / Tầng 2 -->
                            <div class="inline-flex p-0.5 bg-gray-100 rounded-lg self-start sm:self-auto text-xs">
                                <button type="button" class="px-3 py-1 rounded-md font-semibold transition-all bg-white text-primary shadow-xs" id="tab-floor-1" onclick="switchFloor('lower')">
                                    Tầng 1
                                </button>
                                <button type="button" class="px-3 py-1 rounded-md font-semibold transition-all text-gray-600 hover:text-gray-900" id="tab-floor-2" onclick="switchFloor('upper')">
                                    Tầng 2
                                </button>
                            </div>
                        </div>

                        <!-- Chú thích ghế đơn giản -->
                        <div class="flex items-center gap-4 text-xs text-gray-600 py-1 flex-wrap">
                            <div class="flex items-center gap-1.5">
                                <div class="w-4 h-4 rounded bg-white border border-gray-300"></div>
                                <span>Trống</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="w-4 h-4 rounded bg-primary"></div>
                                <span class="font-bold text-primary">Đang chọn</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="w-4 h-4 rounded bg-gray-200"></div>
                                <span>Đã bán</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="w-4 h-4 rounded bg-rose-100 border border-dashed border-rose-400"></div>
                                <span class="text-rose-600 font-medium">Ghế cũ</span>
                            </div>
                        </div>

                        <!-- Sơ đồ ghế Tầng 1 -->
                        <div id="deck-lower" class="grid grid-cols-2 gap-2.5 max-w-md mx-auto w-full py-2">
                            <!-- Hàng 1 -->
                            <button type="button" class="seat-btn booked p-2.5 rounded-lg bg-gray-100 text-gray-400 border border-gray-200 flex items-center justify-between text-xs cursor-not-allowed">
                                <span class="font-bold">VIP 01</span>
                                <span class="text-[10px]">Đã bán</span>
                            </button>
                            <button type="button" class="seat-btn booked p-2.5 rounded-lg bg-gray-100 text-gray-400 border border-gray-200 flex items-center justify-between text-xs cursor-not-allowed">
                                <span class="font-bold">VIP 02</span>
                                <span class="text-[10px]">Đã bán</span>
                            </button>

                            <!-- Hàng 2 -->
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 03" onclick="toggleSeat(this, 'VIP 03')">
                                <span class="font-bold text-gray-800">VIP 03</span>
                                <span class="text-[11px] text-gray-500">290k</span>
                            </button>
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 04" onclick="toggleSeat(this, 'VIP 04')">
                                <span class="font-bold text-gray-800">VIP 04</span>
                                <span class="text-[11px] text-gray-500">290k</span>
                            </button>

                            <!-- Hàng 3 (Ghế cũ) -->
                            <div class="p-2.5 rounded-lg bg-rose-50 border border-dashed border-rose-300 flex items-center justify-between text-xs text-rose-700">
                                <span class="font-bold">VIP 05</span>
                                <span class="text-[10px] font-semibold">Ghế cũ</span>
                            </div>
                            <div class="p-2.5 rounded-lg bg-rose-50 border border-dashed border-rose-300 flex items-center justify-between text-xs text-rose-700">
                                <span class="font-bold">VIP 06</span>
                                <span class="text-[10px] font-semibold">Ghế cũ</span>
                            </div>

                            <!-- Hàng 4 (Đang chọn) -->
                            <button type="button" class="seat-btn selected p-2.5 rounded-lg bg-primary text-white border border-primary flex items-center justify-between text-xs cursor-pointer shadow-sm ring-2 ring-primary/30" data-seat="VIP 08" onclick="toggleSeat(this, 'VIP 08')">
                                <span class="font-bold">VIP 08</span>
                                <span class="text-[11px]">Đã chọn</span>

                            </button>
                            @if (initialSeatsList.Contains("VIP 09"))
                            {
                                <button type="button" class="seat-btn selected p-2.5 rounded-lg bg-primary text-white border border-primary flex items-center justify-between text-xs cursor-pointer shadow-sm ring-2 ring-primary/30" data-seat="VIP 09" onclick="toggleSeat(this, 'VIP 09')">
                                    <span class="font-bold">VIP 09</span>
                                    <span class="text-[11px]">Đã chọn</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 09" onclick="toggleSeat(this, 'VIP 09')">
                                    <span class="font-bold text-gray-800">VIP 09</span>
                                    <span class="text-[11px] text-gray-500">290k</span>
                                </button>
                            }
@*


                            </button>

*@
                            <!-- Hàng 5 -->
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 11" onclick="toggleSeat(this, 'VIP 11')">
                                <span class="font-bold text-gray-800">VIP 11</span>
                                <span class="text-[11px] text-gray-500">290k</span>
                            </button>
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 12" onclick="toggleSeat(this, 'VIP 12')">
                                <span class="font-bold text-gray-800">VIP 12</span>
                                <span class="text-[11px] text-gray-500">290k</span>
                            </button>
                        </div>

                        <!-- Sơ đồ ghế Tầng 2 -->
                        <div id="deck-upper" class="hidden grid grid-cols-2 gap-2.5 max-w-md mx-auto w-full py-2">
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 18" onclick="toggleSeat(this, 'VIP 18')">
                                <span class="font-bold text-gray-800">VIP 18 (T2)</span>
                                <span class="text-[11px] text-gray-500">280k</span>
                            </button>
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 19" onclick="toggleSeat(this, 'VIP 19')">
                                <span class="font-bold text-gray-800">VIP 19 (T2)</span>
                                <span class="text-[11px] text-gray-500">280k</span>
                            </button>
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 20" onclick="toggleSeat(this, 'VIP 20')">
                                <span class="font-bold text-gray-800">VIP 20 (T2)</span>
                                <span class="text-[11px] text-gray-500">280k</span>
                            </button>
                            <button type="button" class="seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs" data-seat="VIP 21" onclick="toggleSeat(this, 'VIP 21')">
                                <span class="font-bold text-gray-800">VIP 21 (T2)</span>
                                <span class="text-[11px] text-gray-500">280k</span>
                            </button>
                        </div>

                        <!-- Dải thông báo ghế đang chọn (Không tràn lề) -->
                        <div class="w-full max-w-full overflow-hidden break-words p-2.5 rounded-lg bg-gray-50 border border-gray-200 text-xs flex items-center justify-between gap-2">
                            <span class="truncate">Ghế đang chọn: <strong class="text-primary" id="selectedSeatsLabel">@initialSeatsStr</strong></span>
                            <span class="text-gray-500 shrink-0">Số lượng: <strong class="text-gray-900" id="selectedCountLabel">@requiredSeatCount</strong>/@requiredSeatCount ghế</span>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI (5/12): BẢNG QUYẾT TOÁN & XÁC NHẬN ĐỔI CHUYẾN -->
                <div class="lg:col-span-5 flex flex-col gap-4">
                    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 sm:p-5 flex flex-col gap-4 sticky top-24">
                        <div class="border-b border-gray-100 pb-3">
                            <h2 class="text-base font-bold text-gray-900 font-heading">Quyết Toán Đổi Chuyến</h2>
                            <p class="text-xs text-gray-500 mt-0.5">Đối chiếu chênh lệch giữa vé cũ và vé mới</p>
                        </div>

                        <!-- Bảng chi tiết chi phí -->
                        <div class="flex flex-col gap-2 text-sm">
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">Giá vé mới:</span>
                                <span class="font-bold text-gray-900" id="billNewPrice">@initialNewPrice.ToString("N0") đ</span>
                            </div>

                            <div class="flex items-center justify-between text-gray-600">
                                <span>Khấu trừ vé cũ:</span>
                                <span class="font-semibold text-rose-600">- @oldTicketPrice.ToString("N0") đ</span>
                            </div>

                            <div class="flex items-center justify-between text-gray-600">
                                <span>Phí đổi vé (trước 24h):</span>
                                <span class="font-semibold text-emerald-600">0 đ (Miễn phí)</span>
                            </div>

                            <div class="pt-2.5 border-t border-gray-100 flex items-center justify-between">
                                <div class="flex flex-col">
                                    <span class="font-bold text-gray-900" id="deltaTitle">Cần thanh toán thêm:</span>
                                    <span class="text-[11px] text-gray-500" id="deltaSubtitle">Chênh lệch giá vé mới</span>
                                </div>
                                <span class="text-xl font-bold text-primary font-mono" id="deltaAmount">50.000 đ</span>
                            </div>
                        </div>

                        <!-- FORM XÁC NHẬN -->
                        <form id="rescheduleForm" method="post" action="/Ticket/ConfirmReschedule" class="flex flex-col gap-2.5 mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OldTicket.TicketCode" value="@currentTicketCode" />
                            <input type="hidden" name="OldTicket.TicketId" value="@(old?.TicketId ?? 1024)" />
                            <input type="hidden" name="NewDepartureDate" id="formNewDepartureDate" value="@newDateIso" />
                            <input type="hidden" name="SelectedTripId" id="formTripId" value="@defaultTripId" />
                            <input type="hidden" name="SelectedNewSeat" id="formSelectedSeat" value="@initialSeatsStr" />
                            <input type="hidden" name="NewSeatPrice" id="formNewPrice" value="@initialNewPrice" />
                            <input type="hidden" name="SelectedBoardingPoint" value="@startCity" />
                            <input type="hidden" name="SelectedDropOffPoint" value="@endCity" />

                            <button type="submit" id="btnSubmit" class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer">
                                <span class="material-symbols-outlined text-[19px]">check_circle</span>
                                <span id="btnSubmitText">Xác nhận đổi chuyến (Trả thêm 50.000 đ)</span>
                            </button>

                            <a href="/Ticket/Detail" class="w-full py-2.5 px-4 rounded-xl border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50 font-semibold text-xs text-center transition-colors">
                                Hủy bỏ & Giữ nguyên vé cũ
                            </a>
                        </form>

                        <div class="pt-2 text-center text-xs text-gray-400">
                            Cần hỗ trợ? Gọi hotline <strong class="text-gray-600">1900 6868</strong>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- FOOTER GỌN GÀNG -->
    <footer class="bg-white border-t border-gray-100 py-4 mt-auto">
        <div class="max-w-6xl mx-auto px-4 text-center text-xs text-gray-500">
            &copy; 2026 SmartBus Go. Hệ thống đổi vé & quản lý vé xe buýt thông minh toàn quốc.
        </div>
    </footer>

    <!-- JAVASCRIPT XỬ LÝ CHỌN GHẾ & TÍNH TOÁN -->
    <script>
        const requiredSeatCount = @requiredSeatCount;
        let selectedSeats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialSeatsList));
        const oldTicketPrice = @oldTicketPrice;
        let seatUnitPrice = @defaultTripPrice;

        function switchFloor(floor) {
            const tab1 = document.getElementById('tab-floor-1');
            const tab2 = document.getElementById('tab-floor-2');
            const deckLower = document.getElementById('deck-lower');
            const deckUpper = document.getElementById('deck-upper');

            if (floor === 'lower') {
                tab1.className = 'px-3 py-1 rounded-md font-semibold transition-all bg-white text-primary shadow-xs';
                tab2.className = 'px-3 py-1 rounded-md font-semibold transition-all text-gray-600 hover:text-gray-900';
                deckLower.classList.remove('hidden');
                deckUpper.classList.add('hidden');
            } else {
                tab2.className = 'px-3 py-1 rounded-md font-semibold transition-all bg-white text-primary shadow-xs';
                tab1.className = 'px-3 py-1 rounded-md font-semibold transition-all text-gray-600 hover:text-gray-900';
                deckUpper.classList.remove('hidden');
                deckLower.classList.add('hidden');
            }
        }

        function toggleSeat(btn, seatNumber) {
            const index = selectedSeats.indexOf(seatNumber);

            if (index > -1) {
                if (selectedSeats.length === 1 && requiredSeatCount === 1) {
                    showToast('Bạn cần chọn đủ ' + requiredSeatCount + ' ghế theo số vé cũ.', 'warning');
                    return;
                }
                selectedSeats.splice(index, 1);
                applySeatStyle(btn, false);
            } else {
                if (selectedSeats.length >= requiredSeatCount) {
                    const oldestSeat = selectedSeats.shift();
                    const oldestBtn = document.querySelector(`[data-seat="${oldestSeat}"]`);
                    if (oldestBtn) applySeatStyle(oldestBtn, false);
                }
                selectedSeats.push(seatNumber);
                applySeatStyle(btn, true);
            }

            updateCalculation();
        }

        function applySeatStyle(btn, isSelected) {
            if (isSelected) {
                btn.className = 'seat-btn selected p-2.5 rounded-lg bg-primary text-white border border-primary flex items-center justify-between text-xs cursor-pointer shadow-sm ring-2 ring-primary/30';
                const label = btn.querySelector('span:last-child');
                if (label) label.textContent = 'Đã chọn';
            } else {
                btn.className = 'seat-btn p-2.5 rounded-lg bg-white border border-gray-300 hover:border-primary flex items-center justify-between text-xs cursor-pointer shadow-xs';
                const label = btn.querySelector('span:last-child');
                if (label) label.textContent = '290k';
            }
        }

        function updateCalculation() {
            const count = selectedSeats.length;
            const newTotal = count * seatUnitPrice;
            const delta = newTotal - oldTicketPrice;
            const seatText = selectedSeats.join(', ');

            document.getElementById('selectedSeatsLabel').textContent = seatText || 'Chưa chọn ghế';
            document.getElementById('selectedCountLabel').textContent = count;
            document.getElementById('billNewPrice').textContent = newTotal.toLocaleString('vi-VN') + ' đ';

            const deltaTitle = document.getElementById('deltaTitle');
            const deltaSubtitle = document.getElementById('deltaSubtitle');
            const deltaAmount = document.getElementById('deltaAmount');
            const btnSubmitText = document.getElementById('btnSubmitText');

            document.getElementById('formSelectedSeat').value = seatText;
            document.getElementById('formNewPrice').value = newTotal;

            if (delta > 0) {
                deltaTitle.textContent = 'Cần thanh toán thêm:';
                deltaSubtitle.textContent = 'Chênh lệch nâng hạng vé';
                deltaAmount.textContent = `+ ${delta.toLocaleString('vi-VN')} đ`;
                deltaAmount.className = 'text-xl font-bold text-primary font-mono';
                btnSubmitText.textContent = `Xác nhận đổi chuyến (Trả thêm ${delta.toLocaleString('vi-VN')} đ)`;
            } else if (delta < 0) {
                const refund = Math.abs(delta);
                deltaTitle.textContent = 'Số tiền được hoàn lại:';
                deltaSubtitle.textContent = 'Sẽ hoàn về tài khoản của bạn';
                deltaAmount.textContent = `- ${refund.toLocaleString('vi-VN')} đ`;
                deltaAmount.className = 'text-xl font-bold text-emerald-600 font-mono';
                btnSubmitText.textContent = `Xác nhận đổi chuyến (Hoàn lại ${refund.toLocaleString('vi-VN')} đ)`;
            } else {
                deltaTitle.textContent = 'Chênh lệch:';
                deltaSubtitle.textContent = 'Đổi chuyến miễn phí';
                deltaAmount.textContent = '0 đ';
                deltaAmount.className = 'text-xl font-bold text-gray-800 font-mono';
                btnSubmitText.textContent = 'Xác nhận đổi chuyến (Miễn phí 0 đ)';
            }
        }

        function onDateChanged(newDate) {
            document.getElementById('formNewDepartureDate').value = newDate;
            showToast(`Đang tải chuyến xe ngày ${newDate}...`, 'info');
            setTimeout(() => {
                window.location.href = `/Ticket/Reschedule?ticketCode=@(currentTicketCode)&newDate=${encodeURIComponent(newDate)}`;
            }, 350);
        }

        function onTripTimeChanged(selectEl) {
            const selectedOpt = selectEl.options[selectEl.selectedIndex];
            seatUnitPrice = parseInt(selectedOpt.getAttribute('data-price')) || 290000;
            const tripId = selectedOpt.getAttribute('data-tripid') || 202;
            document.getElementById('formTripId').value = tripId;
            updateCalculation();
            showToast(`Đã chuyển sang khung giờ ${selectEl.value}`, 'info');
        }

        // HÀM HIỂN THỊ TOAST THÔNG BÁO GỌN GÀNG, KHÔNG BAO GIỜ BỊ TRÀN
        let toastTimeout;
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toastNotification');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            if (!toast || !toastMsg) return;

            toastMsg.textContent = message;

            if (type === 'warning') {
                toastIcon.textContent = 'warning';
                toastIcon.className = 'material-symbols-outlined text-[20px] text-amber-500 shrink-0 mt-0.5';
            } else if (type === 'success') {
                toastIcon.textContent = 'check_circle';
                toastIcon.className = 'material-symbols-outlined text-[20px] text-emerald-600 shrink-0 mt-0.5';
            } else {
                toastIcon.textContent = 'info';
                toastIcon.className = 'material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5';
            }

            clearTimeout(toastTimeout);
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
            toast.classList.add('opacity-100', 'translate-y-0');

            toastTimeout = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
            }, 3000);
        }
    </script>
</body>
</html>
