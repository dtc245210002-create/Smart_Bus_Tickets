    <script>
        // Danh sách ghế đang chọn (mặc định 2 ghế theo vé cũ)
        let selectedSeats = ['VIP 08', 'VIP 09'];
        const oldTicketPrice = 530000;
        const seatUnitPrice = 290000; // Giá mỗi buồng VIP mới

        function switchFloor(floor) {
            const tab1 = document.getElementById('tab-floor-1');
            const tab2 = document.getElementById('tab-floor-2');
            const deckLower = document.getElementById('deck-lower');
            const deckUpper = document.getElementById('deck-upper');

            if (floor === 'lower') {
                tab1.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-md font-label-lg text-label-lg transition-all bg-primary text-on-primary shadow-sm flex items-center justify-center gap-1.5 cursor-pointer';
                tab2.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-md font-label-lg text-label-lg transition-all text-secondary hover:text-on-surface flex items-center justify-center gap-1.5 cursor-pointer';
                deckLower.classList.remove('hidden');
                deckUpper.classList.add('hidden');
            } else {
                tab2.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-md font-label-lg text-label-lg transition-all bg-primary text-on-primary shadow-sm flex items-center justify-center gap-1.5 cursor-pointer';
                tab1.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-md font-label-lg text-label-lg transition-all text-secondary hover:text-on-surface flex items-center justify-center gap-1.5 cursor-pointer';
                deckUpper.classList.remove('hidden');
                deckLower.classList.add('hidden');
            }
        }

        function toggleSeat(btn, seatNumber) {
            const index = selectedSeats.indexOf(seatNumber);

            if (index > -1) {
                // Bỏ chọn ghế
                if (selectedSeats.length === 1) {
                    alert('Bạn cần chọn đủ 2 ghế tương ứng với số lượng vé của bạn.');
                    return;
                }
                selectedSeats.splice(index, 1);
                applySeatUnselectedStyle(btn);
            } else {
                // Thêm ghế mới
                if (selectedSeats.length >= 2) {
                    // Bỏ chọn ghế đầu tiên để nhường chỗ cho ghế mới
                    const oldestSeat = selectedSeats.shift();
                    const oldestBtn = document.querySelector(`[data-seat="${oldestSeat}"]`);
                    if (oldestBtn) applySeatUnselectedStyle(oldestBtn);
                }
                selectedSeats.push(seatNumber);
                applySeatSelectedStyle(btn);
            }

            updatePriceAndBill();
        }

        function applySeatSelectedStyle(btn) {
            btn.className = 'seat-btn flex-1 bg-primary text-on-primary rounded-lg p-3 flex items-center justify-between shadow-md ring-2 ring-primary/40 transition-transform cursor-pointer';
            const icon = btn.querySelector('.material-symbols-outlined');
            if (icon) {
                icon.textContent = 'check_circle';
                icon.className = 'material-symbols-outlined text-[20px]';
                icon.style.fontVariationSettings = "'FILL' 1";
            }
        }

        function applySeatUnselectedStyle(btn) {
            btn.className = 'seat-btn flex-1 bg-surface-container-lowest hover:bg-primary/5 text-on-surface rounded-lg p-3 flex items-center justify-between transition-colors cursor-pointer shadow-xs';
            const icon = btn.querySelector('.material-symbols-outlined');
            if (icon) {
                icon.textContent = 'airline_seat_recline_extra';
                icon.className = 'material-symbols-outlined text-outline text-[18px]';
                icon.style.fontVariationSettings = "'FILL' 0";
            }
        }

        function updatePriceAndBill() {
            const seatCount = selectedSeats.length;
            const newTotal = seatCount * seatUnitPrice;
            const delta = newTotal - oldTicketPrice;

            const seatsText = selectedSeats.join(', ');
            
            // Cập nhật DOM
            document.getElementById('step2SummarySeats').innerText = `${seatsText} (Tầng dưới)`;
            document.getElementById('feedbackSelectedSeats').innerText = selectedSeats.join(' & ');
            document.getElementById('billSelectedSeats').innerText = seatsText;
            document.getElementById('billNewPrice').innerText = newTotal.toLocaleString('vi-VN') + ' đ';
            document.getElementById('calcNewPrice').innerText = newTotal.toLocaleString('vi-VN') + ' đ';

            const calcDelta = document.getElementById('calcDeltaPrice');
            const grandTotalValue = document.getElementById('grandTotalValue');
            const grandTotalTitle = document.getElementById('grandTotalTitle');
            const btnSubmitText = document.getElementById('btnSubmitText');
            const step3SummaryDelta = document.getElementById('step3SummaryDelta');
            const formSelectedSeat = document.getElementById('formSelectedSeat');
            const formNewPrice = document.getElementById('formNewPrice');

            if (formSelectedSeat) formSelectedSeat.value = seatsText;
            if (formNewPrice) formNewPrice.value = newTotal;

            if (delta > 0) {
                calcDelta.innerText = `+ ${delta.toLocaleString('vi-VN')} đ`;
                calcDelta.className = 'font-numeric-data text-[14px] font-semibold text-primary';
                grandTotalTitle.innerText = 'Cần thanh toán thêm';
                grandTotalValue.innerText = `${delta.toLocaleString('vi-VN')} đ`;
                btnSubmitText.innerText = `Xác nhận đổi & Trả ${delta.toLocaleString('vi-VN')} đ`;
                step3SummaryDelta.innerText = `Chênh lệch +${delta.toLocaleString('vi-VN')} đ`;
            } else if (delta < 0) {
                const refund = Math.abs(delta);
                calcDelta.innerText = `- ${refund.toLocaleString('vi-VN')} đ`;
                calcDelta.className = 'font-numeric-data text-[14px] font-semibold text-tertiary';
                grandTotalTitle.innerText = 'Bạn được hoàn lại';
                grandTotalValue.innerText = `${refund.toLocaleString('vi-VN')} đ`;
                btnSubmitText.innerText = `Xác nhận đổi & Nhận hoàn ${refund.toLocaleString('vi-VN')} đ`;
                step3SummaryDelta.innerText = `Được hoàn ${refund.toLocaleString('vi-VN')} đ`;
            } else {
                calcDelta.innerText = '0 đ';
                calcDelta.className = 'font-numeric-data text-[14px] font-semibold text-on-surface';
                grandTotalTitle.innerText = 'Đổi chuyến miễn phí';
                grandTotalValue.innerText = '0 đ';
                btnSubmitText.innerText = 'Xác nhận đổi chuyến (Miễn phí)';
                step3SummaryDelta.innerText = 'Chênh lệch 0 đ';
            }
        }

        // Countdown timer 15:00
        (function() {
            let totalSeconds = 15 * 60;
            const timerEl = document.getElementById('countdownTimer');
            if (timerEl) {
                setInterval(function() {
                    if (totalSeconds <= 0) return;
                    totalSeconds--;
                    const m = Math.floor(totalSeconds / 60);
                    const s = totalSeconds % 60;
                    timerEl.innerText = `${m < 10 ? '0' + m : m}:${s < 10 ? '0' + s : s}`;
                }, 1000);
            }
        })();

        function toggleChangeTripModal() {
            alert('Đang mở bộ lọc tìm chuyến khác. Bạn có thể chọn ngày đi và khung giờ mong muốn trên hệ thống.');
        }
    </script>
</body>
</html>
