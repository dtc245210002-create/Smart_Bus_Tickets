@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đổi Chuyến Xe - SmartBus Go</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "secondary": "#565e74",
                        "on-tertiary": "#ffffff",
                        "secondary-fixed": "#dae2fd",
                        "on-primary-fixed-variant": "#005049",
                        "on-secondary": "#ffffff",
                        "surface": "#f7f9fb",
                        "primary": "#00685f",
                        "on-primary": "#ffffff",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#3d4947",
                        "surface-variant": "#e0e3e5",
                        "secondary-fixed-dim": "#bec6e0",
                        "surface-tint": "#006a61",
                        "on-secondary-fixed": "#131b2e",
                        "inverse-on-surface": "#eff1f3",
                        "error-container": "#ffdad6",
                        "inverse-primary": "#6bd8cb",
                        "surface-container-lowest": "#ffffff",
                        "on-primary-container": "#f4fffc",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a",
                        "on-secondary-fixed-variant": "#3f465c",
                        "tertiary-fixed-dim": "#4edea3",
                        "tertiary-container": "#00855b",
                        "outline-variant": "#bcc9c6",
                        "surface-container-high": "#e6e8ea",
                        "tertiary": "#006947",
                        "primary-container": "#008378",
                        "on-tertiary-fixed-variant": "#005236",
                        "background": "#f7f9fb",
                        "on-tertiary-fixed": "#002113",
                        "surface-container-highest": "#e0e3e5",
                        "surface-container": "#eceef0",
                        "on-background": "#191c1e",
                        "primary-fixed": "#89f5e7",
                        "on-secondary-container": "#5c647a",
                        "inverse-surface": "#2d3133",
                        "primary-fixed-dim": "#6bd8cb",
                        "error": "#ba1a1a",
                        "secondary-container": "#dae2fd",
                        "outline": "#6d7a77",
                        "surface-bright": "#f7f9fb",
                        "surface-container-low": "#f2f4f6",
                        "surface-dim": "#d8dadc",
                        "on-primary-fixed": "#00201d",
                        "tertiary-fixed": "#6ffbbe",
                        "on-tertiary-container": "#f5fff6"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "space-xs": "0.25rem",
                        "space-sm": "0.5rem",
                        "space-md": "1rem",
                        "space-lg": "1.5rem",
                        "space-xl": "2.5rem",
                        "margin-sm": "1rem",
                        "margin": "1.5rem",
                        "margin-lg": "3rem",
                        "gutter-sm": "1rem",
                        "gutter": "1.5rem",
                        "gutter-lg": "2rem"
                    },
                    fontFamily: {
                        "numeric-data": ["Inter", "sans-serif"],
                        "headline-md": ["Plus Jakarta Sans", "sans-serif"],
                        "body-lg": ["Inter", "sans-serif"],
                        "display-lg": ["Plus Jakarta Sans", "sans-serif"],
                        "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
                        "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
                        "body-md": ["Inter", "sans-serif"],
                        "headline-lg-mobile": ["Plus Jakarta Sans", "sans-serif"],
                        "label-md": ["Inter", "sans-serif"],
                        "title-md": ["Inter", "sans-serif"],
                        "body-sm": ["Inter", "sans-serif"],
                        "label-lg": ["Inter", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary selection:text-on-primary">
    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
        <div class="border-b border-gray-100 text-[13px] text-gray-600 bg-white">
            <div class="max-w-7xl mx-auto px-4 lg:px-8 py-1.5 flex items-center justify-between">
                <div class="flex items-center gap-2 text-gray-600">
                    <span class="material-symbols-outlined text-primary text-[17px]">verified_user</span>
                    <span>Đặt vé thông minh 4.0</span>
                    <span class="text-gray-400 mx-1">•</span>
                    <span class="material-symbols-outlined text-gray-500 text-[17px]">directions_bus</span>
                    <span>Hơn 3,000+ chuyến xe toàn quốc</span>
                </div>
                <div class="flex items-center gap-6 text-gray-700">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-primary text-[17px]">call</span>
                        <span>Hotline: <strong class="text-gray-900 font-bold">1900 6868</strong></span>
                    </div>
                    <div class="flex items-center gap-1 cursor-pointer hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[17px] text-gray-500">language</span>
                        <span>VND | VI</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a class="flex items-center gap-3" href="/Home/Index">
                    <div class="text-[#008378] flex items-center justify-center">
                        <span class="material-symbols-outlined text-[38px] text-[#008378]">directions_bus</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[24px] font-bold text-[#0d3b2e] tracking-tight leading-none font-headline-sm">SmartBus<span class="text-[#008378]">Go</span></span>
                        <span class="mt-1 bg-emerald-50 text-[#008378] text-[10px] font-semibold px-2 py-0.5 rounded leading-tight w-fit">Vé xe buýt thông minh</span>
                    </div>
                </a>

                <nav class="flex items-center gap-6 ml-4">
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Home/Index">Trang chủ</a>
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Payment">Thanh toán vé (Demo)</a>
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Detail">Vé điện tử (Demo)</a>
                    <a class="font-medium text-[15px] text-primary font-bold hover:text-primary transition-colors" href="/Ticket/Reschedule">Đổi chuyến (Demo)</a>
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Cancel">Hủy vé (Demo)</a>
                </nav>
            </div>

            <div class="flex items-center gap-3">
                <a href="/Account/Login" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#094c3b] hover:bg-[#073c2e] text-white font-semibold text-[14px] shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[19px]">login</span>
                    <span>Đăng nhập / Đăng ký</span>
                </a>
                <a href="/Driver/Login" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold text-[14px] transition-colors">
                    <span class="material-symbols-outlined text-[19px] text-gray-600">badge</span>
                    <span>Bác tài</span>
                </a>
            </div>
        </div>
    </header>

    <main class="w-full pt-[104px] bg-[#f4f7f6] min-h-screen pb-16">
        <div class="flex flex-col w-full">
            <div class="max-w-7xl mx-auto px-margin lg:px-margin-lg py-space-lg w-full flex flex-col gap-space-lg">
                <!-- Top Flow Stepper (3-Step Visual Progress) -->
                <div class="w-full bg-surface-container-lowest rounded-xl p-space-md shadow-sm">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md relative">
                        <!-- Step 1: Completed -->
                        <div class="flex items-center gap-space-sm p-space-sm rounded-lg bg-surface-container-low transition-all">
                            <div class="w-9 h-9 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-sm">
                                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">check</span>
                            </div>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider">Bước 1</span>
                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-primary-fixed text-on-primary-fixed">Đã chọn</span>
                                </div>
                                <p class="font-title-md text-title-md text-on-surface truncate">Chọn chuyến mới</p>
                                <span class="font-body-sm text-body-sm text-secondary truncate">Hà Nội → Đà Nẵng (25/10)</span>
                            </div>
                        </div>

                        <!-- Step 2: Active -->
                        <div class="flex items-center gap-space-sm p-space-sm rounded-lg bg-primary/10 transition-all ring-1 ring-primary/30">
                            <div class="w-9 h-9 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-sm">
                                <span class="font-numeric-data text-numeric-data">2</span>
                            </div>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider">Bước 2</span>
                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-tertiary-fixed text-on-tertiary-fixed animate-pulse">Đang chọn</span>
                                </div>
                                <p class="font-title-md text-title-md text-primary font-bold truncate">Chọn lại vị trí ghế</p>
                                <span class="font-body-sm text-body-sm text-on-surface-variant truncate" id="step2SummarySeats">VIP 08, VIP 09 (Tầng dưới)</span>
                            </div>
                        </div>

                        <!-- Step 3: Pending/Overview -->
                        <div class="flex items-center gap-space-sm p-space-sm rounded-lg bg-surface-container-low transition-all">
                            <div class="w-9 h-9 rounded-full bg-surface-container-highest text-secondary flex items-center justify-center shrink-0">
                                <span class="font-numeric-data text-numeric-data">3</span>
                            </div>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-label-md text-label-md text-secondary font-medium uppercase tracking-wider">Bước 3</span>
                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-surface-container-high text-secondary">Quyết toán</span>
                                </div>
                                <p class="font-title-md text-title-md text-on-surface truncate">Đối chiếu & Quyết toán</p>
                                <span class="font-body-sm text-body-sm text-secondary truncate" id="step3SummaryDelta">Chênh lệch +50.000 đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Layout: 2 Columns Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
                    <!-- LEFT COLUMN: Workflow Step 1 Summary & Step 2 Bus Layout (8 cols ~ 66.6%) -->
                    <div class="lg:col-span-8 flex flex-col gap-space-md">
                        <!-- Module 1: Trip Summary Bar (Step 1 Recap) -->
                        <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md">
                            <div class="flex items-start sm:items-center gap-space-md">
                                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-[28px]">swap_driving_apps</span>
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-tertiary-fixed text-on-tertiary-fixed">Chuyến xe dời lại +1 ngày</span>
                                        <span class="font-label-md text-label-md text-secondary">Mã chuyến: #SBG-91024</span>
                                    </div>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="font-title-md text-title-md text-on-surface font-bold">Hà Nội</span>
                                        <span class="material-symbols-outlined text-primary text-[20px]">arrow_forward</span>
                                        <span class="font-title-md text-title-md text-on-surface font-bold">Đà Nẵng</span>
                                        <span class="text-secondary mx-1">•</span>
                                        <span class="font-body-md text-body-md text-primary font-semibold">21:00, Thứ 7 - 25/10/2025</span>
                                    </div>
                                    <span class="font-body-sm text-body-sm text-on-surface-variant">Xe Limousine VIP 34 Phòng Cung Điện Gold • Bến xe Nước Ngầm → Bến xe Trung Tâm Đà Nẵng</span>
                                </div>
                            </div>
                            <button onclick="toggleChangeTripModal();" class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">edit_calendar</span>
                                <span>Đổi chuyến khác</span>
                            </button>
                        </div>

                        <!-- Module 2: Seat Map Interactive Stage (Step 2 Main Action) -->
                        <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col gap-space-md">
                            <!-- Stage Header & Level Switcher -->
                            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm pb-space-sm bg-surface-container-lowest">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-headline-sm text-headline-sm text-on-surface">Sơ đồ chọn chỗ ngồi mới</span>
                                        <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-md text-[11px]">Còn 12/34 phòng trống</span>
                                    </div>
                                    <p class="font-body-sm text-body-sm text-secondary mt-0.5">Vui lòng chọn 2 buồng phòng VIP tương ứng với số vé của bạn</p>
                                </div>

                                <!-- Floor Selector Switcher -->
                                <div class="inline-flex p-1 bg-surface-container rounded-lg self-stretch sm:self-auto">
                                    <button class="flex-1 sm:flex-none px-4 py-1.5 rounded-md font-label-lg text-label-lg transition-all bg-primary text-on-primary shadow-sm flex items-center justify-center gap-1.5 cursor-pointer" id="tab-floor-1" onclick="switchFloor('lower')">
                                        <span class="material-symbols-outlined text-[17px]">layers</span>
                                        <span>Tầng 1 (Khoang VIP)</span>
                                    </button>
                                    <button class="flex-1 sm:flex-none px-4 py-1.5 rounded-md font-label-lg text-label-lg transition-all text-secondary hover:text-on-surface flex items-center justify-center gap-1.5 cursor-pointer" id="tab-floor-2" onclick="switchFloor('upper')">
                                        <span class="material-symbols-outlined text-[17px]">roofing</span>
                                        <span>Tầng 2 (Toàn cảnh)</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Seat Legend -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-xs p-space-sm bg-surface-container-low rounded-lg text-body-sm">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded bg-surface-container-lowest border-2 border-secondary/20 flex items-center justify-center shadow-xs">
                                        <span class="w-2 h-2 rounded-full bg-outline-variant"></span>
                                    </div>
                                    <span class="text-on-surface font-medium">Ghế trống</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded bg-primary text-on-primary flex items-center justify-center shadow-xs">
                                        <span class="material-symbols-outlined text-[14px]">check</span>
                                    </div>
                                    <span class="text-primary font-bold">Đang chọn (Mới)</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded bg-surface-container-highest text-secondary flex items-center justify-center shadow-xs">
                                        <span class="material-symbols-outlined text-[14px]">lock</span>
                                    </div>
                                    <span class="text-secondary">Đã có người đặt</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded bg-error-container text-on-error-container flex items-center justify-center border-dashed border-2 border-error shadow-xs">
                                        <span class="material-symbols-outlined text-[13px]">history</span>
                                    </div>
                                    <span class="text-on-surface-variant font-medium">Vị trí vé cũ (VIP 05, 06)</span>
                                </div>
                            </div>

                            <!-- Coach Visual Container -->
                            <div class="relative bg-surface rounded-xl p-space-md flex flex-col items-center">
                                <!-- Bus Steering & Front Header -->
                                <div class="w-full max-w-lg flex items-center justify-between px-space-md py-2 bg-surface-container-high rounded-t-xl mb-4">
                                    <div class="flex items-center gap-2 text-secondary">
                                        <span class="material-symbols-outlined text-[20px]">sports_motorsports</span>
                                        <span class="font-label-md text-label-md">Bác tài / Khoang lái</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-primary">
                                        <span class="material-symbols-outlined text-[18px]">door_front</span>
                                        <span class="font-label-md text-label-md">Cửa lên xuống</span>
                                    </div>
                                </div>

                                <!-- Lower Deck Layout -->
                                <div class="w-full max-w-lg transition-all flex flex-col gap-3" id="deck-lower">
                                    <!-- Row 1: VIP 01 - VIP 02 (Booked) -->
                                    <div class="flex items-center justify-between gap-4">
                                        <div class="flex-1 bg-surface-container-highest text-secondary rounded-lg p-3 flex items-center justify-between cursor-not-allowed opacity-80">
                                            <div class="flex flex-col">
                                                <span class="font-numeric-data text-numeric-data">VIP 01</span>
                                                <span class="font-body-sm text-[11px]">Đã mua</span>
                                            </div>
                                            <span class="material-symbols-outlined text-[18px]">lock</span>
                                        </div>
                                        <div class="w-16 flex items-center justify-center">
                                            <span class="font-label-md text-[10px] text-secondary tracking-widest uppercase rotate-90">Lối đi</span>
                                        </div>
                                        <div class="flex-1 bg-surface-container-highest text-secondary rounded-lg p-3 flex items-center justify-between cursor-not-allowed opacity-80">
                                            <div class="flex flex-col">
                                                <span class="font-numeric-data text-numeric-data">VIP 02</span>
                                                <span class="font-body-sm text-[11px]">Đã mua</span>
                                            </div>
                                            <span class="material-symbols-outlined text-[18px]">lock</span>
                                        </div>
                                    </div>

                                    <!-- Row 2: VIP 03 - VIP 04 (Available) -->
                                    <div class="flex items-center justify-between gap-4">
                                        <button type="button" class="seat-btn flex-1 bg-surface-container-lowest hover:bg-primary/5 text-on-surface rounded-lg p-3 flex items-center justify-between transition-colors cursor-pointer shadow-xs" data-seat="VIP 03" onclick="toggleSeat(this, 'VIP 03')">
                                            <div class="flex flex-col items-start">
                                                <span class="font-numeric-data text-numeric-data text-on-surface">VIP 03</span>
                                                <span class="font-body-sm text-[11px] text-secondary">Cửa sổ trái</span>
                                            </div>
                                            <span class="material-symbols-outlined text-outline text-[18px]">airline_seat_recline_extra</span>
                                        </button>
                                        <div class="w-16 flex items-center justify-center">
                                            <span class="w-1 h-8 rounded-full bg-surface-container-highest"></span>
                                        </div>
                                        <button type="button" class="seat-btn flex-1 bg-surface-container-lowest hover:bg-primary/5 text-on-surface rounded-lg p-3 flex items-center justify-between transition-colors cursor-pointer shadow-xs" data-seat="VIP 04" onclick="toggleSeat(this, 'VIP 04')">
                                            <div class="flex flex-col items-start">
                                                <span class="font-numeric-data text-numeric-data text-on-surface">VIP 04</span>
                                                <span class="font-body-sm text-[11px] text-secondary">Cửa sổ phải</span>
                                            </div>
                                            <span class="material-symbols-outlined text-outline text-[18px]">airline_seat_recline_extra</span>
                                        </button>
                                    </div>

                                    <!-- Row 3: Old Seat Reminder Markers (VIP 05 - VIP 06 from old ticket) -->
                                    <div class="flex items-center justify-between gap-4">
                                        <div class="flex-1 bg-error-container/40 text-on-surface rounded-lg p-3 flex items-center justify-between relative overflow-hidden border border-dashed border-error/50">
                                            <div class="flex flex-col">
                                                <div class="flex items-center gap-1">
                                                    <span class="font-numeric-data text-numeric-data">VIP 05</span>
                                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-error text-on-error">Vé cũ</span>
                                                </div>
                                                <span class="font-body-sm text-[11px] text-on-surface-variant">Đã trả buồng này</span>
                                            </div>
                                            <span class="material-symbols-outlined text-error text-[18px]">event_repeat</span>
                                        </div>
                                        <div class="w-16 flex items-center justify-center">
                                            <span class="w-1 h-8 rounded-full bg-surface-container-highest"></span>
                                        </div>
                                        <div class="flex-1 bg-error-container/40 text-on-surface rounded-lg p-3 flex items-center justify-between relative overflow-hidden border border-dashed border-error/50">
                                            <div class="flex flex-col">
                                                <div class="flex items-center gap-1">
                                                    <span class="font-numeric-data text-numeric-data">VIP 06</span>
                                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-error text-on-error">Vé cũ</span>
                                                </div>
                                                <span class="font-body-sm text-[11px] text-on-surface-variant">Đã trả buồng này</span>
                                            </div>
                                            <span class="material-symbols-outlined text-error text-[18px]">event_repeat</span>
                                        </div>
                                    </div>

                                    <!-- Row 4: VIP 07 - VIP 08 (SELECTED) -->
                                    <div class="flex items-center justify-between gap-4">
