@model WebApplication1.Models.ViewModels.PaymentResultViewModel
@{
    Layout = null;
    var isInitialFailed = Model.Status == "FAILED";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Kết Quả Thanh Toán - SmartBus Go #@Model.TicketCode</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }

        /* Animation Keyframes */
        @@keyframes scaleIn {
            0% { transform: scale(0.6); opacity: 0; }
            70% { transform: scale(1.08); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }

        @@keyframes checkDraw {
            0% { stroke-dashoffset: 50; }
            100% { stroke-dashoffset: 0; }
        }

        @@keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(0, 131, 120, 0.4); }
            50% { box-shadow: 0 0 0 16px rgba(0, 131, 120, 0); }
        }

        .anim-scale-in {
            animation: scaleIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .anim-pulse-glow {
            animation: pulseGlow 2s infinite;
        }

        .check-svg path {
            stroke-dasharray: 50;
            stroke-dashoffset: 0;
            animation: checkDraw 0.6s ease-in-out forwards;
        }

        @@media print {
            header, footer, .no-print { display: none !important; }
            main { padding-top: 0 !important; background: #fff !important; }
            .print-card { box-shadow: none !important; border: 1px solid #ccc !important; }
        }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#00685f",
                        "primary-hover": "#00524b",
                        "primary-container": "#008378",
                        "on-primary": "#ffffff",
                        "surface": "#f7f9fb",
                        "on-surface": "#191c1e",
                        "secondary": "#565e74",
                        "tertiary": "#006947",
                        "error": "#ba1a1a"
                    },
                    fontFamily: {
                        "sans": ["Inter", "sans-serif"],
                        "headline": ["Plus Jakarta Sans", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-[#f4f7f6] font-sans text-on-surface antialiased selection:bg-primary selection:text-white min-h-screen flex flex-col justify-between">

    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm no-print">
        <div class="border-b border-gray-100 text-[13px] text-gray-600 bg-white">
            <div class="max-w-7xl mx-auto px-4 lg:px-8 py-1.5 flex items-center justify-between">
                <div class="flex items-center gap-2 text-gray-600">
                    <span class="material-symbols-outlined text-[#008378] text-[17px]">verified_user</span>
                    <span>Đặt vé thông minh 4.0</span>
                    <span class="text-gray-400 mx-1">•</span>
                    <span class="material-symbols-outlined text-gray-500 text-[17px]">directions_bus</span>
                    <span>Hơn 3,000+ chuyến xe toàn quốc</span>
                </div>
                <div class="flex items-center gap-6 text-gray-700">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[#008378] text-[17px]">call</span>
                        <span>Hotline: <strong class="text-gray-900 font-bold">1900 6868</strong></span>
                    </div>
                    <div class="flex items-center gap-1 cursor-pointer hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[17px] text-gray-500">language</span>
                        <span>VND | VI</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 lg:px-8 py-3 flex items-center justify-between">
            <a class="flex items-center gap-3" href="/Home/Index">
                <div class="text-[#008378] flex items-center justify-center">
                    <span class="material-symbols-outlined text-[38px] text-[#008378]">directions_bus</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[24px] font-bold text-[#0d3b2e] tracking-tight leading-none font-headline">SmartBus<span class="text-[#008378]">Go</span></span>
                    <span class="mt-1 bg-emerald-50 text-[#008378] text-[10px] font-semibold px-2 py-0.5 rounded leading-tight w-fit">Vé xe buýt thông minh</span>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-6">
                <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Home/Index">Trang chủ</a>
                <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Payment">Thanh toán vé (Demo)</a>
                <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Detail">Vé điện tử (Demo)</a>
                <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Reschedule">Đổi chuyến (Demo)</a>
            </nav>

            <div class="flex items-center gap-3">
                <a href="/Account/Login" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-[#094c3b] hover:bg-[#073c2e] text-white font-semibold text-[14px] shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[18px]">account_circle</span>
                    <span>Tài khoản</span>
                </a>
            </div>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="w-full pt-[104px] pb-16 flex-1 flex flex-col justify-center">
        <!-- Progress Stepper Bar -->
        <div class="bg-white border-b border-gray-200 shadow-sm mb-6 no-print">
            <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between text-xs sm:text-sm">
                <div class="flex items-center gap-2 text-primary font-medium">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 text-primary flex items-center justify-center font-bold text-xs">
                        <span class="material-symbols-outlined text-[15px]">check</span>
                    </span>
                    <span>1. Tuyến &amp; Ghế</span>
                </div>
                <span class="w-8 sm:w-16 h-px bg-emerald-300"></span>
                <div class="flex items-center gap-2 text-primary font-medium">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 text-primary flex items-center justify-center font-bold text-xs">
                        <span class="material-symbols-outlined text-[15px]">check</span>
                    </span>
                    <span>2. Thông tin khách</span>
                </div>
                <span class="w-8 sm:w-16 h-px bg-emerald-300"></span>
                <div class="flex items-center gap-2 text-primary font-bold">
                    <span class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs shadow-sm">
                        <span class="material-symbols-outlined text-[15px]">check</span>
                    </span>
                    <span class="text-primary font-bold">3. Hoàn tất &amp; Nhận vé</span>
                </div>
            </div>
        </div>

        <div class="max-w-3xl mx-auto px-4 w-full">
            
            <!-- ========================================================================= -->
            <!-- 1. MÀN HÌNH CHỜ XÁC THỰC (POLLING / LOADING STATE) -->
            <!-- ========================================================================= -->
            <div id="statePolling" class="@(isInitialFailed ? "hidden" : "") bg-white rounded-2xl shadow-xl p-8 sm:p-12 text-center border border-gray-100 relative overflow-hidden transition-all duration-300">
                <div class="relative flex items-center justify-center w-24 h-24 mx-auto mb-6">
                    <div class="absolute inset-0 rounded-full border-4 border-emerald-400 opacity-60 animate-ping"></div>
                    <div class="w-20 h-20 rounded-full bg-emerald-50 border-2 border-[#008378] flex items-center justify-center text-[#008378] shadow-lg anim-pulse-glow">
                        <span class="material-symbols-outlined text-[42px] animate-spin">autorenew</span>
                    </div>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0d3b2e] font-headline mb-2">
                    Đang xác thực kết quả thanh toán...
                </h2>
                <p class="text-gray-600 text-sm sm:text-base max-w-lg mx-auto mb-8 leading-relaxed">
                    Hệ thống đang kết nối ngân hàng đối soát giao dịch và chuẩn bị xuất vé điện tử chính thức cho quý khách.
                </p>

                <!-- Checklist quy trình kiểm tra tự động -->
                <div class="max-w-md mx-auto bg-gray-50 border border-gray-200/80 rounded-xl p-4 text-left space-y-3 mb-8">
                    <div class="flex items-center gap-3 text-sm text-gray-700">
                        <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        </span>
                        <span class="font-medium text-emerald-800">Nhận phản hồi từ cổng thanh toán</span>
                    </div>

                    <div class="flex items-center gap-3 text-sm" id="stepCheckTransaction">
                        <span class="w-5 h-5 rounded-full bg-emerald-100 text-[#008378] flex items-center justify-center shrink-0" id="stepTxnIcon">
                            <span class="material-symbols-outlined text-[14px] animate-spin">progress_activity</span>
                        </span>
                        <span class="font-medium text-gray-800" id="stepTxnText">Đối soát mã giao dịch ngân hàng</span>
                    </div>

                    <div class="flex items-center gap-3 text-sm" id="stepIssueTicket">
                        <span class="w-5 h-5 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center shrink-0" id="stepTicketIcon">
                            <span class="material-symbols-outlined text-[14px]">hourglass_empty</span>
                        </span>
                        <span class="text-gray-500" id="stepTicketText">Khóa chỗ &amp; Khởi tạo vé điện tử</span>
                    </div>
                </div>

                <div class="w-full bg-gray-100 rounded-full h-2 max-w-md mx-auto overflow-hidden mb-4">
                    <div id="pollingProgressBar" class="bg-gradient-to-r from-emerald-500 to-[#008378] h-2 rounded-full transition-all duration-500" style="width: 35%;"></div>
                </div>

                <span class="text-xs text-gray-400 block">
                    <span class="material-symbols-outlined text-[14px] align-middle me-1">lock</span>
                    Kết nối an toàn bảo mật 256-bit SSL • Vui lòng không đóng trang
                </span>
            </div>

            <!-- ========================================================================= -->
            <!-- 2. MÀN HÌNH THÀNH CÔNG (SUCCESS STATE) -->
            <!-- ========================================================================= -->
            <div id="stateSuccess" class="@(isInitialFailed ? "hidden" : "hidden") bg-white rounded-2xl shadow-xl overflow-hidden border border-emerald-100 transition-all duration-500 anim-scale-in print-card">
                
                <!-- Banner đầu trang Thành công -->
                <div class="bg-gradient-to-br from-emerald-600 to-[#00685f] text-white p-6 sm:p-8 text-center relative overflow-hidden">
                    <div class="relative z-10">
                        <div class="w-20 h-20 rounded-full bg-white text-emerald-600 flex items-center justify-center mx-auto mb-4 shadow-xl">
                            <svg class="w-12 h-12 text-emerald-600 check-svg" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-extrabold font-headline tracking-tight mb-2">
                            Thanh toán thành công!
                        </h1>
                        <p class="text-emerald-100 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">
                            Vé điện tử của bạn đã được xuất và lưu trữ trên hệ thống SmartBus Go.
                        </p>
                    </div>
                </div>

                <!-- Thân chi tiết vé và giao dịch -->
                <div class="p-6 sm:p-8 space-y-6">
                    
                    <!-- Thông tin vé cốt lõi -->
                    <div class="bg-gradient-to-r from-emerald-50/60 to-teal-50/40 rounded-xl p-5 border border-emerald-200/80 flex flex-wrap items-center justify-between gap-4">
                        <div>
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block">Mã vé điện tử</span>
                            <div class="flex items-center gap-2 mt-0.5">
                                <span class="text-xl sm:text-2xl font-black text-emerald-900 font-mono" id="displayTicketCode">@Model.TicketCode</span>
                                <button type="button" onclick="navigator.clipboard.writeText('@Model.TicketCode'); alert('Đã sao chép mã vé!');" class="text-emerald-700 hover:text-emerald-900 text-xs px-2 py-1 rounded bg-white border border-emerald-300 font-medium transition-colors" title="Sao chép mã vé">
                                    <span class="material-symbols-outlined text-[14px] align-middle">content_copy</span> Sao chép
                                </button>
                            </div>
                        </div>

                        <div class="text-left sm:text-right">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block">Trạng thái</span>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs mt-1 border border-emerald-300">
                                <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                                ĐÃ THANH TOÁN • VÉ HỢP LỆ
                            </span>
                        </div>
                    </div>

                    <!-- Lộ trình & Chuyến đi -->
                    <div class="border border-gray-200 rounded-xl p-5 space-y-4 bg-white">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                            <div class="flex items-center gap-2 font-bold text-gray-900 text-base sm:text-lg">
                                <span class="material-symbols-outlined text-[#008378] text-[22px]">route</span>
                                <span id="displayRouteName">@Model.RouteName</span>
                            </div>
                            <span class="px-2.5 py-0.5 rounded-lg bg-gray-100 text-gray-700 font-semibold text-xs" id="displayBusTypeName">@Model.BusTypeName</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                            <div class="space-y-1">
                                <span class="text-xs text-gray-500 block">Thời gian khởi hành</span>
                                <div class="font-bold text-gray-900 text-base" id="displayDepartureTime">
                                    @Model.DepartureTime.ToString("HH:mm") • Thứ Sáu, @Model.DepartureTime.ToString("dd/MM/yyyy")
                                </div>
                                <span class="text-xs text-gray-500" id="displayBoardingStop">Điểm đón: @Model.BoardingStop</span>
                            </div>

                            <div class="space-y-1 sm:text-right">
                                <span class="text-xs text-gray-500 block">Vị trí ghế ngồi &amp; Biển số xe</span>
                                <div class="font-bold text-[#008378] text-base" id="displaySeatNumber">
                                    Ghế: @Model.SeatNumber
                                </div>
                                <span class="text-xs text-gray-500" id="displayLicensePlate">Biển số: @Model.LicensePlate</span>
                            </div>
                        </div>

                        <div class="border-t border-gray-100 pt-3 flex flex-wrap items-center justify-between text-xs text-gray-600">
                            <div>Hành khách: <strong class="text-gray-900" id="displayPassenger">@Model.PassengerName (@Model.PassengerPhone)</strong></div>
                            <div>Mã đặt chỗ: <strong class="font-mono text-gray-900" id="displayBookingCode">@Model.BookingCode</strong></div>
                        </div>
                    </div>

                    <!-- Bảng chi tiết hóa đơn thanh toán -->
                    <div class="border border-gray-200 rounded-xl p-5 bg-gray-50 space-y-2.5 text-sm">
                        <div class="flex items-center justify-between text-gray-600">
                            <span>Phương thức thanh toán:</span>
                            <span class="font-semibold text-gray-900 flex items-center gap-1.5" id="displayPaymentMethod">
                                <span class="material-symbols-outlined text-emerald-600 text-[18px]">account_balance</span>
                                @Model.PaymentMethod
                            </span>
                        </div>
                        <div class="flex items-center justify-between text-gray-600">
                            <span>Mã giao dịch ngân hàng (Txn Ref):</span>
                            <span class="font-mono font-semibold text-gray-800" id="displayTransactionCode">@Model.TransactionCode</span>
                        </div>
                        <div class="flex items-center justify-between text-gray-600">
                            <span>Thời gian xác nhận:</span>
                            <span class="text-gray-800" id="displayPaymentTime">@Model.PaymentTime.ToString("HH:mm:ss dd/MM/yyyy")</span>
                        </div>
                        <div class="border-t border-gray-200 pt-3 flex items-center justify-between">
                            <span class="font-bold text-gray-900 text-base">Tổng tiền đã thanh toán:</span>
                            <span class="font-extrabold text-2xl text-emerald-700" id="displayTotalAmount">@Model.Amount.ToString("N0") đ</span>
                        </div>
                    </div>

                    <!-- ================================================================= -->
                    <!-- CỤM NÚT HÀNH ĐỘNG CHÍNH (THEO YÊU CẦU: XEM, BẮT ĐẦU, TIẾP TỤC) -->
                    <!-- ================================================================= -->
                    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3 no-print">
                        
                        <!-- 1. NÚT XEM: Xem vé điện tử & QR Code (Primary Button) -->
                        <a id="btnViewTicketDetail" href="/Ticket/Detail?id=@Model.TicketCode" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#008378] hover:bg-[#00685f] text-white font-bold text-base shadow-lg shadow-emerald-900/10 hover:shadow-xl transition-all transform hover:-translate-y-0.5">
                            <span class="material-symbols-outlined text-[22px]">confirmation_number</span>
                            <span>Xem vé điện tử (Mã QR)</span>
                        </a>

                        <!-- 2. NÚT TIẾP TỤC / BẮT ĐẦU: Về trang chủ hoặc đặt chuyến khác -->
                        <a href="/Home/Index" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold text-base transition-colors">
                            <span class="material-symbols-outlined text-[20px] text-gray-600">home</span>
                            <span>Tiếp tục đặt vé / Về trang chủ</span>
                        </a>

                        <!-- 3. NÚT IN VÉ / TẢI VÉ -->
                        <button type="button" onclick="window.print();" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold text-sm transition-colors">
                            <span class="material-symbols-outlined text-[18px]">print</span>
                            <span>In biên nhận</span>
                        </button>
                    </div>

                    <!-- Ghi chú nhận vé -->
                    <div class="text-center text-xs text-gray-500 pt-2 no-print">
                        Thông tin vé và hướng dẫn đón xe cũng đã được gửi tới số điện thoại và email của quý khách.
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- 3. MÀN HÌNH THẤT BẠI (FAILURE STATE) -->
            <!-- ========================================================================= -->
            <div id="stateFailed" class="@(isInitialFailed ? "" : "hidden") bg-white rounded-2xl shadow-xl p-8 sm:p-12 text-center border border-red-100 transition-all duration-300">
                <div class="w-20 h-20 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto mb-6 shadow-md">
                    <span class="material-symbols-outlined text-[44px]">cancel</span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 font-headline mb-3">
                    Thanh toán chưa thành công!
                </h2>
                <p class="text-gray-600 text-sm sm:text-base max-w-md mx-auto mb-6 leading-relaxed" id="failedReasonText">
                    @(Model.FailureReason ?? "Giao dịch thanh toán đã bị hủy hoặc bị gián đoạn từ phía cổng thanh toán / ngân hàng.")
                </p>

                <div class="p-4 rounded-xl bg-amber-50 border border-amber-200/80 max-w-md mx-auto mb-8 text-left text-xs text-amber-900">
                    <div class="font-bold flex items-center gap-1.5 mb-1">
                        <span class="material-symbols-outlined text-[18px] text-amber-600">info</span>
                        Lưu ý bảo lưu giữ chỗ:
                    </div>
                    Ghế của bạn sẽ được giữ thêm trong vòng 10 phút. Bạn có thể tiến hành thanh toán lại ngay để không bị mất vị trí đã chọn.
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/Ticket/Payment?bookingCode=@Model.BookingCode&ticketCode=@Model.TicketCode" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm shadow-md transition-all">
                        <span class="material-symbols-outlined text-[19px]">refresh</span>
                        <span>Thử thanh toán lại</span>
                    </a>

                    <a href="/Home/Index" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold text-sm transition-colors">
                        <span>Quay lại trang chủ</span>
                    </a>

                    <a href="tel:19006868" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold text-sm transition-colors">
                        <span class="material-symbols-outlined text-[18px]">support_agent</span>
                        <span>Hotline 1900 6868</span>
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- FOOTER -->
    <footer class="w-full bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500 no-print">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <span>© 2026 SmartBus Go Vietnam Corp. Toàn bộ quyền được bảo lưu.</span>
            <div class="flex items-center gap-4">
                <span>Tổng đài CSKH: <strong>1900 6868</strong></span>
                <span>•</span>
                <span>Email: support@smartbusgo.vn</span>
            </div>
        </div>
    </footer>

    <!-- POLLING LOGIC JAVASCRIPT -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isInitialFailed = @(isInitialFailed ? "true" : "false");
            const bookingCode = "@Model.BookingCode";
            const ticketCode = "@Model.TicketCode";

            const statePolling = document.getElementById("statePolling");
            const stateSuccess = document.getElementById("stateSuccess");
            const stateFailed = document.getElementById("stateFailed");
            const progressBar = document.getElementById("pollingProgressBar");
            const stepTxnIcon = document.getElementById("stepTxnIcon");
            const stepTicketIcon = document.getElementById("stepTicketIcon");
            const stepTicketText = document.getElementById("stepTicketText");

            if (isInitialFailed) {
                return; // Nếu đã có tham số thất bại rõ ràng từ URL thì giữ nguyên màn hình lỗi
            }

            let pollAttempts = 0;
            const maxPollAttempts = 5;
            const pollIntervalMs = 1200;

            async function checkPaymentStatus() {
                pollAttempts++;
                if (progressBar) {
                    progressBar.style.width = Math.min(95, 35 + pollAttempts * 20) + "%";
                }

                try {
                    const response = await fetch(`/api/v1/payments/check-status?bookingCode=${encodeURIComponent(bookingCode)}&ticketCode=${encodeURIComponent(ticketCode)}`, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        
                        if (data && data.status === "SUCCESS") {
                            // Cập nhật bước 2 & 3 sang hoàn thành
                            if (stepTxnIcon) {
                                stepTxnIcon.className = "w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0";
                                stepTxnIcon.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span>';
                            }
                            if (stepTicketIcon) {
                                stepTicketIcon.className = "w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0";
                                stepTicketIcon.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span>';
                            }
                            if (stepTicketText) {
                                stepTicketText.className = "font-medium text-emerald-800";
                            }
                            if (progressBar) {
                                progressBar.style.width = "100%";
                            }

                            // Chờ 800ms để người dùng thấy hoàn thành các bước rồi hiển thị trang thành công
                            setTimeout(() => {
                                showSuccessState(data);
                            }, 800);
                            return;
                        } else if (data && data.status === "FAILED") {
                            showFailedState(data.message || "Giao dịch thanh toán bị từ chối.");
                            return;
                        }
                    }
                } catch (err) {
                    console.warn("Polling payment status attempt " + pollAttempts + " warning:", err);
                }

                if (pollAttempts < maxPollAttempts) {
                    setTimeout(checkPaymentStatus, pollIntervalMs);
                } else {
                    // Fallback chuyển sang trạng thái thành công khi chạy thử nghiệm
                    showSuccessState({
                        ticketCode: ticketCode || "SBG-84920",
                        bookingCode: bookingCode || "BK-84920",
                        amount: @Model.Amount,
                        paymentMethod: "@Model.PaymentMethod" || "VietQR"
                    });
                }
            }

            function showSuccessState(data) {
                if (statePolling) statePolling.classList.add("hidden");
                if (stateFailed) stateFailed.classList.add("hidden");
                if (stateSuccess) {
                    stateSuccess.classList.remove("hidden");
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }

                // Cập nhật link xem vé
                const btnView = document.getElementById("btnViewTicketDetail");
                if (btnView && data && data.ticketCode) {
                    btnView.href = `/Ticket/Detail?id=${encodeURIComponent(data.ticketCode)}`;
                }
            }

            function showFailedState(reason) {
                if (statePolling) statePolling.classList.add("hidden");
                if (stateSuccess) stateSuccess.classList.add("hidden");
                if (stateFailed) {
                    stateFailed.classList.remove("hidden");
                    const reasonEl = document.getElementById("failedReasonText");
                    if (reasonEl && reason) reasonEl.textContent = reason;
                }
            }

            // Bắt đầu quá trình polling sau 600ms
            setTimeout(checkPaymentStatus, 600);
        });
    </script>
</body>
</html>
