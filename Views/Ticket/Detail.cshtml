@model WebApplication1.Models.ViewModels.TicketDetailViewModel
@{
    ViewData["Title"] = "Chi tiết Vé điện tử & Mã QR";
}

<div class="container sbg-ticket-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <div class="d-flex gap-2">
            <a asp-controller="Ticket" asp-action="Reschedule" asp-route-ticketCode="@Model.TicketCode" class="btn btn-warning btn-sm rounded-pill fw-bold shadow-sm text-dark">
                <i class="bi bi-arrow-repeat"></i> Đổi chuyến
            </a>
            <a asp-controller="Ticket" asp-action="Cancel" asp-route-id="@Model.TicketCode" class="btn btn-outline-danger btn-sm rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-x-circle"></i> Hủy vé
            </a>
            <button id="btnDownloadTicket" class="btn btn-outline-success btn-sm rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-download"></i> Lưu ảnh vé (Offline)
            </button>
            <button id="btnPrintTicket" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-printer"></i> In vé
            </button>
        </div>
    </div>

    <div class="sbg-wakelock-banner shadow-sm mb-3">
        <i class="bi bi-brightness-high-fill fs-5 text-warning"></i>
        <div class="flex-grow-1">
            <span id="wakeLockStatus" class="fw-semibold">💡 Màn hình đã tự động giữ sáng tối đa để máy quét QR nhận diện nhanh nhất.</span>
            <span class="d-none d-md-inline text-muted small ms-1">(Màn hình sẽ không tự khóa khi bạn đang mở trang này)</span>
        </div>
    </div>

    <div class="sbg-ticket-card" id="printableTicket">
        <div class="sbg-notch-top"></div>
        <div class="sbg-notch-bottom"></div>

        @if (Model.Status == "USED")
        {
            <div class="sbg-ticket-watermark" style="color: rgba(100, 116, 139, 0.25); border-color: rgba(100, 116, 139, 0.3);">
                ĐÃ SOÁT VÉ
            </div>
        }
        else if (Model.Status == "EXPIRED")
        {
            <div class="sbg-ticket-watermark">
                HẾT HẠN
            </div>
        }

        <div class="sbg-ticket-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-bus-front-fill fs-2"></i>
                <div>
                    <h5 class="mb-0 fw-bold">SmartBus Go - Vé Xe Buýt Điện Tử</h5>
                    <span class="small opacity-75">Mã đặt chỗ: <strong>@Model.BookingCode</strong></span>
                </div>
            </div>
            <div class="text-end">
                <div class="sbg-ticket-route-badge">
                    <i class="bi bi-geo-alt-fill text-warning"></i> Tuyến: @Model.RouteCode
                </div>
                <div class="small opacity-75 mt-1">Ngày đặt: @Model.BookingTime.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="sbg-ticket-body">
            <div class="sbg-ticket-main">
                <h6 class="text-muted text-uppercase fw-bold small mb-2">Hành trình chuyến đi</h6>
                <h4 class="fw-bold text-dark mb-3">@Model.RouteName</h4>

                <div class="sbg-route-flow">
                    <div class="sbg-station-point text-start">
                        <span class="text-muted small d-block">ĐIỂM ĐÓN</span>
                        <div class="sbg-station-time">@Model.DepartureTime.ToString(@"hh\:mm")</div>
                        <div class="sbg-station-city">@Model.BoardingStopName</div>
                        <div class="text-muted small">@Model.BoardingStopAddress</div>
                    </div>

                    <div class="sbg-route-arrow px-3">
                        <span>~@Model.EstimatedDuration phút</span>
                        <div class="sbg-route-arrow-line"></div>
                        <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                    </div>

                    <div class="sbg-station-point text-end">
                        <span class="text-muted small d-block">ĐIỂM TRẢ</span>
                        <div class="sbg-station-time">@(Model.ArrivalTime.HasValue ? Model.ArrivalTime.Value.ToString(@"hh\:mm") : "--:--")</div>
                        <div class="sbg-station-city">@Model.DropOffStopName</div>
                        <div class="text-muted small">@Model.DropOffStopAddress</div>
                    </div>
                </div>

                <div class="sbg-info-grid">
                    <div class="sbg-info-item">
                        <label>Ngày khởi hành</label>
                        <div class="value text-success"><i class="bi bi-calendar2-check me-1"></i>@Model.TripDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="sbg-info-item">
                        <label>Số ghế</label>
                        <div class="value text-primary fs-5 fw-bold"><i class="bi bi-person-workspace me-1"></i>@Model.SeatNumber</div>
                    </div>
                    <div class="sbg-info-item">
                        <label>Loại xe & Biển số</label>
                        <div class="value">@Model.BusTypeName (@Model.LicensePlate)</div>
                    </div>
                    <div class="sbg-info-item">
                        <label>Giá vé</label>
                        <div class="value text-danger">@Model.Price.ToString("N0") VNĐ <span class="badge bg-success small fw-normal ms-1">Đã thanh toán</span></div>
                    </div>
                    <div class="sbg-info-item">
                        <label>Hành khách</label>
                        <div class="value">@Model.PassengerName</div>
                    </div>
                    <div class="sbg-info-item">
                        <label>Số điện thoại</label>
                        <div class="value">@Model.PassengerPhone</div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-muted d-block">Bác tài phụ trách:</span>
                        <span class="fw-semibold text-dark">@Model.DriverName (@Model.DriverPhone)</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-xs" onclick="openBusTrackingModal()">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Xem vị trí xe trực tiếp
                    </button>
                </div>

                <div class="mt-3 p-3 bg-light rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="small fw-bold text-dark d-block"><i class="bi bi-arrow-repeat text-success"></i> Bạn có việc đột xuất và muốn đổi chuyến xe khác?</span>
                        <span class="small text-muted">Hỗ trợ đổi ngày, chuyến xe và chọn lại ghế hoàn toàn miễn phí trước 24 giờ.</span>
                    </div>
                    <a asp-controller="Ticket" asp-action="Reschedule" asp-route-ticketCode="@Model.TicketCode" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                        Đổi chuyến xe ngay &rarr;
                    </a>
                </div>
            </div>

            <!-- Modal Theo Dõi Vị Trí Xe Buýt Thời Gian Thực (Leaflet GPS Realtime Tracking) -->
            <div class="modal fade" id="busTrackingModal" tabindex="-1" aria-labelledby="busTrackingModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                        <div class="modal-header bg-gradient text-white" style="background: linear-gradient(135deg, #008378 0%, #006057 100%);">
                            <div>
                                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="busTrackingModalLabel">
                                    <i class="bi bi-geo-alt-fill text-warning"></i> Vị trí xe buýt thời gian thực
                                </h5>
                                <div class="small opacity-75 mt-1">Xe biển số: <strong class="text-warning">@Model.LicensePlate</strong> &bull; Tuyến: @Model.BoardingStopName &rarr; @Model.DropOffStopName</div>
                            </div>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-0 position-relative">
                            <!-- Status bar above map -->
                            <div class="bg-light px-3 py-2 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                        <span class="spinner-grow spinner-grow-sm text-success" style="width: 8px; height: 8px;" role="status"></span>
                                        GPS Trực tuyến
                                    </span>
                                    <span>Tốc độ: <strong id="busSpeed" class="text-primary fw-bold">48 km/h</strong></span>
                                    <span>Cách trạm đón: <strong id="busDistance" class="text-danger fw-bold">1.8 km (~5 phút)</strong></span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill" onclick="refreshBusPosition()">
                                    <i class="bi bi-arrow-clockwise"></i> Cập nhật
                                </button>
                            </div>
                            <!-- Leaflet map container -->
                            <div id="busTrackingMap" style="height: 400px; width: 100%; z-index: 1;"></div>
                        </div>
                        <div class="modal-footer bg-light py-2 px-3 justify-content-between">
                            <div class="small text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge text-primary"></i> Tài xế: <strong>@Model.DriverName</strong> (@Model.DriverPhone)
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng bản đồ</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="sbg-ticket-stub">
                <div class="mb-3 text-center w-100">
                    @if (Model.Status == "ACTIVE" || Model.Status == "CONFIRMED" || Model.Status == "PAID" || Model.Status == "ISSUED")
                    {
                        <div class="d-flex flex-column align-items-center gap-1">
                            <span class="sbg-ticket-status-badge sbg-status-active">
                                <i class="bi bi-check-circle-fill"></i> Vé Hợp Lệ
                            </span>
                            <span class="badge rounded-pill bg-warning text-dark border border-warning px-2.5 py-1 text-xs fw-bold mt-1 shadow-2xs">
                                <i class="bi bi-qr-code-scan me-1"></i> Mã QR dùng 1 lần duy nhất
                            </span>
                            <span class="text-success small fw-semibold" style="font-size: 0.76rem;">
                                <i class="bi bi-check2-circle me-1"></i> Sẵn sàng quét • Còn 1 lượt sử dụng
                            </span>
                        </div>
                    }
                    else if (Model.Status == "USED")
                    {
                        <div class="d-flex flex-column align-items-center gap-1">
                            <span class="sbg-ticket-status-badge sbg-status-used">
                                <i class="bi bi-patch-check-fill"></i> Đã Soát Vé • Hết Lượt
                            </span>
                            <span class="badge rounded-pill bg-secondary text-white px-2.5 py-1 text-xs fw-bold mt-1 shadow-2xs">
                                <i class="bi bi-lock-fill me-1"></i> Mã QR đã bị vô hiệu hóa
                            </span>
                            <span class="text-danger small fw-semibold" style="font-size: 0.76rem;">
                                <i class="bi bi-slash-circle-fill me-1"></i> 0 lượt quét còn lại (Đã sử dụng)
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center gap-1">
                            <span class="sbg-ticket-status-badge sbg-status-expired">
                                <i class="bi bi-exclamation-triangle-fill"></i> @(Model.Status == "CANCELLED" ? "Vé Đã Hủy" : "Vé Đã Hết Hạn")
                            </span>
                            <span class="badge rounded-pill bg-danger text-white px-2.5 py-1 text-xs fw-bold mt-1 shadow-2xs">
                                <i class="bi bi-x-octagon-fill me-1"></i> Không thể sử dụng
                            </span>
                        </div>
                    }
                </div>

                @if (Model.Status == "USED")
                {
                    <!-- QR Box for USED Ticket: visually disabled with prominent lock stamp -->
                    <div class="sbg-qr-wrapper position-relative text-center mx-auto my-1">
                        <div class="sbg-qr-box sbg-qr-box-used d-flex align-items-center justify-content-center p-2 rounded-3 shadow-xs border mx-auto position-relative overflow-hidden" 
                             id="ticketQrCanvas" 
                             data-status="USED"
                             style="width: 195px; height: 195px; background-color: #f1f5f9; border: 2px dashed #94a3b8 !important;">
                            <img id="ticketQrImage" 
                                 src="@(!string.IsNullOrWhiteSpace(Model.QrCodeBase64) ? Model.QrCodeBase64 : $"https://api.qrserver.com/v1/create-qr-code/?size=170x170&data={Uri.EscapeDataString(Model.TicketCode)}&color=94a3b8")" 
                                 alt="Mã QR Đã Sử Dụng @Model.TicketCode" 
                                 class="img-fluid rounded" 
                                 style="width: 170px; height: 170px; object-fit: contain; filter: grayscale(100%); opacity: 0.25;" />
                            
                            <!-- Overlay stamp -->
                            <div class="position-absolute top-50 start-50 translate-middle w-100 p-2 text-center" style="transform: translate(-50%, -50%) rotate(-10deg); z-index: 5;">
                                <div class="px-2 py-2 rounded-2 text-white shadow-sm" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); border: 2px solid #ffffff;">
                                    <i class="bi bi-lock-fill fs-5 d-block mb-1"></i>
                                    <div class="fw-black text-uppercase tracking-wider" style="font-size: 11px; font-weight: 800; letter-spacing: 0.5px;">MÃ QR ĐÃ SỬ DỤNG</div>
                                    <div style="font-size: 9.5px; font-weight: 600; opacity: 0.95;">(Hết hiệu lực • Đã lên xe)</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-1 small text-danger fw-semibold">
                            <i class="bi bi-shield-x me-1"></i> Mã QR đã đóng sau 1 lần quét
                        </div>
                    </div>
                }
                else if (Model.Status == "EXPIRED" || Model.Status == "CANCELLED")
                {
                    <!-- QR Box for EXPIRED/CANCELLED Ticket -->
                    <div class="sbg-qr-wrapper position-relative text-center mx-auto my-1">
                        <div class="sbg-qr-box d-flex align-items-center justify-content-center p-2 rounded-3 shadow-xs border mx-auto position-relative overflow-hidden" 
                             id="ticketQrCanvas" 
                             data-status="@Model.Status"
                             style="width: 195px; height: 195px; background-color: #fef2f2; border: 2px dashed #f87171 !important;">
                            <img id="ticketQrImage" 
                                 src="@(!string.IsNullOrWhiteSpace(Model.QrCodeBase64) ? Model.QrCodeBase64 : $"https://api.qrserver.com/v1/create-qr-code/?size=170x170&data={Uri.EscapeDataString(Model.TicketCode)}&color=f87171")" 
                                 alt="Mã QR Hết Hạn @Model.TicketCode" 
                                 class="img-fluid rounded" 
                                 style="width: 170px; height: 170px; object-fit: contain; filter: grayscale(100%); opacity: 0.25;" />
                            
                            <!-- Overlay stamp -->
                            <div class="position-absolute top-50 start-50 translate-middle w-100 p-2 text-center" style="transform: translate(-50%, -50%) rotate(-10deg); z-index: 5;">
                                <div class="px-2 py-2 rounded-2 text-white shadow-sm" style="background: linear-gradient(135deg, #64748b 0%, #475569 100%); border: 2px solid #ffffff;">
                                    <i class="bi bi-x-circle-fill fs-5 d-block mb-1"></i>
                                    <div class="fw-black text-uppercase tracking-wider" style="font-size: 11px; font-weight: 800;">MÃ QR HẾT HIỆU LỰC</div>
                                    <div style="font-size: 9.5px; font-weight: 600; opacity: 0.95;">(Vé đã hủy hoặc quá hạn)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- QR Box for ACTIVE Ticket -->
                    <div class="sbg-qr-wrapper position-relative text-center mx-auto my-1">
                        <div class="sbg-qr-box sbg-qr-box-active d-flex align-items-center justify-content-center p-2 bg-white rounded-3 shadow-sm border mx-auto position-relative overflow-hidden" 
                             id="ticketQrCanvas" 
                             data-status="ACTIVE"
                             style="width: 195px; height: 195px; background-color: #ffffff; border: 2px solid #10b981;">
                            <img id="ticketQrImage" 
                                 src="@(!string.IsNullOrWhiteSpace(Model.QrCodeBase64) ? Model.QrCodeBase64 : $"https://api.qrserver.com/v1/create-qr-code/?size=170x170&data={Uri.EscapeDataString(Model.TicketCode)}&color=0A4D46")" 
                                 alt="Mã QR Vé Xe @Model.TicketCode" 
                                 class="img-fluid rounded" 
                                 style="width: 170px; height: 170px; object-fit: contain;"
                                 onerror="this.onerror=null; this.src='https://quickchart.io/qr?text=@Uri.EscapeDataString(Model.TicketCode)&size=170';" />
                            <div class="sbg-qr-scan-line"></div>
                        </div>
                        <div class="mt-1 d-flex align-items-center justify-content-center gap-1 small text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-shield-check text-success"></i> Mã hóa bảo mật • 1 lần quét duy nhất
                        </div>
                    </div>
                }

                <div class="text-center mt-2.5">
                    <span class="text-muted small d-block">Mã vé (Ticket Code):</span>
                    <div class="d-inline-flex align-items-center justify-content-center gap-2 mt-0.5">
                        <strong class="fs-5 text-dark font-monospace text-primary fw-bold" id="ticketCodeDisplay">@Model.TicketCode</strong>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-0" title="Sao chép mã vé" onclick="navigator.clipboard.writeText('@Model.TicketCode'); alert('Đã sao chép mã vé: @Model.TicketCode\nBạn có thể sang trang Bác tài để dán vào kiểm tra vé!');">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                </div>

                <!-- Single-use Ticket Policy Notice Box -->
                @if (Model.Status == "ACTIVE" || Model.Status == "CONFIRMED" || Model.Status == "PAID" || Model.Status == "ISSUED")
                {
                    <div class="mt-3 p-2.5 rounded-3 border text-start w-100" style="background-color: #fffbeb; border-color: #fde68a;">
                        <div class="d-flex align-items-center gap-1.5 mb-1">
                            <span class="badge bg-warning text-dark font-monospace fw-bold" style="font-size: 0.7rem;">CHÚ Ý</span>
                            <strong class="small text-amber-900" style="font-size: 0.8rem;">Quy định vé 1 lần (Single-use)</strong>
                        </div>
                        <ul class="mb-0 ps-3 text-muted" style="font-size: 0.74rem; line-height: 1.45;">
                            <li>Vé chỉ có <strong>1 lượt quét duy nhất</strong> khi lên xe buýt.</li>
                            <li>Khi bác tài soát vé thành công, mã QR sẽ <strong>tự động khóa</strong> để bảo vệ vé, chống chụp màn hình gian lận.</li>
                            <li>Vui lòng giữ bảo mật và chỉ xuất trình mã khi lên xe.</li>
                        </ul>
                    </div>
                }
                else if (Model.Status == "USED")
                {
                    <div class="mt-3 p-2.5 rounded-3 border text-start w-100" style="background-color: #f8fafc; border-color: #e2e8f0;">
                        <div class="d-flex align-items-center gap-1.5 mb-1">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <strong class="small text-dark" style="font-size: 0.8rem;">Lượt đi đã hoàn tất</strong>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 0.74rem; line-height: 1.45;">
                            Vé 1 lần này đã được bác tài soát vé lên xe thành công. Để bảo đảm an toàn, mã QR đã tự động vô hiệu hóa và không thể sử dụng để quét lại.
                        </p>
                    </div>
                }

                <input type="hidden" id="qrPayloadData" value="@Model.QrDataPayload" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/qrcode.min.js" asp-append-version="true"></script>
    <script>if (typeof QRCode === 'undefined') { document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"><\/script>'); }</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/js/ticket-qr.js" asp-append-version="true"></script>
    <script>
        let trackingMap = null;
        let busMarker = null;
        let routePolyline = null;
        let busInterval = null;

        function openBusTrackingModal() {
            const modalEl = document.getElementById('busTrackingModal');
            if (!modalEl) return;
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            modalEl.addEventListener('shown.bs.modal', function onShown() {
                modalEl.removeEventListener('shown.bs.modal', onShown);
                initTrackingMap();
            });
        }

        function initTrackingMap() {
            const mapContainer = document.getElementById('busTrackingMap');
            if (!mapContainer) return;

            if (trackingMap) {
                trackingMap.invalidateSize();
                return;
            }

            // Tọa độ giả lập tuyến xe buýt di chuyển
            const startPoint = [10.8142, 106.6661]; // Trạm đón
            const endPoint = [10.7420, 106.6205];   // Trạm trả
            const initialBusPos = [10.7950, 106.6500]; // Vị trí xe buýt hiện tại

            trackingMap = L.map('busTrackingMap').setView(initialBusPos, 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors | SmartBus Go GPS'
            }).addTo(trackingMap);

            // Marker trạm đón
            const startIcon = L.divIcon({
                html: '<div style="background:#008378;color:#fff;padding:4px 8px;border-radius:12px;font-size:11px;font-weight:bold;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.3);"><i class="bi bi-geo-alt-fill"></i> @Html.Raw(Model.BoardingStopName)</div>',
                className: 'custom-start-marker',
                iconAnchor: [20, 15]
            });
            L.marker(startPoint, { icon: startIcon }).addTo(trackingMap).bindPopup('<b>Điểm đón:</b> @Html.Raw(Model.BoardingStopName)');

            // Marker trạm trả
            const endIcon = L.divIcon({
                html: '<div style="background:#dc3545;color:#fff;padding:4px 8px;border-radius:12px;font-size:11px;font-weight:bold;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.3);"><i class="bi bi-flag-fill"></i> @Html.Raw(Model.DropOffStopName)</div>',
                className: 'custom-end-marker',
                iconAnchor: [20, 15]
            });
            L.marker(endPoint, { icon: endIcon }).addTo(trackingMap).bindPopup('<b>Điểm đến:</b> @Html.Raw(Model.DropOffStopName)');

            // Tuyến đường (Polyline)
            const routeCoords = [
                startPoint,
                [10.8080, 106.6600],
                [10.7950, 106.6500],
                [10.7820, 106.6400],
                [10.7650, 106.6300],
                endPoint
            ];
            routePolyline = L.polyline(routeCoords, { color: '#008378', weight: 5, opacity: 0.75, dashArray: '8, 8' }).addTo(trackingMap);
            trackingMap.fitBounds(routePolyline.getBounds(), { padding: [40, 40] });

            // Marker xe buýt với hiệu ứng nổi bật
            const busIcon = L.divIcon({
                html: '<div style="background:#ffc107;color:#111;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 0 12px rgba(255,193,7,0.9);border:2px solid #fff;font-size:18px;"><i class="bi bi-bus-front-fill"></i></div>',
                className: 'custom-bus-marker',
                iconAnchor: [19, 19]
            });
            busMarker = L.marker(initialBusPos, { icon: busIcon }).addTo(trackingMap)
                .bindPopup('<b>Xe buýt:</b> @Model.LicensePlate<br><b>Tài xế:</b> @Model.DriverName<br><b>Vận tốc:</b> 48 km/h')
                .openPopup();

            // Mô phỏng vị trí cập nhật thời gian thực
            let step = 0;
            if (busInterval) clearInterval(busInterval);
            busInterval = setInterval(() => {
                step = (step + 1) % routeCoords.length;
                const nextPos = routeCoords[step];
                busMarker.setLatLng(nextPos);
                const speed = 40 + Math.floor(Math.random() * 15);
                const busSpeedEl = document.getElementById('busSpeed');
                if (busSpeedEl) busSpeedEl.innerText = speed + ' km/h';
            }, 5000);
        }

        function refreshBusPosition() {
            const speed = 42 + Math.floor(Math.random() * 12);
            const distance = (1.2 + Math.random() * 0.8).toFixed(1);
            const minutes = Math.max(3, Math.round(distance * 2.5));

            const speedEl = document.getElementById('busSpeed');
            const distEl = document.getElementById('busDistance');
            if (speedEl) speedEl.innerText = speed + ' km/h';
            if (distEl) distEl.innerText = distance + ' km (~' + minutes + ' phút)';

            if (trackingMap) {
                trackingMap.invalidateSize();
            }
        }
    </script>
}
