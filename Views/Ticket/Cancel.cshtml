                    <div class="lg:col-span-8 flex flex-col gap-space-lg">
                        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-margin sm:p-space-xl relative overflow-hidden">
                            <div class="flex flex-wrap items-start justify-between gap-space-md pb-space-lg border-b border-surface-container">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                        <span class="material-symbols-outlined text-[28px]">directions_bus</span>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-headline-sm text-headline-sm text-on-surface">Phương Trang FUTA Bus Lines</span>
                                            <span class="px-2 py-0.5 rounded bg-surface-container-high text-secondary font-label-md text-body-sm">Limousine 34 phòng VIP</span>
                                        </div>
                                        <p class="font-body-sm text-body-sm text-secondary mt-0.5">Biển số: 29B-678.92 • Tuyến Bắc Nam cao tốc</p>
