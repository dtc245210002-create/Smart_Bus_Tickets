                                    <span class="font-body-sm text-body-sm text-secondary">Cổng trả khách số 02 Tôn Đức Thắng</span>
                                </div>
                            </div>

                            <!-- Hành khách & Giá -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-md pt-space-lg border-t border-surface-container bg-surface-container-low -mx-margin sm:-mx-space-xl -mb-margin sm:-mb-space-xl p-margin sm:p-space-lg rounded-b-xl">
                                <div>
                                    <span class="font-label-md text-body-sm text-secondary block">Hành khách</span>
                                    <span class="font-title-md text-title-md text-on-surface font-semibold">Nguyễn Văn An</span>
                                    <span class="font-body-sm text-body-sm text-secondary block">0988 123 456</span>
                                </div>
                                <div>
                                    <span class="font-label-md text-body-sm text-secondary block">Số lượng & Vị trí</span>
