<body class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary selection:text-on-primary">
    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
        <div class="border-b border-gray-100 text-[13px] text-gray-600 bg-white">
            <div class="max-w-7xl mx-auto px-4 lg:px-8 py-1.5 flex items-center justify-between">
                <div class="flex items-center gap-2 text-gray-600">
                    <span class="material-symbols-outlined text-primary text-[17px]">verified_user</span>
                    <span>Đặt vé thông minh 4.0</span>
                    <span class="text-gray-400 mx-1">•</span>
                    <span class="material-symbols-outlined text-gray-500 text-[17px]">directions_bus</span>
                    <span>Hơn 3,000+ chuyến xe toàn quốc</span>
                </div>
                <div class="flex items-center gap-6 text-gray-700">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-primary text-[17px]">call</span>
                        <span>Hotline: <strong class="text-gray-900 font-bold">1900 6868</strong></span>
                    </div>
                    <div class="flex items-center gap-1 cursor-pointer hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[17px] text-gray-500">language</span>
                        <span>VND | VI</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a class="flex items-center gap-3" href="/Home/Index">
                    <div class="text-[#008378] flex items-center justify-center">
                        <span class="material-symbols-outlined text-[38px] text-[#008378]">directions_bus</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[24px] font-bold text-[#0d3b2e] tracking-tight leading-none font-headline-sm">SmartBus<span class="text-[#008378]">Go</span></span>
                        <span class="mt-1 bg-emerald-50 text-[#008378] text-[10px] font-semibold px-2 py-0.5 rounded leading-tight w-fit">Vé xe buýt thông minh</span>
                    </div>
                </a>

                <nav class="flex items-center gap-6 ml-4">
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Home/Index">Trang chủ</a>
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Payment">Thanh toán vé (Demo)</a>
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Detail">Vé điện tử (Demo)</a>
                    <a class="font-medium text-[15px] text-gray-800 hover:text-primary transition-colors" href="/Ticket/Reschedule">Đổi chuyến (Demo)</a>
                </nav>
            </div>

            <div class="flex items-center gap-3">
                <a href="/Account/Login" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#094c3b] hover:bg-[#073c2e] text-white font-semibold text-[14px] shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[19px]">login</span>
                    <span>Đăng nhập / Đăng ký</span>
                </a>
                <a href="/Driver/Login" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold text-[14px] transition-colors">
                    <span class="material-symbols-outlined text-[19px] text-gray-600">badge</span>
                    <span>Bác tài</span>
                </a>
            </div>
        </div>
    </header>

    <main class="w-full pt-[104px] bg-[#f4f7f6] min-h-screen pb-16">
        <div class="flex flex-col w-full relative">
            <!-- TRANG NỀN: CHI TIẾT VÉ ĐIỆN TỬ -->
            <div class="max-w-7xl mx-auto px-margin sm:px-gutter-lg py-margin w-full">
