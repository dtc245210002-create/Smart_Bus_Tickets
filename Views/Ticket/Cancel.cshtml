                                <div class="flex items-center justify-between py-1">
                                    <span class="text-secondary flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[18px]">wifi</span> Wifi 5G
                                    </span>
                                    <span class="font-semibold text-tertiary">Miễn phí</span>
                                </div>
                                <div class="flex items-center justify-between py-1">
                                    <span class="text-secondary flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[18px]">water_drop</span> Nước & khăn lạnh
                                    </span>
                                    <span class="font-semibold text-tertiary">2 chai/khách</span>
