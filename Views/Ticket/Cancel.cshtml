                                        <span class="font-body-sm text-label-md text-secondary">Phí hủy 30%</span>
                                    </div>
                                </div>

                                <div class="p-space-sm rounded-xl bg-surface-container-lowest/50 opacity-60 flex flex-col justify-between">
                                    <div>
                                        <span class="font-label-lg text-label-lg text-secondary font-semibold block">Dưới 12 giờ</span>
                                        <span class="font-body-sm text-body-sm text-secondary">Quá hạn hủy vé</span>
                                    </div>
                                    <div class="mt-space-sm pt-space-xs border-t border-surface-container">
