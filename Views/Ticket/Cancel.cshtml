                                    <div class="w-full flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 rounded-full bg-primary ring-4 ring-primary/20"></span>
                                        <div class="flex-1 h-0.5 bg-surface-variant relative">
                                            <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-surface-container-lowest px-1.5 text-primary">
                                                <span class="material-symbols-outlined text-[18px]">navigation</span>
                                            </div>
                                        </div>
                                        <span class="w-2.5 h-2.5 rounded-full bg-tertiary ring-4 ring-tertiary/20"></span>
                                    </div>
