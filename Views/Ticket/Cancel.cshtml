                                    <div class="absolute -top-2.5 right-3 bg-primary text-on-primary font-label-md text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">
                                        Đang áp dụng
                                    </div>
                                    <div>
                                        <span class="font-label-lg text-label-lg text-primary font-bold block">Trước 24 giờ</span>
                                        <span class="font-body-sm text-body-sm text-secondary">Hủy an toàn cao</span>
                                    </div>
                                    <div class="mt-space-sm pt-space-xs border-t border-surface-container">
                                        <span class="font-numeric-data text-body-lg text-on-surface font-bold block">Hoàn 90%</span>
                                        <span class="font-body-sm text-label-md text-secondary">Phí hủy 10%</span>
                                    </div>
                                </div>

                                <div class="p-space-sm rounded-xl bg-surface-container-lowest/70 opacity-80 flex flex-col justify-between">
                                    <div>
                                        <span class="font-label-lg text-label-lg text-on-surface font-semibold block">Từ 12h - 24 giờ</span>
                                        <span class="font-body-sm text-body-sm text-secondary">Sát giờ khởi hành</span>
                                    </div>
                                    <div class="mt-space-sm pt-space-xs border-t border-surface-container">
