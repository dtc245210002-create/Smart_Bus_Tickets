                        </button>
                        <button class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-error hover:bg-red-700 disabled:opacity-40 disabled:cursor-not-allowed text-on-primary font-label-lg text-label-lg font-bold shadow-md transition-all cursor-pointer" disabled id="submitCancelTicketBtn" type="button">
                            <span class="material-symbols-outlined text-[19px]">delete_forever</span>
                            <span>XÁC NHẬN HỦY VÉ & NHẬN HOÀN TIỀN</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Toast thông báo thành công -->
            <div class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none" id="toastSuccess">
                <div class="bg-surface-container-lowest border-l-4 border-primary rounded-xl shadow-2xl p-space-md flex items-center gap-space-sm max-w-md">
                    <div class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    </div>
                    <div>
                        <h4 class="font-title-md text-body-md text-on-surface font-bold">Yêu cầu hủy vé thành công!</h4>
                        <p class="font-body-sm text-body-sm text-secondary">Số tiền 477.000 đ đang được xử lý chuyển về tài khoản Techcombank của bạn.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="w-full bg-surface-container-lowest shadow-[0_-1px_8px_rgba(0,0,0,0.02)] mt-margin-lg">
        <div class="max-w-7xl mx-auto px-margin lg:px-margin-lg py-margin-lg">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-gutter-lg pb-margin">
                <div class="lg:col-span-2 flex flex-col gap-space-sm">
                    <div class="flex items-center gap-space-sm">
                        <span class="font-headline-sm text-headline-sm text-primary font-bold">SmartBus Go</span>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-sm mt-space-xs">Hệ thống kết nối tuyến xe liên tỉnh và xe buýt thông minh hàng đầu Việt Nam.</p>
                    <div class="flex items-center gap-space-sm mt-space-sm">
                        <span class="font-label-md text-label-md text-secondary">Tổng đài hỗ trợ 24/7:</span>
                        <span class="font-numeric-data text-numeric-data text-primary">1900 6868</span>
                    </div>
                </div>
            </div>
            <div class="pt-margin flex flex-col md:flex-row items-center justify-between gap-space-sm border-t border-gray-100">
                <span class="font-body-sm text-body-sm text-secondary">© 2026 SmartBus Go Vietnam Corp.</span>
                <div class="flex items-center gap-space-md">
                    <span class="font-label-md text-label-md text-secondary">Kết nối an toàn qua cổng</span>
                    <span class="font-numeric-data text-numeric-data text-on-surface-variant">NAPAS • VISA • VNPAY</span>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modalOverlay = document.getElementById('cancelModalOverlay');
            const openModalBtn = document.getElementById('openModalBtn');
            const closeModalCross = document.getElementById('closeModalCross');
            const cancelModalCloseBtn = document.getElementById('cancelModalCloseBtn');
            const confirmCheckbox = document.getElementById('confirmAgreeCheckbox');
            const submitCancelBtn = document.getElementById('submitCancelTicketBtn');
            const cancelForm = document.getElementById('cancelTicketForm');
            const toastSuccess = document.getElementById('toastSuccess');

            function openModal() {
                if (!modalOverlay) return;
                modalOverlay.classList.remove('hidden');
                modalOverlay.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                if (!modalOverlay) return;
                modalOverlay.classList.add('hidden');
                modalOverlay.classList.remove('flex');
                document.body.style.overflow = '';
            }

            if (openModalBtn) openModalBtn.addEventListener('click', openModal);
            if (closeModalCross) closeModalCross.addEventListener('click', closeModal);
            if (cancelModalCloseBtn) cancelModalCloseBtn.addEventListener('click', closeModal);

            if (confirmCheckbox && submitCancelBtn) {
                confirmCheckbox.addEventListener('change', function() {
                    submitCancelBtn.disabled = !this.checked;
                });
            }

            if (submitCancelBtn && cancelForm) {
                submitCancelBtn.addEventListener('click', function() {
                    if (!confirmCheckbox || !confirmCheckbox.checked) return;
                    
                    submitCancelBtn.disabled = true;
                    submitCancelBtn.innerHTML = '<span class="material-symbols-outlined text-[19px] animate-spin">progress_activity</span><span>Đang xử lý hủy vé...</span>';

                    if (toastSuccess) {
                        toastSuccess.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
                    }

                    setTimeout(function() {
                        cancelForm.submit();
                    }, 1000);
                });
            }

            if (modalOverlay) {
                modalOverlay.addEventListener('click', function(e) {
                    if (e.target === modalOverlay) {
                        closeModal();
                    }
                });
            }
        });
    </script>
</body>
</html>
