@model WebApplication1.Models.ViewModels.DriverDashboardViewModel
@{ViewData["Title"]="Bảng điều khiển bác tài";}
<div class="container py-4"><h2 class="fw-bold text-primary-teal">Xin chào, bác tài Trọng</h2><p class="text-muted">Chọn đúng chuyến và ngày chạy để soát vé. Các chuyến tương lai được mở để thử trong demo.</p><div class="row g-4"><div class="col-lg-7"><div class="card sbg-booking-card"><h5 class="fw-bold"><i class="bi bi-qr-code-scan me-2 text-success"></i>Soát vé hành khách</h5><form asp-action="CheckIn" method="post"><label class="form-label">Chuyến phụ trách</label><select class="form-select mb-3" id="driverTrip" name="tripId" required>
@foreach(var b in Model.Bookings.DistinctBy(b=>new{b.Trip.TripId,b.TravelDate})){<option value="@b.Trip.TripId" data-date="@b.TravelDate.ToString("yyyy-MM-dd")">@b.Trip.DeparturePoint → @b.Trip.ArrivalPoint • @b.TravelDate.ToString("dd/MM/yyyy")</option>}
</select><input type="hidden" name="date" id="driverDate"/><label for="ticketInput" class="form-label">Mã vé / nội dung QR</label><input type="text" name="ticket" id="ticketInput" class="form-control mb-3" placeholder="SBG-DEMO-001-A01" required/><div class="d-flex gap-2 flex-wrap"><button class="btn sbg-btn-primary">Kiểm tra & check-in</button><button type="button" id="startScanner" class="btn btn-outline-success"><i class="bi bi-camera"></i> Quét bằng camera</button></div><p id="scannerMessage" class="small text-muted mt-3 mb-0" aria-live="polite"></p><video id="scannerVideo" class="w-100 rounded-3 mt-3 d-none" playsinline muted></video><button type="button" id="stopScanner" class="btn btn-sm btn-outline-secondary d-none mt-2">Tắt camera</button></form></div>
<div class="card sbg-booking-card mt-4"><h5 class="fw-bold">Danh sách hành khách</h5><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Hành khách</th><th>Chuyến / ngày</th><th>Ghế</th><th>Mã vé</th></tr></thead><tbody>@foreach(var b in Model.Bookings){@foreach(var code in b.TicketCodes){<tr><td>@b.PassengerName</td><td>@b.Trip.TripId • @b.TravelDate.ToString("dd/MM")</td><td>@code.Split('-').Last()</td><td><button type="button" class="btn btn-sm btn-outline-success demo-ticket-fill" data-ticket="@code" data-trip="@b.Trip.TripId" data-date="@b.TravelDate.ToString("yyyy-MM-dd")">Dùng mã này</button><small class="d-block text-muted">@code</small></td></tr>}}</tbody></table></div></div></div><div class="col-lg-5"><div class="card sbg-booking-card"><h5 class="fw-bold">Báo cáo sự cố</h5><form asp-action="Incident" method="post"><label for="incidentMessage" class="form-label text-muted">Tắc đường, trễ chuyến hoặc sự cố phương tiện</label><textarea id="incidentMessage" name="message" class="form-control mb-3" rows="4" maxlength="500" required placeholder="VD: Chuyến 11 trễ 15 phút do ùn tắc..."></textarea><button class="btn sbg-btn-primary">Gửi báo cáo</button></form></div><div class="card sbg-booking-card mt-4"><h5 class="fw-bold">Sự cố đã gửi</h5>@if(Model.Incidents.Count==0){<p class="text-muted mb-0">Chưa có báo cáo sự cố.</p>}@foreach(var incident in Model.Incidents){<p class="border-bottom pb-2 small">@incident</p>}</div></div></div></div>
@section Scripts{<script src="~/js/driver-demo.js" asp-append-version="true"></script>}
