@model WebApplication1.Models.ViewModels.DriverDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển Bác tài - SmartBus Go";
}

<div class="container py-4">
    <!-- Header Thông tin Bác tài -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, var(--sbg-primary) 0%, #0d6057 100%);">
        <div class="card-body p-4 text-white">
            <div class="row align-items-center">
                <div class="col-md-8 d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white text-success d-flex align-items-center justify-content-center shadow" style="width: 68px; height: 68px; font-size: 2rem;">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="fw-bold mb-0 text-white">@Model.FullName</h3>
                            <span class="badge bg-warning text-dark px-2 py-1">Mã: TX-@Model.DriverId.ToString("D3")</span>
                            <span class="badge bg-success-subtle text-success px-2 py-1">@Model.Status</span>
                        </div>
                        <div class="text-white-50 small d-flex flex-wrap gap-3">
                            <span><i class="bi bi-card-text me-1"></i> Bằng lái: <strong>@Model.LicenseNo</strong></span>
                            <span><i class="bi bi-telephone me-1"></i> SĐT: <strong>@Model.Phone</strong></span>
                            <span><i class="bi bi-shield-check me-1"></i> Đội xe SmartBus Express</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
                    <button type="button" class="btn btn-warning rounded-pill px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#verifyTicketModal">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>Soát vé lên xe</span>
                    </button>
                    <form asp-controller="Driver" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold" title="Kết thúc ca làm việc">
                            <i class="bi bi-box-arrow-right"></i> Rời ca
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thống kê ca chạy -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary-subtle text-primary fs-3">
                    <i class="bi bi-bus-front"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng chuyến được giao</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TodayTripsCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info-subtle text-info fs-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Khách đã đặt vé</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalPassengersCount <span class="fs-6 fw-normal text-muted">vé</span></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3 border border-success-subtle">
                <div class="rounded-3 p-3 bg-success text-white fs-3 shadow-xs">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Khách đã lên xe</div>
                    <h3 class="fw-bold mb-0 text-success"><span id="dashCheckedInCount">@Model.TotalCheckedInCount</span> <span class="fs-6 fw-normal text-muted">khách</span></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning-subtle text-warning-emphasis fs-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <div class="text-muted small">Trạng thái vận hành</div>
                    <h5 class="fw-bold mb-0 text-success">Sẵn sàng xuất bến</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách các chuyến xe được phân công -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar2-check text-success"></i>
                    Lịch Phân Công Ca Chạy Của Bác Tài
                </h5>
                <div class="text-muted small">
                    Hôm nay: <strong class="text-success">@Model.CurrentDate.ToString("dd/MM/yyyy")</strong> &bull; Tổng @Model.AssignedTrips.Count ca chạy được phân bổ
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                <i class="bi bi-lightning-charge-fill me-1"></i> Cập nhật thời gian thực
            </span>
        </div>

        <!-- Bộ lọc nhanh ca chạy theo ngày -->
        <div class="bg-light p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex flex-wrap gap-2" id="tripFilterTabs">
                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold trip-filter-btn active" data-filter="all">
                    <i class="bi bi-grid-fill me-1"></i> Tất cả (@Model.AssignedTrips.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold trip-filter-btn" data-filter="today">
                    <i class="bi bi-clock-history me-1"></i> ⚡ Hôm nay (@Model.AssignedTrips.Count(t => t.IsToday))
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold trip-filter-btn" data-filter="upcoming">
                    <i class="bi bi-calendar-event me-1"></i> 📅 Ngày mai & Sắp tới (@Model.AssignedTrips.Count(t => t.IsTomorrow || (!t.IsToday && !t.IsPast)))
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold trip-filter-btn" data-filter="past">
                    <i class="bi bi-archive me-1"></i> 📜 Lịch sử ca chạy (@Model.AssignedTrips.Count(t => t.IsPast))
                </button>
            </div>
            <div class="small text-muted">
                <i class="bi bi-info-circle me-1"></i> Bấm "Soát vé xe này" để mở giao diện kiểm tra vé đúng xe & đúng chuyến
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.AssignedTrips.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tuyến đường</th>
                                <th>Ngày chạy</th>
                                <th>Giờ xuất phát</th>
                                <th>Xe buýt & Biển số</th>
                                <th>Số khách / Sức chứa</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="assignedTripsBody">
                            @foreach (var trip in Model.AssignedTrips)
                            {
                                var dateType = trip.IsToday ? "today" : (trip.IsTomorrow ? "tomorrow" : (trip.IsPast ? "past" : "future"));
                                var rowBg = trip.IsToday ? "table-success-subtle border-start border-4 border-success" : "";

                                <tr class="@rowBg" data-date-type="@dateType">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                            @trip.RouteName
                                            @if (trip.IsToday)
                                            {
                                                <span class="badge bg-success text-white px-2 py-0 small" style="font-size: 0.72rem;">CA HIỆN TẠI</span>
                                            }
                                        </div>
                                        <div class="text-muted small">@trip.StartPoint &rarr; @trip.EndPoint</div>
                                    </td>
                                    <td>
                                        @if (trip.IsToday)
                                        {
                                            <span class="badge bg-success text-white px-2 py-1 shadow-sm">
                                                <i class="bi bi-clock-history me-1"></i> Hôm nay (@trip.TripDate.ToString("dd/MM/yyyy"))
                                            </span>
                                        }
                                        else if (trip.IsTomorrow)
                                        {
                                            <span class="badge bg-info text-dark px-2 py-1">
                                                <i class="bi bi-calendar-event me-1"></i> Ngày mai (@trip.TripDate.ToString("dd/MM/yyyy"))
                                            </span>
                                        }
                                        else if (trip.IsPast)
                                        {
                                            <span class="text-muted">@trip.TripDate.ToString("dd/MM/yyyy")</span>
                                            <span class="badge bg-light text-secondary border ms-1">Đã qua</span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold text-primary">@trip.TripDate.ToString("dd/MM/yyyy")</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(trip.IsToday ? "bg-primary text-white" : "bg-light text-dark border") fs-6">
                                            <i class="bi bi-clock me-1"></i> @trip.DepartureTime.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@trip.LicensePlate</div>
                                        <div class="text-muted small">@trip.BusTypeName</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                                @{
                                                    int pct = trip.Capacity > 0 ? (trip.BookedSeats * 100 / trip.Capacity) : 0;
                                                }
                                                <div class="progress-bar bg-success" style="width: @pct%;"></div>
                                            </div>
                                            <span class="small fw-bold">@trip.BookedSeats/@trip.Capacity</span>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check2"></i> @trip.CheckedInCount đã lên xe
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (trip.IsToday)
                                        {
                                            <span class="badge bg-success text-white px-2 py-1">
                                                <i class="bi bi-broadcast me-1"></i> Đang vận hành
                                            </span>
                                        }
                                        else if (trip.IsPast)
                                        {
                                            <span class="badge bg-light text-secondary border px-2 py-1">Hoàn thành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Lên lịch</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm @(trip.IsToday ? "btn-success shadow-sm" : "btn-outline-success") rounded-pill px-3 fw-semibold" 
                                                onclick="openVerifyModalForTrip(@trip.TripId, '@(trip.SampleTickets.FirstOrDefault() ?? "")')">
                                            <i class="bi bi-upc-scan me-1"></i> Soát vé xe này
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-calendar-x fs-1 text-secondary mb-2 d-block"></i>
                    <h6>Hiện tại chưa có chuyến xe mới nào được phân công cho ca này.</h6>
                    <p class="small">Vui lòng liên hệ Trực ban điều hành để nhận điều động ca chạy.</p>
                </div>
            }
        </div>
    </div>

    <!-- BẢNG DANH SÁCH HÀNH KHÁCH ĐÃ SOÁT VÉ LÊN XE (THỜI GIAN THỰC) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-person-check-fill text-success fs-4"></i>
                Danh Sách Hành Khách Đã Soát Vé Lên Xe
            </h5>
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill border border-success-subtle">
                <i class="bi bi-database-check me-1"></i> Cập nhật thời gian thực từ Database
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="checkedInPassengersTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã vé</th>
                            <th>Hành khách</th>
                            <th>Số điện thoại</th>
                            <th>Số ghế</th>
                            <th>Tuyến đường</th>
                            <th>Biển số xe</th>
                            <th>Thời gian soát vé</th>
                            <th class="text-end pe-4">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="checkedInPassengersBody">
                        @if (Model.RecentCheckedInPassengers.Any())
                        {
                            @foreach (var p in Model.RecentCheckedInPassengers)
                            {
                                <tr>
                                    <td class="ps-4 font-monospace fw-bold text-primary">@p.TicketCode</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@p.PassengerName</div>
                                    </td>
                                    <td class="text-muted small">@p.PassengerPhone</td>
                                    <td><span class="badge bg-success fs-6">@p.SeatNumber</span></td>
                                    <td><span class="small fw-semibold text-dark">@p.RouteName</span></td>
                                    <td><span class="badge bg-light text-dark border">@p.LicensePlate</span></td>
                                    <td class="text-muted small">@p.CheckInTime.ToString("HH:mm:ss dd/MM")</td>
                                    <td class="text-end pe-4">
                                        <span class="badge bg-success-subtle text-success px-2 py-1 border border-success-subtle">
                                            <i class="bi bi-check-circle-fill me-1"></i> ĐÃ LÊN XE
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptyCheckedInRow">
                                <td colspan="8" class="text-center py-4 text-muted small">
                                    <i class="bi bi-inbox fs-3 text-secondary d-block mb-1"></i>
                                    Chưa có hành khách nào vừa soát vé trong ca này. Hãy bấm nút [Soát vé xe này] ở trên để tiến hành soát vé!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Soát Vé Hành Khách (Verify Ticket) -->
<div class="modal fade" id="verifyTicketModal" tabindex="-1" aria-labelledby="verifyTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="verifyTicketModalLabel">
                    <i class="bi bi-qr-code-scan text-success me-2"></i> Soát Vé Hành Khách
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Chọn Xe & Chuyến Xe Đang Soát Vé -->
                <div class="p-3 bg-light rounded-3 mb-3 border">
                    <label class="small text-muted fw-bold d-block mb-1">
                        <i class="bi bi-bus-front-fill text-success me-1"></i> Xe & Chuyến xe Bác tài đang soát vé:
                    </label>
                    <select id="modalTripSelect" class="form-select fw-semibold border-success text-dark">
                        @foreach (var t in Model.AssignedTrips)
                        {
                            <option value="@t.TripId">
                                Xe: @t.LicensePlate | Tuyến: @t.RouteName (Xuất phát @t.DepartureTime.ToString("HH:mm") ngày @t.TripDate.ToString("dd/MM/yyyy"))
                            </option>
                        }
                    </select>
                    <div class="small text-danger mt-1 fw-semibold">
                        <i class="bi bi-shield-exclamation me-1"></i> Chỉ vé đúng Xe và đúng Chuyến này mới hợp lệ. Vé của xe hoặc chuyến khác sẽ bị từ chối!
                    </div>
                </div>

                <p class="text-muted small mb-2">Nhập mã vé in trên vé điện tử hoặc quét mã QR từ điện thoại của hành khách:</p>

                <div class="input-group mb-2">
                    <span class="input-group-text bg-light"><i class="bi bi-ticket-perforated"></i></span>
                    <input type="text" id="ticketCodeInput" class="form-control font-monospace" placeholder="Nhập mã vé (vd: SBG-859214)..." />
                    <button class="btn btn-outline-secondary" type="button" id="btnPasteTicketCode" title="Dán mã vé từ bộ nhớ tạm" onclick="pasteTicketCode()">
                        <i class="bi bi-clipboard"></i> Dán mã
                    </button>
                    <button class="btn sbg-btn-primary fw-bold px-3" type="button" id="btnVerifyTicket" onclick="checkTicket()">
                        <i class="bi bi-search me-1"></i> Kiểm tra
                    </button>
                </div>
                
                <!-- Gợi ý mã vé mẫu trên xe để test nhanh -->
                <div id="quickSampleCodeContainer" class="d-flex align-items-center gap-2 mb-2" style="display: none;">
                    <span class="small text-muted"><i class="bi bi-magic me-1 text-warning"></i> Mã vé trên chuyến này:</span>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0 small font-monospace" id="btnQuickSampleCode" onclick="fillSampleCode(this.innerText)"></button>
                    <span class="text-muted small" style="font-size: 0.75rem;">(Bấm để điền & soát ngay)</span>
                </div>

                <div class="form-text small text-muted mb-3"><i class="bi bi-info-circle me-1"></i>Hệ thống tự động tra cứu dữ liệu thời gian thực từ Database SmartBusTicketing.</div>

                <!-- Vùng hiển thị kết quả kiểm tra vé -->
                <div id="verifyResultArea" style="display: none;" class="mt-3">
                    <div id="verifyAlertBox" class="alert p-3 rounded-4 mb-0 shadow-sm border">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i id="verifyIcon" class="fs-3"></i>
                            <h6 id="verifyTitle" class="fw-bold mb-0 fs-6"></h6>
                        </div>
                        <div id="verifyDetails" class="small mt-2 pt-2 border-top"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openVerifyModalForTrip(tripId, sampleCode) {
            const select = document.getElementById('modalTripSelect');
            if (select && tripId) {
                select.value = tripId.toString();
            }
            // Reset kết quả kiểm tra trước
            document.getElementById('verifyResultArea').style.display = 'none';
            document.getElementById('ticketCodeInput').value = '';
            
            const sampleBox = document.getElementById('quickSampleCodeContainer');
            const sampleBtn = document.getElementById('btnQuickSampleCode');
            if (sampleCode && sampleCode.trim() && sampleBox && sampleBtn) {
                sampleBtn.innerText = sampleCode.trim();
                sampleBox.style.display = 'flex';
            } else if (sampleBox) {
                sampleBox.style.display = 'none';
            }

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('verifyTicketModal'));
            modal.show();
            setTimeout(() => document.getElementById('ticketCodeInput')?.focus(), 400);
        }

        function fillSampleCode(code) {
            if (code && code.trim()) {
                document.getElementById('ticketCodeInput').value = code.trim();
                checkTicket();
            }
        }

        // Bộ lọc nhanh các ca chạy (Tất cả, Hôm nay, Ngày mai, Lịch sử)
        document.querySelectorAll('.trip-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.trip-filter-btn').forEach(b => {
                    b.classList.remove('active', 'btn-success', 'btn-primary', 'btn-secondary');
                    const f = b.dataset.filter;
                    b.classList.add(f === 'today' ? 'btn-outline-success' : (f === 'upcoming' ? 'btn-outline-primary' : (f === 'past' ? 'btn-outline-secondary' : 'btn-outline-success')));
                });

                this.classList.add('active');
                const filter = this.dataset.filter;
                if (filter === 'all' || filter === 'today') {
                    this.classList.remove('btn-outline-success');
                    this.classList.add('btn-success');
                } else if (filter === 'upcoming') {
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-primary');
                } else if (filter === 'past') {
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('btn-secondary');
                }

                document.querySelectorAll('#assignedTripsBody tr').forEach(row => {
                    const type = row.dataset.dateType;
                    if (filter === 'all') {
                        row.style.display = '';
                    } else if (filter === 'today') {
                        row.style.display = (type === 'today') ? '' : 'none';
                    } else if (filter === 'upcoming') {
                        row.style.display = (type === 'tomorrow' || type === 'future') ? '' : 'none';
                    } else if (filter === 'past') {
                        row.style.display = (type === 'past') ? '' : 'none';
                    }
                });
            });
        });

        async function pasteTicketCode() {
            try {
                const text = await navigator.clipboard.readText();
                if (text && text.trim()) {
                    document.getElementById('ticketCodeInput').value = text.trim();
                    checkTicket();
                } else {
                    alert('Bộ nhớ tạm đang trống! Vui lòng sao chép mã vé trước.');
                }
            } catch (err) {
                const input = prompt("Dán mã vé vào đây:");
                if (input) {
                    document.getElementById('ticketCodeInput').value = input.trim();
                    checkTicket();
                }
            }
        }

        document.getElementById('ticketCodeInput')?.addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                checkTicket();
            }
        });

        async function checkTicket() {
            const input = document.getElementById('ticketCodeInput');
            const code = input.value.trim();
            if (!code) {
                alert('Vui lòng nhập mã vé cần kiểm tra!');
                input.focus();
                return;
            }

            const tripSelect = document.getElementById('modalTripSelect');
            const tripId = tripSelect ? parseInt(tripSelect.value) : null;

            const btn = document.getElementById('btnVerifyTicket');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang soát vé...';

            try {
                const response = await fetch('/Driver/VerifyTicket', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        ticketCode: code,
                        tripId: tripId 
                    })
                });

                const data = await response.json();
                const resultArea = document.getElementById('verifyResultArea');
                const alertBox = document.getElementById('verifyAlertBox');
                const icon = document.getElementById('verifyIcon');
                const title = document.getElementById('verifyTitle');
                const details = document.getElementById('verifyDetails');

                resultArea.style.display = 'block';

                if (data.success) {
                    alertBox.className = 'alert alert-success p-3 rounded-4 mb-0 shadow-sm border border-success';
                    icon.className = 'bi bi-check-circle-fill text-success fs-3';
                    title.innerText = 'Vé Hợp Lệ - Cho Phép Lên Xe';
                    title.className = 'fw-bold mb-0 text-success fs-6';
                    details.innerHTML = `
                        <div class="row g-2">
                            <div class="col-6"><span class="text-muted">Mã vé:</span> <strong class="font-monospace text-dark">${data.ticketCode || code}</strong></div>
                            <div class="col-6"><span class="text-muted">Số ghế:</span> <span class="badge bg-success fs-6">${data.seatNumber || 'N/A'}</span></div>
                            <div class="col-12"><span class="text-muted">Hành khách:</span> <strong class="text-dark">${data.passengerName || 'N/A'}</strong> ${data.passengerPhone ? `(${data.passengerPhone})` : ''}</div>
                            <div class="col-12"><span class="text-muted">Tuyến đường:</span> <span class="fw-semibold text-dark">${data.routeName || 'N/A'}</span></div>
                        </div>
                        <div class="text-success fw-bold mt-2 pt-2 border-top d-flex align-items-center gap-1">
                            <i class="bi bi-shield-fill-check fs-5"></i> ĐÚNG XE & ĐÚNG CHUYẾN! Đã đánh dấu trạng thái [ĐÃ LÊN XE] thành công.
                        </div>
                    `;
                    input.value = '';

                    // ĐẨY NGAY DỮ LIỆU CỦA HÀNH KHÁCH NÀY LÊN BẢNG DASHBOARD THỜI GIAN THỰC
                    const tbody = document.getElementById('checkedInPassengersBody');
                    const emptyRow = document.getElementById('emptyCheckedInRow');
                    if (emptyRow) emptyRow.style.display = 'none';

                    if (tbody) {
                        const newRow = document.createElement('tr');
                        newRow.style.backgroundColor = '#ecfdf5';
                        newRow.style.transition = 'background-color 2s ease';
                        newRow.innerHTML = `
                            <td class="ps-4 font-monospace fw-bold text-primary">${data.ticketCode || code}</td>
                            <td><div class="fw-semibold text-dark">${data.passengerName || 'N/A'}</div></td>
                            <td class="text-muted small">${data.passengerPhone || 'N/A'}</td>
                            <td><span class="badge bg-success fs-6">${data.seatNumber || 'N/A'}</span></td>
                            <td><span class="small fw-semibold text-dark">${data.routeName || 'N/A'}</span></td>
                            <td><span class="badge bg-light text-dark border">${data.licensePlate || '20B-188.68'}</span></td>
                            <td class="text-muted small">${data.checkInTime || 'Vừa xong'}</td>
                            <td class="text-end pe-4">
                                <span class="badge bg-success-subtle text-success px-2 py-1 border border-success-subtle">
                                    <i class="bi bi-check-circle-fill me-1"></i> ĐÃ LÊN XE
                                </span>
                            </td>
                        `;
                        tbody.insertBefore(newRow, tbody.firstChild);

                        setTimeout(() => {
                            newRow.style.backgroundColor = '';
                        }, 2500);

                        // Cập nhật số đếm thống kê trên dashboard
                        const countEl = document.getElementById('dashCheckedInCount');
                        if (countEl) {
                            const cur = parseInt(countEl.innerText) || 0;
                            countEl.innerText = cur + 1;
                        }
                    }
                } else {
                    const isMismatch = data.code === "TRIP_MISMATCH" || (data.message && data.message.includes("MÃ VÉ KHÔNG HỢP LỆ CHO CHUYẾN"));
                    const isAlreadyUsed = data.code === "ALREADY_USED" || (data.message && data.message.includes("trước đó"));

                    if (isMismatch) {
                        // CẢNH BÁO MÃ VÉ KHÔNG HỢP LỆ CHO CHUYẾN XE NÀY
                        alertBox.className = 'alert alert-danger p-3 rounded-4 mb-0 shadow border border-danger';
                        icon.className = 'bi bi-x-octagon-fill text-danger fs-2';
                        title.innerText = 'MÃ VÉ KHÔNG HỢP LỆ CHO CHUYẾN XE NÀY!';
                        title.className = 'fw-bold mb-0 text-danger fs-6';
                    } else if (isAlreadyUsed) {
                        alertBox.className = 'alert alert-warning p-3 rounded-4 mb-0 shadow-sm border border-warning';
                        icon.className = 'bi bi-exclamation-triangle-fill text-warning fs-3';
                        title.innerText = 'Cảnh Báo: Vé Đã Được Soát Trước Đó!';
                        title.className = 'fw-bold mb-0 text-warning-emphasis fs-6';
                    } else {
                        alertBox.className = 'alert alert-danger p-3 rounded-4 mb-0 shadow-sm border border-danger';
                        icon.className = 'bi bi-x-circle-fill text-danger fs-3';
                        title.innerText = 'Mã Vé Không Hợp Lệ';
                        title.className = 'fw-bold mb-0 text-danger fs-6';
                    }

                    const formattedMsg = (data.message || '').replace(/\n/g, '<br/>');
                    details.innerHTML = `
                        <div class="text-dark fw-semibold mb-2" style="line-height: 1.6;">${formattedMsg}</div>
                        ${data.passengerName ? `
                            <div class="p-2 bg-white rounded-3 border small mt-2">
                                <div><span class="text-muted">Hành khách:</span> <strong>${data.passengerName}</strong> ${data.passengerPhone ? `(${data.passengerPhone})` : ''}</div>
                                <div><span class="text-muted">Số ghế trên vé:</span> <span class="badge bg-secondary">${data.seatNumber || 'N/A'}</span></div>
                                ${data.routeName ? `<div><span class="text-muted">Tuyến đã mua:</span> <strong class="text-primary">${data.routeName}</strong></div>` : ''}
                            </div>
                        ` : ''}
                    `;
                }
            } catch (err) {
                alert('Lỗi kết nối tới máy chủ khi soát vé: ' + err);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i> Kiểm tra';
            }
        }
    </script>
}
