@{
    ViewData["Title"] = "Bảng điều khiển Bác tài";
}

<div class="container mt-4">
    <div class="card rounded-4 border-0 shadow-sm p-4 text-center">
        <i class="bi bi-truck-front-fill text-success" style="font-size: 3rem;"></i>
        <h3 class="fw-bold mt-2">Khu Vực Bác Tài Đã Sẵn Sàng!</h3>
        <p class="text-muted">Đăng nhập tài xế thành công. Từ đây bạn có thể mở máy quét mã QR để kiểm tra vé hành khách lên xe.</p>
        <div class="mt-3">
            <a asp-controller="Ticket" asp-action="Detail" class="btn sbg-btn-primary">
                <i class="bi bi-qr-code-scan me-1"></i> Xem giao diện vé của hành khách
            </a>
        </div>
    </div>
</div>
