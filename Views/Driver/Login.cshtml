@model WebApplication1.Models.ViewModels.DriverLoginViewModel
@{ ViewData["Title"] = "Đăng nhập bác tài"; }
<div class="sc-login-stage">
    <div class="sc-login-intro"><span class="sc-eyebrow">SMARTBUS GO / DRIVER</span><h1>Chuyến đi tốt đẹp<br />bắt đầu từ bác tài.</h1><p>Không gian làm việc dành riêng cho đội ngũ bác tài SmartBus Go.</p><div class="sc-login-perks"><span><i class="bi bi-qr-code-scan" aria-hidden="true"></i>Soát vé thuận tiện</span><span><i class="bi bi-person-vcard" aria-hidden="true"></i>Thông tin luôn rõ ràng</span></div></div>
    <article class="sc-card sc-login-card"><div class="sc-eyebrow">CHÀO MỪNG BÁC TÀI</div><h2>Đăng nhập tài khoản</h2><p>Tài khoản demo: TX-001 · Mật khẩu: Demo123!</p>
        <form asp-controller="Driver" asp-action="Login" method="post" id="driverLoginForm">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="All" class="sc-validation" role="alert"></div>
            <label class="sc-label" asp-for="DriverIdentifier">Mã tài xế / Số điện thoại</label><input asp-for="DriverIdentifier" autocomplete="username" placeholder="Nhập mã tài xế hoặc số điện thoại" />
            <label class="sc-label" asp-for="Password">Mật khẩu</label><div class="sc-password-wrap"><input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" id="driverPassword" /><button type="button" class="sc-eye" id="toggleDriverPassword" aria-label="Hiện mật khẩu" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
            <button type="submit" class="sc-button sc-primary">Đăng nhập<i class="bi bi-arrow-right" aria-hidden="true"></i></button>
        </form>
        <div class="sc-login-help">Cần hỗ trợ tài khoản? <a href="tel:19006868">Liên hệ điều hành</a></div>
        <div class="sc-login-help"><a asp-controller="Account" asp-action="Login">Đăng nhập hành khách</a></div>
    </article>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }


