@{
    Layout = null;
    var ticketCode = (string)(ViewBag.TicketCode ?? "SBG-TN-CB-001");
    var bookingCode = (string)(ViewBag.BookingCode ?? "BK-TNCB-001");
    var amount = (decimal)(ViewBag.Amount ?? 180000m);
    var from = (string)(ViewBag.From ?? "Thái Nguyên");
    var to = (string)(ViewBag.To ?? "Cao Bằng");
    var seats = (string)(ViewBag.Seats ?? "A01");
    var depTime = (string)(ViewBag.DepTime ?? "08:00");
    var busType = (string)(ViewBag.BusType ?? "Xe Limousine VIP");
    var passenger = (string)(ViewBag.Passenger ?? "Lê Văn Cường");
    var orderCode = (long)(ViewBag.OrderCode ?? 84920188L);

    // Đảm bảo định dạng số Invariant chuẩn, không bị dấu phẩy vi-VN làm hỏng cú pháp JavaScript trên điện thoại
    var amountSafe = Math.Round(amount, 0).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    var orderCodeSafe = orderCode.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Cổng Thanh Toán payOS Sandbox - SmartBus Go</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
        @@keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(0, 82, 204, 0.45); }
            50% { box-shadow: 0 0 0 14px rgba(0, 82, 204, 0); }
        }
        .pulse-payos { animation: pulseGlow 2s infinite; }
        .touch-manipulation { touch-action: manipulation; }
    </style>
</head>
<body class="bg-[#f0f4f9] min-h-screen flex flex-col justify-between text-gray-800 antialiased selection:bg-[#0052cc] selection:text-white pb-6">

    <!-- TOP PAYOS SANDBOX HEADER -->
    <header class="bg-white border-b border-gray-200 px-4 py-3 sticky top-0 z-30 shadow-xs">
        <div class="max-w-md mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#0052cc] to-[#2684ff] flex items-center justify-center text-white shadow-sm font-bold text-base">
                    P
                </div>
                <div class="flex flex-col">
                    <div class="flex items-center gap-1.5">
                        <span class="font-extrabold text-base tracking-tight text-gray-900">pay<span class="text-[#0052cc]">OS</span></span>
                        <span class="text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded border border-amber-300">Sandbox</span>
                    </div>
                    <span class="text-[10px] text-gray-500">Môi trường thử nghiệm không mất tiền</span>
                </div>
            </div>
            <div class="flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-1 rounded-full border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>An toàn</span>
            </div>
        </div>
    </header>

    <!-- MAIN PAYMENT CONTENT -->
    <main class="max-w-md mx-auto w-full px-4 pt-4 flex-1">
        
        <!-- Order Total Banner -->
        <div class="bg-gradient-to-br from-[#0052cc] to-[#0747a6] text-white p-5 rounded-2xl shadow-md text-center relative overflow-hidden mb-4">
            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/10 rounded-full pointer-events-none"></div>
            <span class="text-xs uppercase tracking-wider text-blue-100 block mb-1">Số tiền thanh toán vé</span>
            <div class="text-3xl font-black font-mono tracking-tight">@amount.ToString("N0") <span class="text-lg font-bold">đ</span></div>
            <div class="mt-2 text-xs text-blue-100/90 flex items-center justify-center gap-1">
                <span>Mã đơn: <strong>#@orderCode</strong></span>
                <span>•</span>
                <span>SmartBus Go</span>
            </div>
        </div>

        <!-- Trip Details Card -->
        <div class="bg-white rounded-2xl border border-gray-200/80 p-4 shadow-xs mb-4 space-y-3">
            <div class="flex items-center justify-between pb-2.5 border-b border-gray-100 text-xs">
                <span class="text-gray-500">Chuyến xe:</span>
                <span class="font-bold text-gray-900">@from ➔ @to</span>
            </div>
            <div class="flex items-center justify-between text-xs">
                <span class="text-gray-500">Giờ khởi hành:</span>
                <span class="font-semibold text-gray-800">@depTime (Hôm nay)</span>
            </div>
            <div class="flex items-center justify-between text-xs">
                <span class="text-gray-500">Số ghế đặt:</span>
                <span class="font-bold text-[#0052cc] bg-blue-50 px-2 py-0.5 rounded">Ghế: @seats</span>
            </div>
            <div class="flex items-center justify-between text-xs">
                <span class="text-gray-500">Hành khách:</span>
                <span class="font-medium text-gray-800">@passenger</span>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-gray-100 text-xs">
                <span class="text-gray-500">Mã vé hệ thống:</span>
                <span class="font-mono font-bold text-gray-900">@ticketCode</span>
            </div>
        </div>

        <!-- Bank Simulator Selection -->
        <div class="bg-white rounded-2xl border border-gray-200/80 p-4 shadow-xs mb-4">
            <span class="text-xs font-bold text-gray-700 block mb-2.5 uppercase tracking-wide">
                Ngân hàng thanh toán (Mô phỏng Sandbox)
            </span>
            <div class="grid grid-cols-3 gap-2">
                <label class="cursor-pointer border-2 border-[#0052cc] bg-blue-50/50 rounded-xl p-2.5 text-center flex flex-col items-center justify-center transition-all touch-manipulation">
                    <input type="radio" name="bankSelect" value="VCB" checked class="hidden" />
                    <span class="font-bold text-xs text-emerald-800">Vietcombank</span>
                    <span class="text-[9px] text-gray-500 mt-0.5">Khuyên dùng</span>
                </label>
                <label class="cursor-pointer border border-gray-200 hover:border-[#0052cc] bg-white rounded-xl p-2.5 text-center flex flex-col items-center justify-center transition-all touch-manipulation">
                    <input type="radio" name="bankSelect" value="MB" class="hidden" />
                    <span class="font-bold text-xs text-blue-900">MB Bank</span>
                    <span class="text-[9px] text-gray-500 mt-0.5">Quân Đội</span>
                </label>
                <label class="cursor-pointer border border-gray-200 hover:border-[#0052cc] bg-white rounded-xl p-2.5 text-center flex flex-col items-center justify-center transition-all touch-manipulation">
                    <input type="radio" name="bankSelect" value="TCB" class="hidden" />
                    <span class="font-bold text-xs text-red-700">Techcombank</span>
                    <span class="text-[9px] text-gray-500 mt-0.5">Napas247</span>
                </label>
            </div>
            <div class="mt-3 p-2.5 bg-amber-50 rounded-xl border border-amber-200 flex items-start gap-2 text-[11px] text-amber-900">
                <span class="material-symbols-outlined text-[16px] text-amber-700 shrink-0 mt-0.5">verified_user</span>
                <span><strong>Chế độ Test an toàn:</strong> Bạn đang thanh toán trong môi trường thử nghiệm payOS Sandbox. Số tiền <strong>@amount.ToString("N0")đ</strong> sẽ KHÔNG bị trừ khỏi tài khoản thật của bạn.</span>
            </div>
        </div>

        <!-- Big Action Confirmation Button -->
        <div class="space-y-3">
            <button id="btnPay" onclick="executeSimulatedPayment()" type="button" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 active:scale-[0.98] text-white font-extrabold text-base shadow-lg shadow-emerald-900/20 transition-all flex items-center justify-center gap-2 cursor-pointer select-none touch-manipulation">
                <span class="material-symbols-outlined text-[24px]">verified</span>
                <span id="btnPayText">XÁC NHẬN THANH TOÁN (DEMO)</span>
            </button>
            <p class="text-center text-[11px] text-gray-500">
                Màn hình máy tính & điện thoại sẽ tự động chuyển sang trang hoàn tất ngay sau khi xác nhận
            </p>
        </div>

        <!-- Result Success State Modal / Overlay -->
        <div id="modalSuccess" class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-4 hidden">
            <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl border border-emerald-100 transform transition-all scale-95 duration-200" id="modalBox">
                <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-3 shadow-inner">
                    <span class="material-symbols-outlined text-[36px]">check_circle</span>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-1">Thanh toán thành công!</h3>
                <p class="text-xs text-gray-600 mb-4">Giao dịch Demo đã hoàn tất. Đang chuyển đến vé điện tử...</p>
                <div class="bg-gray-50 rounded-xl p-3 text-left text-xs space-y-1.5 mb-5 border border-gray-200">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Mã vé:</span>
                        <span class="font-mono font-bold text-gray-900">@ticketCode</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Số tiền:</span>
                        <span class="font-bold text-emerald-700">@amount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Trạng thái:</span>
                        <span class="font-bold text-emerald-600">ĐÃ XÁC NHẬN (CONFIRMED)</span>
                    </div>
                </div>
                <a id="btnGoResult" href="/payment-result?ticketCode=@Uri.EscapeDataString(ticketCode)&bookingCode=@Uri.EscapeDataString(bookingCode)&amount=@amountSafe&status=success" class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md block transition-colors touch-manipulation">
                    Xem kết quả vé điện tử ngay
                </a>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="text-center text-[11px] text-gray-400 mt-6 px-4">
        Cổng thanh toán Demo &copy; 2026 SmartBus Go Vietnam
    </footer>

    <script>
        let isProcessing = false;

        async function executeSimulatedPayment() {
            if (isProcessing) return;
            isProcessing = true;

            const btn = document.getElementById("btnPay");
            const btnText = document.getElementById("btnPayText");
            if (btn) btn.disabled = true;
            if (btnText) btnText.innerHTML = '<span class="inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span> <span>Đang xử lý giao dịch...</span></span>';

            const payload = {
                ticketCode: "@Html.Raw(ticketCode)",
                bookingCode: "@Html.Raw(bookingCode)",
                amount: Number("@amountSafe"),
                bankCode: document.querySelector('input[name="bankSelect"]:checked')?.value || "VCB",
                orderCode: Number("@orderCodeSafe")
            };

            try {
                const response = await fetch('/api/payos/simulate-payment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                if (data.success) {
                    const modal = document.getElementById("modalSuccess");
                    modal.classList.remove("hidden");
                    setTimeout(() => {
                        const box = document.getElementById("modalBox");
                        if (box) {
                            box.classList.remove("scale-95");
                            box.classList.add("scale-100");
                        }
                    }, 50);

                    // Tự động chuyển hướng sang trang kết quả vé thành công sau 1.2s
                    setTimeout(() => {
                        const effectiveTicket = data.ticketCode || "@Html.Raw(ticketCode)";
                        const effectiveBooking = data.bookingCode || "@Html.Raw(bookingCode)";
                        window.location.href = `/payment-result?ticketCode=${encodeURIComponent(effectiveTicket)}&bookingCode=${encodeURIComponent(effectiveBooking)}&amount=@amountSafe&status=success`;
                    }, 1200);
                } else {
                    alert(data.message || "Có lỗi xảy ra khi xác nhận thanh toán.");
                    isProcessing = false;
                    if (btn) btn.disabled = false;
                    if (btnText) btnText.textContent = "XÁC NHẬN THANH TOÁN (DEMO)";
                }
            } catch (err) {
                console.error("Lỗi gửi thanh toán demo:", err);
                alert("Lỗi kết nối máy chủ hoặc mạng nội bộ.");
                isProcessing = false;
                if (btn) btn.disabled = false;
                if (btnText) btnText.textContent = "XÁC NHẬN THANH TOÁN (DEMO)";
            }
        }

        // Đảm bảo sự kiện chạm (touch) và click phản hồi lập tức trên điện thoại di động
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("btnPay");
            if (btn) {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    executeSimulatedPayment();
                });
            }
        });
    </script>
</body>
</html>
