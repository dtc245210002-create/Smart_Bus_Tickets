@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var signedIn = action != "Login";
    var name = "Trần Đình Trọng";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(part => part[0]));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SmartBus Go</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/driver-portal.css" asp-append-version="true" />
</head>
<body>
<div class="driver-portal @(!signedIn ? "sc-signed-out" : "")">
    <header class="sc-header">
        <a class="sc-brand" asp-controller="Home" asp-action="Index"><span class="sc-brand-icon"><i class="bi bi-bus-front" aria-hidden="true"></i></span><span>SmartBus<span class="sc-mint">Go</span><small>CỔNG BÁC TÀI</small></span></a>
        <div class="sc-header-right"><a class="sc-home-link" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            @if (signedIn) { <a class="sc-user" asp-controller="Driver" asp-action="Profile"><span class="sc-avatar sc-avatar-small">@initials</span><span>@name</span></a> }
        </div>
    </header>
    <div class="sc-shell">
        @if (signedIn)
        {
            <aside class="sc-sidebar">
                <div class="sc-nav-caption">KHÔNG GIAN BÁC TÀI</div>
                <nav aria-label="Điều hướng bác tài">
                    <a class="sc-nav" asp-controller="Driver" asp-action="Dashboard" aria-current="@(action == "Dashboard" ? "page" : null)"><i class="bi bi-grid" aria-hidden="true"></i><span>Tổng quan chuyến</span></a>
                    <a class="sc-nav" asp-controller="Driver" asp-action="Scan" aria-current="@(action == "Scan" ? "page" : null)"><i class="bi bi-qr-code-scan" aria-hidden="true"></i><span>Soát vé QR</span></a>
                    <a class="sc-nav" asp-controller="Driver" asp-action="Incident" aria-current="@(action == "Incident" ? "page" : null)"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>Báo cáo sự cố</span></a>
                    <a class="sc-nav" asp-controller="Driver" asp-action="Profile" aria-current="@(action == "Profile" ? "page" : null)"><i class="bi bi-person-vcard" aria-hidden="true"></i><span>Hồ sơ của tôi</span></a>
                </nav>
                <div class="sc-duty">SmartBus Go<small>Đồng hành cùng bác tài</small></div>
                <form asp-controller="Driver" asp-action="Logout" method="post" class="sc-logout"><button class="sc-nav" type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Đăng xuất</span></button></form>
            </aside>
        }
        <main class="sc-main">
            @if (TempData["SuccessMessage"] != null) { <div class="sc-flash" role="status">@TempData["SuccessMessage"]</div> }
            @if (TempData["ErrorMessage"] != null) { <div class="sc-form-error" role="alert">@TempData["ErrorMessage"]</div> }
            <div class="sc-note">Demo giao diện · Dữ liệu mẫu · Xác minh tài khoản sẽ do backend tích hợp.</div>@RenderBody()
        </main>
    </div>
    <footer class="sc-footer">SmartBus Go · Đồng hành cùng bác tài<span>Hỗ trợ: <a href="tel:19006868">1900 6868</a></span></footer>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/driver-portal.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

