@model WebApplication1.Models.ViewModels.CustomerProfileViewModel
@{ViewData["Title"]="Hồ sơ khách hàng";}
<div class="container py-4"><p class="text-muted small">Trang chủ / Vé của tôi / Hồ sơ khách hàng</p><h2 class="fw-bold text-primary-teal mb-4">Hồ sơ khách hàng</h2><div class="row g-4"><div class="col-lg-3"><div class="card sbg-booking-card text-center"><div class="sbg-profile-avatar mx-auto"><i class="bi bi-person-fill"></i></div><h5 class="fw-bold my-3">@Model.FullName</h5><nav class="nav flex-column text-start gap-2"><a class="nav-link active sbg-profile-active" asp-action="Profile">Thông tin cá nhân</a><a class="nav-link text-success" asp-controller="Ticket" asp-action="MyTickets">Vé của tôi</a><a class="nav-link text-success" asp-controller="Ticket" asp-action="Manage" asp-route-mode="change">Đổi vé</a><a class="nav-link text-success" asp-controller="Ticket" asp-action="Manage" asp-route-mode="cancel">Hủy vé / hoàn tiền</a><a class="nav-link text-success" href="#discountProfile">Hồ sơ ưu đãi</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link text-danger border-0 bg-transparent">Đăng xuất</button></form></nav></div></div><div class="col-lg-9"><div class="card sbg-booking-card"><h4 class="fw-bold text-primary-teal">Thông tin cá nhân</h4><p class="text-muted">Cập nhật thông tin liên hệ để nhận vé và thông báo chuyến đi.</p><form asp-action="Profile" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
    <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="BirthDate" class="form-label">Ngày sinh</label><input asp-for="BirthDate" class="form-control" max="@WebApplication1.Services.DemoStore.Today.ToString("yyyy-MM-dd")"/><span asp-validation-for="BirthDate" class="text-danger small"></span></div>
    <div class="col-12"><label asp-for="Address" class="form-label">Địa chỉ</label><input asp-for="Address" class="form-control"/></div>
    <input type="hidden" asp-for="DiscountGroup"/>
    </div><button class="btn sbg-btn-primary mt-4"><i class="bi bi-check-circle me-2"></i>Lưu thay đổi</button></form></div>
    <div id="discountProfile" class="card sbg-booking-card mt-4"><h5 class="fw-bold">Hồ sơ ưu đãi</h5><p class="text-muted">Trạng thái: <strong>@Model.VerificationStatus</strong> • Đối tượng: @Model.DiscountGroup</p><form asp-action="RequestDiscount" method="post" class="d-flex flex-wrap gap-3"><select name="group" class="form-select sbg-discount-select" aria-label="Đối tượng ưu đãi"><option>Sinh viên</option><option>Học sinh</option><option>Người cao tuổi</option></select><button class="btn btn-outline-success">Gửi yêu cầu xét duyệt demo</button></form></div>
</div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
